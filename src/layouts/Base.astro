---
import '../styles/global.css';
import '../styles/cinema.css';

import Cabecalho from '../components/Cabecalho.astro';
import AccoesRapidas from '../components/AccoesRapidas.astro';
import Rodape from '../components/Rodape.astro';
import { lodge } from '../config/lodge';
import { politicaSeguranca } from '../lib/site';

interface Props {
  /** Título da página (sem o nome do lodge, que é acrescentado). Na página inicial, o título completo. */
  titulo: string;
  descricao: string;
  inicio?: boolean;
  /** Dados estruturados (só com informação confirmada). */
  dadosEstruturados?: Record<string, unknown>;
  /**
   * Intensidade do movimento (src/styles/cinema.css): "completo" nas páginas de apresentação, "moderado"
   * na galeria e nas páginas de apoio, "minimo" nas páginas que têm de ser rápidas (contactos, privacidade).
   */
  movimento?: 'completo' | 'moderado' | 'minimo';
}

const { titulo, descricao, inicio = false, dadosEstruturados, movimento = 'completo' } = Astro.props;
const tituloCompleto = inicio ? titulo : `${titulo} | ${lodge.nome}`;
const indexavel = !lodge.demonstracao.activa;
// Canonical: o domínio definitivo, quando existir; até lá, o endereço publicado (sem índice, ver `indexavel`).
const canonical = new URL(Astro.url.pathname, lodge.site.dominioFinal || Astro.site).href;
const urlPagina = new URL(Astro.url.pathname, Astro.site).href;
const imagemPartilha = new URL('/og/mulotana-lodge.jpg', Astro.site).href;
---

<!doctype html>
<html lang="pt-MZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="Content-Security-Policy" content={politicaSeguranca()} />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    {!indexavel && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#faf8f3" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={lodge.nome} />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:image" content={imagemPartilha} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Piscina do Mulotana Lodge, com palmeiras e um edifício de telhado de colmo, em Boane."
    />
    <meta name="twitter:card" content="summary_large_image" />

    {dadosEstruturados && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(dadosEstruturados)} />
    )}
  </head>
  <body data-movimento={movimento}>
    {movimento !== 'minimo' && <div class="c-progresso" aria-hidden="true" />}
    <a class="saltar" href="#conteudo">
      Saltar para o conteúdo
    </a>
    <Cabecalho />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Rodape />
    <AccoesRapidas />
  </body>
</html>
