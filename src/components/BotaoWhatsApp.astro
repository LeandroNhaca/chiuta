---
/**
 * Botão de WhatsApp honesto: só existe quando o número oficial está configurado em src/config/lodge.ts.
 * Sem número não aparece; a página de contactos assinala o WhatsApp como pendente.
 */
import { lodge } from '../config/lodge';
import { linkWhatsApp } from '../lib/whatsapp';

import Icone from './Icone.astro';

interface Props {
  texto?: string;
  mensagem?: string;
  variante?: 'principal' | 'contorno' | 'contorno-claro';
}

const {
  texto = 'Falar pelo WhatsApp',
  mensagem = `Olá, ${lodge.nome}! Gostaria de obter mais informações.`,
  variante = 'contorno',
} = Astro.props;
const href = linkWhatsApp(lodge.contactos.whatsapp, mensagem);
---

{href && (
  <a class={`botao botao--${variante}`} href={href} target="_blank" rel="noopener">
    <Icone nome="whatsapp" tamanho={18} />
    {texto}
  </a>
)}
