---
import { lodge } from '../config/lodge';
import { fotografias } from '../data/fotografias';
import { pais } from '../i18n/lodge';
import { linguaDe, rota, traducoes } from '../i18n/linguas';
import { canaisContactoEm, navegacaoEm } from '../lib/site';

import Assinatura from './Assinatura.astro';
import Icone from './Icone.astro';
import RedesSociais from './RedesSociais.astro';

const ano = new Date().getFullYear();
const comCapturas = fotografias.some((f) => f.origem === 'google-maps');
const l = linguaDe(Astro.url);
const navegacao = navegacaoEm(l);
const canaisContacto = canaisContactoEm(l);
const t = traducoes(
  {
    resumo: 'Alojamento, salas de conferências, restaurante e área de lazer com piscina, em Boane.',
    provincia: `Província de ${lodge.localizacao.provincia}`,
    rodape: 'Rodapé',
    explorar: 'Explorar',
    pedidos: 'Pedidos',
    disponibilidade: 'Consultar disponibilidade',
    evento: 'Pedir orçamento para um evento',
    chegar: 'Como chegar',
    contactos: 'Contactos',
    aConfirmar: 'A confirmar',
    fale: 'Fale connosco',
    direitos: 'Todos os direitos reservados.',
    privacidade: 'Política de privacidade',
    creditos: 'Créditos fotográficos',
    autor: 'Website por',
  },
  {
    resumo: 'Accommodation, conference rooms, a restaurant and a leisure area with pools, in Boane.',
    provincia: `${lodge.localizacao.provincia} Province`,
    rodape: 'Footer',
    explorar: 'Explore',
    pedidos: 'Requests',
    disponibilidade: 'Check availability',
    evento: 'Request a quote for an event',
    chegar: 'Getting here',
    contactos: 'Contact',
    aConfirmar: 'To be confirmed',
    fale: 'Get in touch',
    direitos: 'All rights reserved.',
    privacidade: 'Privacy policy',
    creditos: 'Photo credits',
    autor: 'Website by',
  },
)[l];
---

<footer class="rodape">
  <div class="contentor rodape__grelha">
    <div class="rodape__marca">
      <Assinatura sobreEscuro altura={64} />
      <p>{t.resumo}</p>
      <p class="rodape__local">
        <Icone nome="pino" tamanho={18} />
        <span>
          {lodge.localizacao.morada && (
            <>
              {lodge.localizacao.morada}
              <br />
            </>
          )}
          {lodge.localizacao.localidade} · {t.provincia} · {pais(l)}
        </span>
      </p>
      <RedesSociais claro />
    </div>

    <nav class="rodape__coluna" aria-label={t.rodape}>
      <h2>{t.explorar}</h2>
      <ul>
        {navegacao.map((item) => (
          <li>
            <a href={item.href}>{item.nome}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="rodape__coluna">
      <h2>{t.pedidos}</h2>
      <ul>
        <li>
          <a href={rota(l, '/#disponibilidade')}>{t.disponibilidade}</a>
        </li>
        <li>
          <a href={rota(l, '/eventos/#pedido')}>{t.evento}</a>
        </li>
        <li>
          <a href={rota(l, '/contactos/#como-chegar')}>{t.chegar}</a>
        </li>
      </ul>
    </div>

    <div class="rodape__coluna">
      <h2>{t.contactos}</h2>
      <ul class="rodape__contactos">
        {canaisContacto.map((c) => (
          <li>
            {c.href ? (
              <a
                href={c.href}
                target={c.externo ? '_blank' : undefined}
                rel={c.externo ? 'noopener' : undefined}
              >
                <Icone nome={c.id} tamanho={18} />
                {c.valor}
              </a>
            ) : (
              <span class="rodape__canal">
                <Icone nome={c.id} tamanho={18} />
                {c.rotulo}
                <span class="pendente pendente--claro">{t.aConfirmar}</span>
              </span>
            )}
          </li>
        ))}
      </ul>
      <a class="ligacao-seta" href={rota(l, '/contactos/')}>
        <span>{t.fale}</span>
        <Icone nome="seta" tamanho={18} />
      </a>
    </div>
  </div>

  <div class="contentor rodape__base">
    <p>
      © {ano} {lodge.nome}. {t.direitos}
    </p>
    <ul>
      <li>
        <a href={rota(l, '/privacidade/')}>{t.privacidade}</a>
      </li>
      {comCapturas && (
        <li>
          <a href={rota(l, '/galeria/#creditos-titulo')}>{t.creditos}</a>
        </li>
      )}
      <li>
        {t.autor} {lodge.demonstracao.autor}
      </li>
    </ul>
  </div>
</footer>

<style>
  .rodape {
    --foco: var(--dourado);
    padding-top: clamp(64px, 8vw, 112px);
    background: var(--verde-profundo);
    color: rgb(250 248 243 / 0.78);
    font-size: 0.95rem;
    border-top: 1px solid rgb(199 161 90 / 0.4);
  }
  .rodape a {
    text-decoration: none;
    transition: color var(--transicao);
  }
  .rodape a:hover {
    color: var(--branco);
  }
  .rodape .ligacao-seta {
    color: var(--dourado);
  }
  .rodape__grelha {
    display: grid;
    gap: 48px 32px;
  }
  @media (min-width: 720px) {
    .rodape__grelha {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .rodape__grelha {
      grid-template-columns: 1.6fr 1fr 1.2fr 1.3fr;
    }
  }
  .rodape__marca {
    display: grid;
    gap: 20px;
    align-content: start;
    justify-items: start;
    max-width: 22rem;
    color: var(--branco);
  }
  .rodape__marca p {
    color: rgb(250 248 243 / 0.78);
  }
  .rodape__local {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: var(--t-pequeno);
  }
  .rodape__local :global(svg) {
    flex: none;
    margin-top: 2px;
  }
  .rodape__local :global(svg) {
    color: var(--dourado);
  }
  .rodape__coluna {
    display: grid;
    gap: 16px;
    align-content: start;
    justify-items: start;
  }
  .rodape h2 {
    font-family: var(--sans);
    font-size: var(--t-etiqueta);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dourado);
  }
  .rodape ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rodape__coluna li a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
  }
  .rodape__canal {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    min-height: 40px;
  }
  .rodape__base {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    justify-content: space-between;
    margin-top: clamp(56px, 7vw, 96px);
    padding-block: 28px;
    border-top: 1px solid var(--linha-clara);
    font-size: 0.8125rem;
    color: rgb(250 248 243 / 0.66);
  }
  .rodape__base ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }
  .rodape__base a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgb(250 248 243 / 0.3);
  }
</style>
