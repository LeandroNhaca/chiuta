---
/**
 * Moldura comum dos formulários de pedido: avisos, botão, armadilha anti-spam e painel de resultado.
 * O comportamento (validação, WhatsApp, envio) está em src/scripts/formularios.ts.
 */
import { lodge } from '../config/lodge';
import { linguaDe, traducoes } from '../i18n/linguas';
import { linkEmail, linkWhatsApp, normalizarNumero } from '../lib/whatsapp';

import Icone from './Icone.astro';

interface Props {
  tipo: 'alojamento' | 'evento';
  prefixo: string;
  botao: string;
  titulo: string;
}

const { tipo, prefixo, botao, titulo } = Astro.props;
// Sem endpoint, o pedido segue pelo WhatsApp ou pelo e-mail do visitante, com a mensagem preparada aqui.
// Sem nenhum destino configurado, o formulário só valida: o visitante tem de o saber antes de preencher.
const comWhatsApp = linkWhatsApp(lodge.contactos.whatsapp) !== null;
const comEmail = linkEmail(lodge.contactos.email) !== null;
const porMensagem = !lodge.pedidos.endpoint && (comWhatsApp || comEmail);
const demonstrativo = !lodge.pedidos.endpoint && !porMensagem;
const temAviso = demonstrativo || porMensagem;
const l = linguaDe(Astro.url);
const t = traducoes(
  {
    email: 'e-mail',
    ou: ' ou ',
    demo: 'Formulário de demonstração.',
    demoTexto:
      'Ainda não envia pedidos: pode preencher e validar os dados, mas nada é transmitido nem guardado.',
    porCanais: (c: string) => `Pedido por ${c}.`,
    porCanaisTexto: (c: string) =>
      `No fim, preparamos a mensagem com os seus dados para o ${c} do ${lodge.nome}. Nada é enviado nem guardado por este site: o pedido só chega à equipa quando o enviar na sua aplicação.`,
    obrigatoriosAntes: 'Os campos com',
    obrigatoriosDepois: 'são obrigatórios.',
    armadilha: 'Não preencha este campo',
    preparada: 'Mensagem preparada',
    copiar: 'Copiar mensagem',
    whatsapp: 'Enviar pelo WhatsApp',
    porEmail: 'Enviar por e-mail',
    outro: 'Fazer outro pedido',
    novaJanela: '(abre numa nova janela)',
  },
  {
    email: 'email',
    ou: ' or ',
    demo: 'Demonstration form.',
    demoTexto:
      'It does not send requests yet: you can fill in and validate the details, but nothing is transmitted or stored.',
    porCanais: (c: string) => `Request by ${c}.`,
    porCanaisTexto: (c: string) =>
      `At the end, we prepare the message with your details for the ${lodge.nome} ${c}. Nothing is sent or stored by this website: the request only reaches the team when you send it from your app.`,
    obrigatoriosAntes: 'Fields marked with',
    obrigatoriosDepois: 'are required.',
    armadilha: 'Do not fill in this field',
    preparada: 'Prepared message',
    copiar: 'Copy message',
    whatsapp: 'Send on WhatsApp',
    porEmail: 'Send by email',
    outro: 'Make another request',
    novaJanela: '(opens in a new window)',
  },
)[l];
const canais = [comWhatsApp && 'WhatsApp', comEmail && t.email].filter(Boolean).join(t.ou);
---

<div class="pedido" data-pedido>
  <form
    class="pedido__form"
    novalidate
    data-formulario
    data-tipo={tipo}
    data-endpoint={lodge.pedidos.endpoint}
    data-whatsapp={normalizarNumero(lodge.contactos.whatsapp)}
    data-email={comEmail ? lodge.contactos.email : ''}
    data-lodge={lodge.nome}
    aria-labelledby={`${prefixo}-titulo`}
    aria-describedby={temAviso ? `${prefixo}-demo` : undefined}
  >
    <h3 class="pedido__titulo" id={`${prefixo}-titulo`}>
      {titulo}
    </h3>
    {demonstrativo && (
      <p class="pedido__demo" id={`${prefixo}-demo`}>
        <Icone nome="info" tamanho={18} />
        <span>
          <strong>{t.demo}</strong> {t.demoTexto}
        </span>
      </p>
    )}
    {porMensagem && (
      <p class="pedido__demo pedido__demo--whatsapp" id={`${prefixo}-demo`}>
        <Icone nome={comWhatsApp ? 'whatsapp' : 'email'} tamanho={18} />
        <span>
          <strong>{t.porCanais(canais)}</strong> {t.porCanaisTexto(canais)}
        </span>
      </p>
    )}
    <p class="pedido__obrigatorios">
      {t.obrigatoriosAntes} <span aria-hidden="true">*</span> {t.obrigatoriosDepois}
    </p>
    <p class="pedido__erros" role="alert" data-resumo-erros hidden></p>

    <div class="pedido__campos">
      <slot />
    </div>

    <div class="pedido__armadilha" aria-hidden="true">
      <label for={`${prefixo}-website`}>{t.armadilha}</label>
      <input id={`${prefixo}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p class="pedido__falha" role="alert" data-falha-envio hidden></p>

    <button class="botao botao--principal botao--bloco" type="submit" data-enviar>
      <span data-enviar-rotulo>{botao}</span>
      <Icone nome="seta" tamanho={18} />
    </button>
    <p class="pedido__aviso">
      <Icone nome="info" tamanho={16} />
      <span>
        <slot name="aviso" />
      </span>
    </p>
  </form>

  <div class="pedido__resultado" data-resultado hidden tabindex="-1">
    <span class="pedido__visto">
      <Icone nome="visto" tamanho={26} />
    </span>
    <h3 data-resultado-titulo></h3>
    <p data-resultado-texto></p>
    <dl class="pedido__resumo" data-resultado-resumo></dl>
    <div class="pedido__mensagem" data-resultado-mensagem hidden>
      <p class="pedido__mensagem-titulo">{t.preparada}</p>
      <pre class="pedido__mensagem-texto" data-mensagem-texto></pre>
      <div class="pedido__mensagem-accoes">
        <button class="botao botao--contorno" type="button" data-copiar-mensagem>
          {t.copiar}
        </button>
        <p class="pedido__mensagem-estado" role="status" data-copiar-estado></p>
      </div>
    </div>
    <div class="accoes">
      <a class="botao botao--principal" data-resultado-whatsapp hidden target="_blank" rel="noopener">
        <Icone nome="whatsapp" tamanho={18} />
        {t.whatsapp}
        <span class="visualmente-oculto">{t.novaJanela}</span>
      </a>
      <a class="botao botao--verde" data-resultado-email hidden>
        <Icone nome="email" tamanho={18} />
        {t.porEmail}
      </a>
      <button class="botao botao--contorno" type="button" data-novo-pedido>
        {t.outro}
      </button>
    </div>
  </div>
</div>

<script>
  import '../scripts/formularios';
</script>

<style>
  .pedido {
    --foco: var(--verde);
    padding: clamp(22px, 4vw, 40px);
    border: 1px solid var(--linha);
    border-radius: var(--raio-l);
    background: #fff;
    color: var(--texto);
    box-shadow: var(--sombra);
  }
  .pedido__form,
  .pedido__resultado {
    display: grid;
    gap: 20px;
  }
  .pedido__form[hidden],
  .pedido__resultado[hidden] {
    display: none;
  }
  .pedido__titulo,
  .pedido__resultado h3 {
    font-size: clamp(1.7rem, 1.4rem + 1vw, 2.2rem);
  }
  .pedido__obrigatorios {
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }
  .pedido__demo {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid rgb(122 91 34 / 0.35);
    border-radius: var(--raio);
    background: rgb(199 161 90 / 0.12);
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .pedido__demo :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--dourado-texto);
  }
  .pedido__demo strong {
    color: var(--verde);
  }
  .pedido__demo--whatsapp {
    border-color: rgb(11 48 39 / 0.25);
    background: rgb(11 48 39 / 0.06);
  }
  .pedido__demo--whatsapp :global(svg) {
    color: var(--verde);
  }
  .pedido__campos {
    display: grid;
    gap: 30px;
    margin-top: 4px;
  }
  .pedido__mensagem {
    display: grid;
    gap: 12px;
    padding: 18px;
    border-radius: var(--raio);
    background: var(--cinzento);
  }
  .pedido__mensagem[hidden] {
    display: none;
  }
  .pedido__mensagem-titulo {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: var(--t-etiqueta);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--verde);
  }
  .pedido__mensagem-texto {
    margin: 0;
    padding: 14px 16px;
    border-left: 3px solid var(--dourado);
    border-radius: 4px;
    background: #fff;
    font: 500 0.9rem/1.6 var(--sans);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--texto);
  }
  .pedido__mensagem-accoes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    align-items: center;
  }
  .pedido__mensagem-estado {
    font-size: var(--t-pequeno);
    font-weight: 600;
    color: var(--verde);
  }
  .pedido__erros,
  .pedido__falha {
    padding: 12px 16px;
    border-left: 3px solid var(--erro);
    background: rgb(155 44 31 / 0.08);
    color: var(--erro);
    font-size: var(--t-pequeno);
    font-weight: 600;
  }
  .pedido__armadilha {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .pedido__aviso {
    display: flex;
    gap: 10px;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--texto-suave);
  }
  .pedido__aviso :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--dourado-texto);
  }
  .pedido__visto {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgb(199 161 90 / 0.18);
    color: var(--dourado-texto);
  }
  .pedido__resultado:focus {
    outline: none;
  }
  .pedido__resultado p {
    color: var(--texto-suave);
  }
  .pedido__resumo {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 20px;
    margin: 0;
    padding: 18px 0;
    border-block: 1px solid var(--linha);
    font-size: 0.95rem;
  }
  .pedido__resumo :global(dt) {
    font-weight: 700;
    color: var(--texto);
  }
  .pedido__resumo :global(dd) {
    margin: 0;
    color: var(--texto-suave);
    overflow-wrap: anywhere;
    white-space: pre-line;
  }

  /* Campos (componente Campo.astro, renderizado dentro deste formulário). */
  .pedido :global(.campo) {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  @media (min-width: 560px) {
    .pedido :global(.campo--largo) {
      grid-column: 1 / -1;
    }
  }
  .pedido :global(label) {
    font-size: 0.9rem;
    font-weight: 700;
  }
  .pedido :global(.campo__obrigatorio) {
    margin-left: 4px;
    color: var(--erro);
  }
  .pedido :global(.campo__opcional) {
    margin-left: 6px;
    font-weight: 500;
    color: var(--texto-suave);
  }
  .pedido :global(.campo__ajuda) {
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }
  .pedido :global(input),
  .pedido :global(select),
  .pedido :global(textarea) {
    width: 100%;
    min-height: 50px;
    padding: 12px 14px;
    border: 1px solid rgb(32 41 35 / 0.28);
    border-radius: var(--raio);
    background: #fff;
    color: var(--texto);
    font: 500 1rem/1.4 var(--sans);
    transition:
      border-color var(--transicao),
      box-shadow var(--transicao);
  }
  .pedido :global(textarea) {
    resize: vertical;
    min-height: 116px;
  }
  .pedido :global(input:hover),
  .pedido :global(select:hover),
  .pedido :global(textarea:hover) {
    border-color: rgb(32 41 35 / 0.5);
  }
  .pedido :global(input:focus-visible),
  .pedido :global(select:focus-visible),
  .pedido :global(textarea:focus-visible) {
    outline: none;
    border-color: var(--verde);
    box-shadow: 0 0 0 3px rgb(199 161 90 / 0.45);
  }
  .pedido :global([aria-invalid='true']) {
    border-color: var(--erro);
  }
  .pedido :global(.campo__erro) {
    min-height: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--erro);
  }
  .pedido :global(.campo__erro:empty) {
    display: none;
  }
  /* Escolhas múltiplas (serviços pretendidos) */
  .pedido :global(.campo--escolhas) {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .pedido :global(.campo--escolhas legend) {
    padding: 0;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .pedido :global(.campo__opcoes) {
    display: grid;
    gap: 8px 16px;
    margin-top: 4px;
  }
  @media (min-width: 560px) {
    .pedido :global(.campo__opcoes) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .pedido :global(.campo__opcao) {
    display: flex;
    gap: 10px;
    align-items: center;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid rgb(32 41 35 / 0.18);
    border-radius: var(--raio);
    font-weight: 600;
    cursor: pointer;
  }
  .pedido :global(.campo__opcao:has(input:checked)) {
    border-color: var(--verde);
    background: rgb(11 48 39 / 0.05);
  }
  .pedido :global(.campo__opcao input) {
    flex: none;
    width: 20px;
    height: 20px;
    min-height: 0;
    margin: 0;
    padding: 0;
    accent-color: var(--verde);
    box-shadow: none;
  }
</style>
