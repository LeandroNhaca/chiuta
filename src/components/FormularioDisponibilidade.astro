---
import { LIMITES } from '../lib/validacao';

import Campo from './Campo.astro';
import Pedido from './Pedido.astro';

interface Props {
  prefixo?: string;
}
const { prefixo = 'disp' } = Astro.props;
---

<Pedido
  tipo="alojamento"
  prefixo={prefixo}
  titulo="Pedido de disponibilidade"
  botao="Consultar disponibilidade"
>
  <Campo
    prefixo={prefixo}
    nome="nome"
    rotulo="Nome"
    obrigatorio
    largo
    atributos={{ autocomplete: 'name', maxlength: 80 }}
  />
  <Campo
    prefixo={prefixo}
    nome="telefone"
    rotulo="Telefone ou WhatsApp"
    tipo="tel"
    obrigatorio
    ajuda="Com o indicativo do país, por exemplo +258."
    atributos={{ autocomplete: 'tel', inputmode: 'tel', maxlength: 24 }}
  />
  <Campo
    prefixo={prefixo}
    nome="email"
    rotulo="E-mail"
    tipo="email"
    atributos={{ autocomplete: 'email', maxlength: 160 }}
  />
  <Campo prefixo={prefixo} nome="entrada" rotulo="Data de entrada" tipo="date" obrigatorio />
  <Campo prefixo={prefixo} nome="saida" rotulo="Data de saída" tipo="date" obrigatorio />
  <Campo
    prefixo={prefixo}
    nome="hospedes"
    rotulo="Número de hóspedes"
    tipo="number"
    obrigatorio
    atributos={{ min: LIMITES.hospedes.min, max: LIMITES.hospedes.max, step: 1, inputmode: 'numeric' }}
  />
  <Campo
    prefixo={prefixo}
    nome="mensagem"
    rotulo="Mensagem"
    tipo="textarea"
    largo
    atributos={{ maxlength: LIMITES.mensagem.max }}
  />
  <Fragment slot="aviso">
    Este pedido serve para consultar disponibilidade e não constitui uma reserva. A reserva só fica garantida
    depois de confirmada pelo Mulotane Lodge.
  </Fragment>
</Pedido>
