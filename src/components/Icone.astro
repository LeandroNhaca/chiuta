export type NomeIcone = keyof typeof tracos | 'whatsapp';

interface Props {
  nome: NomeIcone;
  tamanho?: number;
  /** Com rótulo, o ícone é anunciado pelos leitores de ecrã; sem rótulo é decorativo. */
  rotulo?: string;
  class?: string;
}

const { nome, tamanho = 20, rotulo, class: classe } = Astro.props;
const acessibilidade = rotulo
  ? { role: 'img' as const, 'aria-label': rotulo }
  : { 'aria-hidden': 'true' as const };
---

{nome === 'whatsapp' ? (
  <svg
    class={classe}
    width={tamanho}
    height={tamanho}
    viewBox="0 0 24 24"
    fill="currentColor"
    focusable="false"
    {...acessibilidade}
  >
    <path d={whatsapp} />
  </svg>
) : (
  <svg
    class={classe}
    width={tamanho}
    height={tamanho}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    focusable="false"
    {...acessibilidade}
  >
    <path d={tracos[nome]} />
  </svg>
)}
