---
/**
 * Pedidos na página inicial: disponibilidade e orçamento de eventos lado a lado, em separadores.
 * Sem JavaScript os dois formulários aparecem um a seguir ao outro (os separadores ficam escondidos).
 * As âncoras #disponibilidade e #orcamento abrem o separador certo (src/scripts/separadores.ts).
 */
import { linguaDe, traducoes } from '../i18n/linguas';

import Enfase from './Enfase.astro';
import FormularioDisponibilidade from './FormularioDisponibilidade.astro';
import FormularioEvento from './FormularioEvento.astro';
import Icone from './Icone.astro';

const l = linguaDe(Astro.url);
const t = traducoes(
  {
    etiqueta: 'Pedidos',
    titulo: 'Planeie a sua *visita.*',
    textos: [
      'Consulte a disponibilidade para a sua estadia ou peça um orçamento para um evento: reuniões, conferências, celebrações e encontros de grupo.',
      'No fim, a mensagem fica pronta para enviar pelo WhatsApp ou por e-mail. Um pedido não é uma reserva: a estadia ou o evento só ficam garantidos depois de confirmados pela equipa do lodge.',
    ],
    tipo: 'Tipo de pedido',
    estadia: 'Estadia',
    evento: 'Evento',
  },
  {
    etiqueta: 'Requests',
    titulo: 'Plan your *visit.*',
    textos: [
      'Check availability for your stay or request a quote for an event: meetings, conferences, celebrations and group gatherings.',
      'At the end, the message is ready to send on WhatsApp or by email. A request is not a booking: your stay or event is only guaranteed once it has been confirmed by the lodge team.',
    ],
    tipo: 'Type of request',
    estadia: 'Stay',
    evento: 'Event',
  },
)[l];
const separadores = [
  { id: 'disponibilidade', rotulo: t.estadia, icone: 'calendario' as const },
  { id: 'orcamento', rotulo: t.evento, icone: 'pessoas' as const },
];
---

<section id="pedidos" class="secao secao--escura pedidos" aria-labelledby="pedidos-titulo">
  <div class="contentor pedidos__grelha">
    <div class="bloco-titulo pedidos__titulo">
      <p class="etiqueta c-revelar">{t.etiqueta}</p>
      <h2 id="pedidos-titulo" class="c-titulo">
        <Enfase texto={t.titulo} />
      </h2>
      <div class="texto">
        {t.textos.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>

    <div class="pedidos__formularios" data-separadores>
      <div class="pedidos__separadores" role="tablist" aria-label={t.tipo} hidden data-lista-separadores>
        {separadores.map((s, i) => (
          <button
            class="pedidos__separador"
            type="button"
            role="tab"
            id={`separador-${s.id}`}
            aria-controls={s.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <Icone nome={s.icone} tamanho={18} />
            {s.rotulo}
          </button>
        ))}
      </div>
      <div class="pedidos__painel" id="disponibilidade" data-painel>
        <FormularioDisponibilidade prefixo="disp" />
      </div>
      <div class="pedidos__painel" id="orcamento" data-painel>
        <FormularioEvento prefixo="inicio-evento" />
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/separadores';
</script>

<style>
  .pedidos__grelha {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .pedidos__grelha {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(48px, 6vw, 96px);
    }
    .pedidos__titulo {
      position: sticky;
      top: calc(var(--cabecalho) + 40px);
    }
  }
  .pedidos__formularios {
    display: grid;
    gap: 28px;
  }
  /* Os separadores ficam colados ao formulário; a âncora deixa-os à vista. */
  .pedidos__formularios:global(.separadores--activos) {
    gap: 0;
  }
  .pedidos__painel {
    scroll-margin-top: calc(var(--cabecalho) + 76px);
  }
  .pedidos__formularios:global(.separadores--activos) .pedidos__painel :global(.pedido) {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
  .pedidos__separadores {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }
  .pedidos__separadores[hidden] {
    display: none;
  }
  .pedidos__separador {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 58px;
    padding: 0 16px;
    border: 0;
    border-radius: var(--raio-l) var(--raio-l) 0 0;
    background: rgb(250 248 243 / 0.1);
    color: rgb(250 248 243 / 0.86);
    font: 750 1rem/1.2 var(--sans);
    cursor: pointer;
    transition:
      background-color var(--transicao),
      color var(--transicao);
  }
  .pedidos__separador:hover {
    background: rgb(250 248 243 / 0.14);
    color: var(--branco);
  }
  .pedidos__separador[aria-selected='true'] {
    background: #fff;
    color: var(--texto);
  }
  .pedidos__separador[aria-selected='true'] :global(svg) {
    color: var(--dourado-texto);
  }
  .pedidos__separador:focus-visible {
    outline-offset: -4px;
  }
  /* O formulário colado ao separador activo não leva a borda do cartão por cima. */
  .pedidos__formularios:global(.separadores--activos) .pedidos__painel :global(.pedido) {
    border-top: 0;
  }
</style>
