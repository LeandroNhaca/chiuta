---
/**
 * Ficha de um serviço com os dados de src/config/lodge.ts (`detalhes`). O que ainda não foi confirmado
 * aparece como "A confirmar"; o que vem das publicações do lodge e ainda não foi validado diz de onde vem.
 * Nada é inventado.
 */
import { lodge } from '../config/lodge';
import { detalhes as detalhesEm } from '../i18n/lodge';
import { linguaDe, traducoes } from '../i18n/linguas';

interface Props {
  servico: keyof typeof lodge.detalhes;
  titulo: string;
  /** Verde sobre fundos claros; clara sobre fundos verdes. */
  tom?: 'verde' | 'clara';
}

const { servico, titulo, tom = 'verde' } = Astro.props;
const l = linguaDe(Astro.url);
const detalhes = detalhesEm(l)[servico];
const t = traducoes(
  {
    publicado: (origem: string) => `Publicado pelo lodge (${origem})`,
    aConfirmar: 'A confirmar',
    mudaram: 'Os valores publicados pelo lodge nas redes sociais podem ter mudado: confirme-os no pedido. ',
    todos: 'Estes dados são indicados pela equipa do lodge, a pedido.',
    alguns: 'Os dados "a confirmar" são indicados pela equipa do lodge, a pedido.',
  },
  {
    publicado: (origem: string) => `Published by the lodge (${origem})`,
    aConfirmar: 'To be confirmed',
    mudaram:
      'Values published by the lodge on social media may have changed: please confirm them in your request. ',
    todos: 'The lodge team provides these details on request.',
    alguns: 'Details marked "to be confirmed" are provided by the lodge team on request.',
  },
)[l];
const pendentes = detalhes.filter((d) => !d.valor).length;
const publicados = detalhes.some((d) => d.valor && d.aValidar);
---

<div class:list={['ficha', `ficha--${tom}`]}>
  <p class="filete-titulo">{titulo}</p>
  <dl class="ficha__lista">
    {detalhes.map((d) => (
      <div class="ficha__linha">
        <dt>{d.rotulo}</dt>
        <dd>
          {d.valor ? (
            <>
              <span class="ficha__valor">{d.valor}</span>
              {d.aValidar && <span class="ficha__origem">{t.publicado(d.aValidar)}</span>}
            </>
          ) : (
            <span class:list={['pendente', { 'pendente--claro': tom === 'verde' }]}>{t.aConfirmar}</span>
          )}
        </dd>
      </div>
    ))}
  </dl>
  {(pendentes > 0 || publicados) && (
    <p class="ficha__nota">
      {publicados && t.mudaram}
      {pendentes > 0 && (pendentes === detalhes.length ? t.todos : t.alguns)}
    </p>
  )}
</div>

<style>
  .ficha {
    --foco: var(--dourado);
    display: grid;
    gap: 16px;
    align-content: start;
    padding: clamp(24px, 3.6vw, 40px);
    border-radius: var(--raio-l);
  }
  .ficha--verde {
    background: var(--verde);
    color: var(--branco);
  }
  .ficha--clara {
    --foco: var(--verde);
    border: 1px solid var(--linha);
    background: #fff;
    color: var(--texto);
  }
  .ficha--clara .filete-titulo {
    color: var(--dourado-texto);
  }
  /* Uma ficha clara pode estar numa secção verde: os selos ficam no tom legível sobre branco. */
  .ficha--clara .pendente {
    border-color: rgb(122 91 34 / 0.45);
    color: var(--dourado-texto);
  }
  .ficha--verde .filete-titulo {
    color: var(--dourado);
  }
  .ficha__lista {
    display: grid;
    margin: 0;
  }
  .ficha__linha {
    display: grid;
    gap: 4px 20px;
    padding: 13px 0;
    border-bottom: 1px solid var(--linha);
  }
  @media (min-width: 560px) {
    .ficha__linha {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: baseline;
    }
  }
  .ficha--verde .ficha__linha {
    border-color: var(--linha-clara);
  }
  .ficha__linha dt {
    font-weight: 750;
    line-height: 1.35;
  }
  .ficha__linha dd {
    display: grid;
    gap: 2px;
    justify-items: start;
    margin: 0;
    font-size: 0.97rem;
  }
  .ficha__origem {
    font-size: 0.8rem;
    color: var(--texto-suave);
  }
  .ficha--verde .ficha__origem {
    color: rgb(250 248 243 / 0.72);
  }
  .ficha__nota {
    font-size: var(--t-pequeno);
    line-height: 1.55;
    opacity: 0.9;
  }
</style>
