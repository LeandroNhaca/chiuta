---
import { lodge } from '../config/lodge';
import { LIMITES, SERVICOS_EVENTO, TIPOS_EVENTO } from '../lib/validacao';

import Campo from './Campo.astro';
import GrupoCampos from './GrupoCampos.astro';
import Pedido from './Pedido.astro';

interface Props {
  prefixo?: string;
}
const { prefixo = 'evento' } = Astro.props;
---

<Pedido tipo="evento" prefixo={prefixo} titulo="Pedido de orçamento" botao="Pedir orçamento">
  <GrupoCampos numero={1} legenda="O seu evento">
    <Campo
      prefixo={prefixo}
      nome="tipo"
      rotulo="Tipo de evento"
      tipo="select"
      obrigatorio
      largo
      opcoes={TIPOS_EVENTO}
    />
    <Campo prefixo={prefixo} nome="data" rotulo="Data pretendida" tipo="date" obrigatorio />
    <Campo
      prefixo={prefixo}
      nome="participantes"
      rotulo="Número estimado de participantes"
      tipo="number"
      obrigatorio
      atributos={{
        min: LIMITES.participantes.min,
        max: LIMITES.participantes.max,
        step: 1,
        inputmode: 'numeric',
      }}
    />
    <Campo
      prefixo={prefixo}
      nome="servicos"
      rotulo="Serviços pretendidos"
      tipo="escolhas"
      opcoes={SERVICOS_EVENTO}
      ajuda="Marque o que gostaria de ter. A equipa confirma o que está disponível para a data."
    />
    <Campo
      prefixo={prefixo}
      nome="mensagem"
      rotulo="Observações"
      tipo="textarea"
      largo
      ajuda="Horário, formato da sala, refeições ou outras necessidades."
      atributos={{ maxlength: LIMITES.mensagem.max }}
    />
  </GrupoCampos>
  <GrupoCampos numero={2} legenda="Os seus contactos">
    <Campo
      prefixo={prefixo}
      nome="nome"
      rotulo="Nome"
      obrigatorio
      atributos={{ autocomplete: 'name', maxlength: 80 }}
    />
    <Campo
      prefixo={prefixo}
      nome="empresa"
      rotulo="Empresa ou instituição"
      atributos={{ autocomplete: 'organization', maxlength: LIMITES.empresa.max }}
    />
    <Campo
      prefixo={prefixo}
      nome="telefone"
      rotulo="Telefone ou WhatsApp"
      tipo="tel"
      obrigatorio
      ajuda="Com o indicativo do país, por exemplo +258."
      atributos={{ autocomplete: 'tel', inputmode: 'tel', maxlength: 24 }}
    />
    <Campo
      prefixo={prefixo}
      nome="email"
      rotulo="E-mail"
      tipo="email"
      atributos={{ autocomplete: 'email', maxlength: 160 }}
    />
  </GrupoCampos>
  <Fragment slot="aviso">
    Não há orçamentos automáticos: a equipa do {lodge.nome} prepara-o de acordo com a disponibilidade do
    espaço na data pretendida. Um pedido de orçamento não é uma reserva.
  </Fragment>
</Pedido>
