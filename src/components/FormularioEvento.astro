---
import { lodge } from '../config/lodge';
import { linguaDe, traducoes } from '../i18n/linguas';
import { LIMITES, LISTAS_EVENTO } from '../lib/validacao';

import Campo from './Campo.astro';
import GrupoCampos from './GrupoCampos.astro';
import Pedido from './Pedido.astro';

interface Props {
  prefixo?: string;
}
const { prefixo = 'evento' } = Astro.props;
const l = linguaDe(Astro.url);
const { tipos, servicos } = LISTAS_EVENTO[l];
const t = traducoes(
  {
    titulo: 'Pedido de orçamento',
    botao: 'Pedir orçamento',
    evento: 'O seu evento',
    tipo: 'Tipo de evento',
    data: 'Data pretendida',
    participantes: 'Número estimado de participantes',
    servicos: 'Serviços pretendidos',
    servicosAjuda: 'Marque o que gostaria de ter. A equipa confirma o que está disponível para a data.',
    observacoes: 'Observações',
    observacoesAjuda: 'Horário, formato da sala, refeições ou outras necessidades.',
    contactos: 'Os seus contactos',
    nome: 'Nome',
    empresa: 'Empresa ou instituição',
    telefone: 'Telefone ou WhatsApp',
    email: 'E-mail',
    aviso: `Não há orçamentos automáticos: a equipa do ${lodge.nome} prepara-o de acordo com a disponibilidade do espaço na data pretendida. Um pedido de orçamento não é uma reserva.`,
  },
  {
    titulo: 'Quote request',
    botao: 'Request a quote',
    evento: 'Your event',
    tipo: 'Type of event',
    data: 'Preferred date',
    participantes: 'Estimated number of participants',
    servicos: 'Services requested',
    servicosAjuda: 'Tick what you would like to have. The team confirms what is available on the date.',
    observacoes: 'Notes',
    observacoesAjuda: 'Times, room layout, meals or other requirements.',
    contactos: 'Your contact details',
    nome: 'Name',
    empresa: 'Company or organisation',
    telefone: 'Phone or WhatsApp',
    email: 'Email',
    aviso: `There are no automatic quotes: the ${lodge.nome} team prepares yours according to the availability of the space on the date requested. A quote request is not a booking.`,
  },
)[l];
---

<Pedido tipo="evento" prefixo={prefixo} titulo={t.titulo} botao={t.botao}>
  <GrupoCampos numero={1} legenda={t.evento}>
    <Campo prefixo={prefixo} nome="tipo" rotulo={t.tipo} tipo="select" obrigatorio largo opcoes={tipos} />
    <Campo prefixo={prefixo} nome="data" rotulo={t.data} tipo="date" obrigatorio />
    <Campo
      prefixo={prefixo}
      nome="participantes"
      rotulo={t.participantes}
      tipo="number"
      obrigatorio
      atributos={{
        min: LIMITES.participantes.min,
        max: LIMITES.participantes.max,
        step: 1,
        inputmode: 'numeric',
      }}
    />
    <Campo
      prefixo={prefixo}
      nome="servicos"
      rotulo={t.servicos}
      tipo="escolhas"
      opcoes={servicos}
      ajuda={t.servicosAjuda}
    />
    <Campo
      prefixo={prefixo}
      nome="mensagem"
      rotulo={t.observacoes}
      tipo="textarea"
      largo
      ajuda={t.observacoesAjuda}
      atributos={{ maxlength: LIMITES.mensagem.max }}
    />
  </GrupoCampos>
  <GrupoCampos numero={2} legenda={t.contactos}>
    <Campo
      prefixo={prefixo}
      nome="nome"
      rotulo={t.nome}
      obrigatorio
      atributos={{ autocomplete: 'name', maxlength: 80 }}
    />
    <Campo
      prefixo={prefixo}
      nome="empresa"
      rotulo={t.empresa}
      atributos={{ autocomplete: 'organization', maxlength: LIMITES.empresa.max }}
    />
    <Campo
      prefixo={prefixo}
      nome="telefone"
      rotulo={t.telefone}
      tipo="tel"
      obrigatorio
      atributos={{ autocomplete: 'tel', inputmode: 'tel', maxlength: 24 }}
    />
    <Campo
      prefixo={prefixo}
      nome="email"
      rotulo={t.email}
      tipo="email"
      atributos={{ autocomplete: 'email', maxlength: 160 }}
    />
  </GrupoCampos>
  <Fragment slot="aviso">{t.aviso}</Fragment>
</Pedido>
