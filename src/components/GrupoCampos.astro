---
/** Grupo de campos de um pedido (fieldset com legenda numerada), em duas colunas a partir de 560 px. */
interface Props {
  numero: number;
  legenda: string;
}
const { numero, legenda } = Astro.props;
---

<fieldset class="grupo">
  <legend class="grupo__legenda">
    <span class="grupo__numero" aria-hidden="true">
      {String(numero).padStart(2, '0')}
    </span>
    {legenda}
  </legend>
  <div class="grupo__campos">
    <slot />
  </div>
</fieldset>

<style>
  .grupo {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .grupo__legenda {
    display: flex;
    align-items: baseline;
    gap: 12px;
    width: 100%;
    margin-bottom: 16px;
    padding: 0 0 10px;
    border-bottom: 1px solid var(--linha);
    font-size: var(--t-etiqueta);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dourado-texto);
  }
  .grupo__numero {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  .grupo__campos {
    display: grid;
    gap: 18px 20px;
  }
  @media (min-width: 560px) {
    .grupo__campos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
