---
import { lodge } from '../config/lodge';
import { linguaDe, traducoes } from '../i18n/linguas';

import BotaoWhatsApp from './BotaoWhatsApp.astro';
import Enfase from './Enfase.astro';
import FormularioDisponibilidade from './FormularioDisponibilidade.astro';
import Icone from './Icone.astro';

interface Props {
  prefixo?: string;
}
const { prefixo = 'disp' } = Astro.props;
const l = linguaDe(Astro.url);
const t = traducoes(
  {
    etiqueta: 'Reservas',
    titulo: 'Consultar *disponibilidade*',
    texto: `Indique as datas da sua visita, o número de hóspedes e, se quiser, o tipo de quarto. A equipa do ${lodge.nome} responde com a disponibilidade, o preço actual e as condições da estadia.`,
    passos: [
      'Escolha as datas de entrada e de saída.',
      'Indique quantas pessoas vão ficar.',
      'A equipa do lodge confirma a disponibilidade e as condições.',
    ],
    whatsapp: `Olá, ${lodge.nome}! Gostaria de consultar a disponibilidade de alojamento.`,
  },
  {
    etiqueta: 'Bookings',
    titulo: 'Check *availability*',
    texto: `Tell us the dates of your visit, the number of guests and, if you wish, the room type. The ${lodge.nome} team will reply with availability, the current price and the conditions of your stay.`,
    passos: [
      'Choose your check-in and check-out dates.',
      'Tell us how many people will be staying.',
      'The lodge team confirms availability and conditions.',
    ],
    whatsapp: `Hello, ${lodge.nome}! I would like to check availability for a stay.`,
  },
)[l];
const icones = ['calendario', 'pessoas', 'visto'] as const;
---

<section
  id="disponibilidade"
  class="secao secao--escura disponibilidade"
  aria-labelledby={`${prefixo}-secao-titulo`}
>
  <div class="contentor grelha disponibilidade__grelha">
    <div class="bloco-titulo disponibilidade__titulo">
      <p class="etiqueta c-revelar">{t.etiqueta}</p>
      <h2 id={`${prefixo}-secao-titulo`} class="c-titulo">
        <Enfase texto={t.titulo} />
      </h2>
      <div class="texto">
        <p>{t.texto}</p>
      </div>
    </div>
    <div class="disponibilidade__form">
      <FormularioDisponibilidade prefixo={prefixo} />
    </div>
    <div class="disponibilidade__extra">
      <ul class="disponibilidade__passos">
        {t.passos.map((passo, i) => (
          <li>
            <Icone nome={icones[i]} tamanho={20} />
            <span>{passo}</span>
          </li>
        ))}
      </ul>
      <BotaoWhatsApp variante="contorno-claro" mensagem={t.whatsapp} />
    </div>
  </div>
</section>

<style>
  .disponibilidade__grelha {
    position: relative;
    align-items: start;
    row-gap: 40px;
  }
  .disponibilidade__extra {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  /* Telemóvel: título, formulário e só depois os passos. Computador: duas colunas. */
  @media (min-width: 1000px) {
    .disponibilidade__grelha {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      row-gap: 32px;
    }
    .disponibilidade__titulo {
      grid-column: 1;
      grid-row: 1;
    }
    .disponibilidade__extra {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }
    .disponibilidade__form {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
  .disponibilidade__passos {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .disponibilidade__passos li {
    display: flex;
    gap: 14px;
    align-items: center;
    color: rgb(250 248 243 / 0.86);
  }
  .disponibilidade__passos :global(svg) {
    flex: none;
    color: var(--dourado);
  }
</style>
