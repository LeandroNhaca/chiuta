---
import { LINGUAS, equivalente, linguaDe, rota, traducoes, type Lingua } from '../i18n/linguas';
import { ligacoesPedido, localizacaoCompletaEm, navegacaoEm } from '../lib/site';

import Assinatura from './Assinatura.astro';
import Icone from './Icone.astro';

const caminho = Astro.url.pathname;
const l = linguaDe(caminho);
const inicio = rota(l, '/');
const actual = (href: string) => (href === inicio ? caminho === inicio : caminho.startsWith(href));
const pedidos = ligacoesPedido(caminho, l);
const navegacao = navegacaoEm(l);
// Selector de língua: a mesma página na outra língua (ou o início, nas páginas só numa língua).
const linguas = (Object.keys(LINGUAS) as Lingua[]).map((x) => ({
  lingua: x,
  ...LINGUAS[x],
  href: equivalente(caminho, x) ?? rota(x, '/'),
}));
const t = traducoes(
  {
    principal: 'Principal',
    disponibilidade: 'Consultar disponibilidade',
    evento: 'Pedir orçamento para um evento',
    abrir: 'Abrir menu',
    fechar: 'Fechar menu',
    lingua: 'Língua',
  },
  {
    principal: 'Main',
    disponibilidade: 'Check availability',
    evento: 'Request a quote for an event',
    abrir: 'Open menu',
    fechar: 'Close menu',
    lingua: 'Language',
  },
)[l];
---

<header class="cabecalho" data-cabecalho>
  <div class="cabecalho__barra contentor">
    <Assinatura class="cabecalho__assinatura" altura={60} />
    <nav class="cabecalho__nav" aria-label={t.principal}>
      <ul>
        {navegacao.map((item) => (
          <li>
            <a href={item.href} aria-current={actual(item.href) ? 'page' : undefined}>
              {item.nome}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ul class="linguas" aria-label={t.lingua}>
      {linguas.map((x) => (
        <li>
          {x.lingua === l ? (
            <span class="linguas__actual" aria-current="true" title={x.nome}>
              {x.sigla}
            </span>
          ) : (
            <a href={x.href} hreflang={x.html} lang={x.html} title={x.nome}>
              <span aria-hidden="true">{x.sigla}</span>
              <span class="visualmente-oculto">{x.nome}</span>
            </a>
          )}
        </li>
      ))}
    </ul>
    <a class="botao botao--principal cabecalho__cta" href={pedidos.disponibilidade}>
      {t.disponibilidade}
    </a>
    <button
      class="cabecalho__menu"
      type="button"
      aria-expanded="false"
      aria-controls="menu-movel"
      data-abrir-menu
    >
      <Icone nome="menu" tamanho={22} />
      <span aria-hidden="true">Menu</span>
      <span class="visualmente-oculto">{t.abrir}</span>
    </button>
  </div>
</header>

<dialog id="menu-movel" class="menu-movel" aria-label="Menu" data-menu-movel>
  <div class="menu-movel__topo contentor">
    <Assinatura />
    <button class="menu-movel__fechar" type="button" data-fechar-menu>
      <Icone nome="fechar" tamanho={26} />
      <span class="visualmente-oculto">{t.fechar}</span>
    </button>
  </div>
  <nav class="menu-movel__nav contentor" aria-label={t.principal}>
    <ol>
      {navegacao.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={actual(item.href) ? 'page' : undefined}
            data-fechar-menu-ao-navegar
          >
            {item.nome}
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <div class="menu-movel__rodape contentor">
    <a class="botao botao--principal botao--bloco" href={pedidos.disponibilidade} data-fechar-menu-ao-navegar>
      {t.disponibilidade}
    </a>
    <a class="botao botao--verde botao--bloco" href={pedidos.evento} data-fechar-menu-ao-navegar>
      {t.evento}
    </a>
    <ul class="menu-movel__linguas" aria-label={t.lingua}>
      {linguas.map((x) => (
        <li>
          {x.lingua === l ? (
            <span aria-current="true">{x.nome}</span>
          ) : (
            <a href={x.href} hreflang={x.html} lang={x.html}>
              {x.nome}
            </a>
          )}
        </li>
      ))}
    </ul>
    <p>{localizacaoCompletaEm(l)}</p>
  </div>
</dialog>

<script>
  import '../scripts/cabecalho';
</script>

<style>
  /* Cabeçalho claro e fixo no topo: o logótipo oficial foi desenhado sobre branco. */
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: rgb(250 248 243 / 0.97);
    color: var(--texto);
    transition:
      border-color var(--transicao),
      box-shadow var(--transicao);
  }
  .cabecalho:global(.cabecalho--solido) {
    border-color: var(--linha);
    box-shadow: 0 6px 20px rgb(32 41 35 / 0.06);
  }
  .cabecalho__barra {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--cabecalho);
  }
  .cabecalho__assinatura {
    margin-right: auto;
  }
  .cabecalho__assinatura :global(img) {
    width: auto;
    height: calc(var(--cabecalho) - 16px);
  }
  .cabecalho__nav {
    display: none;
  }
  .cabecalho__nav ul {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cabecalho__nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    border-radius: 10px;
    font-size: 0.97rem;
    font-weight: 650;
    text-decoration: none;
    color: var(--texto);
    transition:
      color var(--transicao),
      background-color var(--transicao);
  }
  .cabecalho__nav a:hover {
    background: rgb(32 41 35 / 0.05);
  }
  .cabecalho__nav a[aria-current='page'] {
    color: var(--dourado-texto);
  }
  .cabecalho__nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 6px;
    height: 3px;
    border-radius: 2px;
    background: var(--dourado);
  }
  .cabecalho__cta {
    display: none;
    min-height: 46px;
    padding-inline: 20px;
  }
  /* Selector de língua: a sigla da língua actual e uma ligação para a outra. */
  .linguas {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }
  .linguas li + li::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 16px;
    margin-inline: 2px;
    vertical-align: middle;
    background: var(--linha);
  }
  .linguas a,
  .linguas__actual {
    display: inline-grid;
    place-items: center;
    min-width: 40px;
    min-height: 44px;
    border-radius: 10px;
  }
  .linguas a {
    color: var(--texto-suave);
    text-decoration: none;
    transition:
      color var(--transicao),
      background-color var(--transicao);
  }
  .linguas a:hover {
    background: rgb(32 41 35 / 0.05);
    color: var(--texto);
  }
  .linguas__actual {
    color: var(--dourado-texto);
  }
  .cabecalho__menu {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 14px;
    border: 2px solid rgb(32 41 35 / 0.2);
    border-radius: var(--raio);
    background: none;
    color: inherit;
    font: 750 0.95rem/1 var(--sans);
    cursor: pointer;
  }

  @media (min-width: 680px) {
    .cabecalho__cta {
      display: inline-flex;
    }
  }
  @media (min-width: 1240px) {
    .cabecalho__nav {
      display: block;
    }
    .cabecalho__menu {
      display: none;
    }
  }

  .menu-movel {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--branco);
    color: var(--texto);
    overflow-y: auto;
  }
  .menu-movel[open] {
    display: flex;
    flex-direction: column;
  }
  .menu-movel::backdrop {
    background: var(--branco);
  }
  .menu-movel__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--cabecalho);
    border-bottom: 1px solid var(--linha);
  }
  .menu-movel__topo :global(img) {
    width: auto;
    height: calc(var(--cabecalho) - 16px);
  }
  .menu-movel__fechar {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -10px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .menu-movel__nav {
    flex: 1;
    padding-block: 16px;
  }
  .menu-movel__nav ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu-movel__nav a {
    display: flex;
    align-items: center;
    min-height: 56px;
    font-size: 1.35rem;
    font-weight: 750;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-bottom: 1px solid var(--linha);
  }
  .menu-movel__nav a[aria-current='page'] {
    color: var(--dourado-texto);
  }
  .menu-movel__rodape {
    display: grid;
    gap: 12px;
    padding-block: 8px max(28px, env(safe-area-inset-bottom));
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }
  .menu-movel__rodape p {
    margin-top: 6px;
  }
  .menu-movel__linguas {
    display: flex;
    gap: 6px 20px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    font-weight: 700;
  }
  .menu-movel__linguas a,
  .menu-movel__linguas span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .menu-movel__linguas a {
    color: var(--verde);
    text-underline-offset: 3px;
  }
  .menu-movel__linguas [aria-current] {
    color: var(--dourado-texto);
  }
</style>
