---
/**
 * Logótipo do lodge com ligação para a página inicial. O logótipo foi desenhado sobre branco: em fundos
 * escuros vai numa pastilha branca (`sobreEscuro`). Sem ficheiro configurado, mostra o nome em texto.
 */
import { lodge } from '../config/lodge';
import { linguaDe, rota } from '../i18n/linguas';

interface Props {
  class?: string;
  sobreEscuro?: boolean;
  /** Altura em píxeis CSS (a largura acompanha a proporção do logótipo). */
  altura?: number;
}
const { class: classe, sobreEscuro = false, altura = 56 } = Astro.props;
const base = lodge.marca.logotipo;
// Proporção dos ficheiros gerados por scripts/imagens/gerar_icones.py (480 × 311).
const largura = Math.round((altura * 480) / 311);
const l = linguaDe(Astro.url);
---

<a
  href={rota(l, '/')}
  class:list={['assinatura', { 'assinatura--pastilha': sobreEscuro && base }, classe]}
  aria-label={`${lodge.nome}, ${l === 'en' ? 'home page' : 'página inicial'}`}
>
  {base ? (
    <img
      src={`${base}-240.webp`}
      srcset={`${base}-240.webp 240w, ${base}-480.webp 480w`}
      sizes={`${largura}px`}
      width={largura}
      height={altura}
      alt=""
      decoding="async"
    />
  ) : (
    <span class="assinatura__nome">{lodge.nome}</span>
  )}
</a>

<style>
  .assinatura {
    display: inline-flex;
    align-items: center;
    flex: none;
    color: inherit;
    line-height: 1;
    text-decoration: none;
  }
  .assinatura img {
    height: auto;
  }
  .assinatura--pastilha {
    padding: 8px 12px;
    border-radius: var(--raio-m);
    background: #fff;
  }
  .assinatura__nome {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
</style>
