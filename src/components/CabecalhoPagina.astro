---
/**
 * Abertura das páginas interiores: caminho, título, introdução e acções sobre fundo claro e, quando há
 * fotografia real, a fotografia ao lado, num tamanho que respeita a resolução dos originais.
 */
import type { IdFotografia } from '../data/fotografias';

import Foto from './Foto.astro';

interface Props {
  titulo: string;
  intro: string;
  foto?: IdFotografia;
  /** Quadrada para fotografias verticais ou quadradas; paisagem para as horizontais. */
  formato?: 'arco' | 'paisagem';
  /** Classe de enquadramento da fotografia (ver os estilos abaixo). */
  enquadramento?: 'centro' | 'baixo' | 'cima' | 'esquerda';
}

const { titulo, intro, foto, formato = 'arco', enquadramento = 'centro' } = Astro.props;
const temAccoes = Astro.slots.has('accoes');
---

<section class:list={['topo', { 'topo--com-foto': foto }]} aria-labelledby="topo-titulo">
  <div class="contentor topo__grelha">
    <div class="topo__texto">
      <nav class="topo__caminho" aria-label="Caminho">
        <a href="/">Início</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{titulo}</span>
      </nav>
      <h1 id="topo-titulo">
        <slot name="titulo">{titulo}</slot>
      </h1>
      <p class="lead">{intro}</p>
      {temAccoes && (
        <div class="accoes topo__accoes">
          <slot name="accoes" />
        </div>
      )}
    </div>
    {foto && (
      <div class:list={['topo__figura', `topo__figura--${formato}`]}>
        <Foto
          id={foto}
          prioridade
          sizes="(min-width: 900px) 560px, 92vw"
          class:list={['foto', 'topo__foto', `topo__foto--${enquadramento}`]}
        />
      </div>
    )}
  </div>
</section>

<style>
  .topo {
    position: relative;
    padding-block: clamp(28px, 5vw, 72px) clamp(48px, 7vw, 96px);
    background: var(--cinzento);
  }
  .topo__grelha {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .topo--com-foto .topo__grelha {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
  }
  .topo__texto {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .topo__caminho {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: var(--t-pequeno);
    font-weight: 600;
    color: var(--texto-suave);
  }
  .topo__caminho a {
    text-decoration: none;
  }
  .topo__caminho a:hover {
    text-decoration: underline;
  }
  .topo__caminho [aria-current='page'] {
    color: var(--texto);
  }
  .topo h1 {
    max-width: 16ch;
  }
  .topo .lead {
    color: var(--texto-suave);
  }
  .topo__accoes {
    margin-top: 6px;
  }
  .topo :global(.topo__foto) {
    display: block;
    aspect-ratio: 4 / 3;
    box-shadow: var(--sombra);
  }
  .topo__figura--arco :global(.topo__foto) {
    aspect-ratio: 1 / 1;
    max-height: 560px;
  }
  .topo :global(.topo__foto--baixo img) {
    object-position: 50% 75%;
  }
  .topo :global(.topo__foto--cima img) {
    object-position: 50% 25%;
  }
  .topo :global(.topo__foto--esquerda img) {
    object-position: 25% 50%;
  }
</style>
