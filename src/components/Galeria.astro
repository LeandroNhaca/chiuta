---
/**
 * Galeria só com fotografias reais e autorizadas, sem repetições: grelha editorial (proporções originais,
 * sem cortes) com filtros por categoria. Cada miniatura é uma ligação para a imagem (funciona sem
 * JavaScript); com JavaScript abre o visualizador, que percorre só as fotografias do filtro escolhido.
 */
import { categorias, credito, fotografias, srcset, urlFotografia, type Categoria } from '../data/fotografias';

import Foto from './Foto.astro';
import Icone from './Icone.astro';

const usadas = (Object.keys(categorias) as Categoria[])
  .map((c) => ({ id: c, nome: categorias[c], total: fotografias.filter((f) => f.categoria === c).length }))
  .filter((c) => c.total > 0);
---

<div class="galeria" data-galeria>
  {usadas.length > 1 && (
    <div
      class="galeria__filtros galeria__filtros--espera"
      role="group"
      aria-label="Filtrar por categoria"
      data-filtros
    >
      <button class="galeria__filtro" type="button" aria-pressed="true" data-filtro="todas">
        Todas <span class="galeria__total">{fotografias.length}</span>
      </button>
      {usadas.map((c) => (
        <button class="galeria__filtro" type="button" aria-pressed="false" data-filtro={c.id}>
          {c.nome} <span class="galeria__total">{c.total}</span>
        </button>
      ))}
    </div>
  )}
  <p class="visualmente-oculto" role="status" data-filtro-estado></p>
  <ul class="galeria__grelha">
    {fotografias.map((f) => (
      <li data-categoria={f.categoria}>
        <a
          class="galeria__item"
          href={urlFotografia(f)}
          data-galeria-item
          data-avif={srcset(f, 'avif')}
          data-webp={srcset(f, 'webp')}
          data-alt={f.alt}
          data-legenda={f.legenda}
          data-credito={credito(f)}
          data-largura={f.largura}
          data-altura={f.altura}
        >
          <Foto id={f.id} sizes="(min-width: 1100px) 600px, (min-width: 640px) 46vw, 92vw" class="foto" />
          <span class="galeria__legenda">
            <span>
              <span class="galeria__categoria">{categorias[f.categoria]}</span>
              {f.legenda}
            </span>
            <Icone nome="ampliar" tamanho={16} />
          </span>
          <span class="visualmente-oculto">(ampliar)</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<dialog class="lightbox" aria-label="Fotografia ampliada" data-lightbox>
  <div class="lightbox__barra">
    <p class="lightbox__contador" aria-live="polite" data-lightbox-contador></p>
    <button class="lightbox__botao" type="button" data-lightbox-fechar>
      <Icone nome="fechar" tamanho={26} />
      <span class="visualmente-oculto">Fechar</span>
    </button>
  </div>
  <figure class="lightbox__figura">
    <picture>
      <source type="image/avif" data-lightbox-avif sizes="100vw" />
      <img data-lightbox-img alt="" sizes="100vw" decoding="async" />
    </picture>
    <figcaption>
      <span class="lightbox__legenda" data-lightbox-legenda></span>
      <span class="lightbox__credito" data-lightbox-credito></span>
    </figcaption>
  </figure>
  <button class="lightbox__botao lightbox__nav lightbox__nav--anterior" type="button" data-lightbox-anterior>
    <Icone nome="seta-esquerda" tamanho={26} />
    <span class="visualmente-oculto">Fotografia anterior</span>
  </button>
  <button class="lightbox__botao lightbox__nav lightbox__nav--seguinte" type="button" data-lightbox-seguinte>
    <Icone nome="seta" tamanho={26} />
    <span class="visualmente-oculto">Fotografia seguinte</span>
  </button>
</dialog>

<script>
  import '../scripts/galeria';
</script>

<style>
  .galeria {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
  }
  .galeria__filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  /* Até o JavaScript os activar, os filtros ocupam o espaço mas não se vêem (sem saltos de layout). */
  .galeria__filtros--espera {
    visibility: hidden;
  }
  .galeria__filtro {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgb(32 41 35 / 0.22);
    border-radius: 999px;
    background: #fff;
    color: var(--texto);
    font: 700 0.95rem/1 var(--sans);
    cursor: pointer;
    transition:
      background-color var(--transicao),
      color var(--transicao),
      border-color var(--transicao);
  }
  .galeria__filtro:hover {
    border-color: var(--verde);
  }
  .galeria__filtro[aria-pressed='true'] {
    border-color: var(--verde);
    background: var(--verde);
    color: var(--branco);
  }
  .galeria__total {
    font-family: var(--titulos);
    font-size: 1rem;
    letter-spacing: 0;
    color: var(--dourado-texto);
  }
  .galeria__filtro[aria-pressed='true'] .galeria__total {
    color: rgb(255 255 255 / 0.85);
  }
  /* Grelha editorial: colunas desencontradas, cada fotografia na sua proporção original. */
  .galeria__grelha {
    margin: 0;
    padding: 0;
    list-style: none;
    columns: 1;
    column-gap: clamp(16px, 2.4vw, 28px);
  }
  @media (min-width: 640px) {
    .galeria__grelha {
      columns: 2;
    }
  }
  @media (min-width: 1100px) {
    .galeria__grelha:has(> li:nth-child(7)) {
      columns: 3;
    }
  }
  .galeria__grelha li {
    break-inside: avoid;
    margin-bottom: clamp(20px, 3vw, 36px);
  }
  .galeria__grelha li[hidden] {
    display: none;
  }
  .galeria__item {
    display: grid;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }
  .galeria__item :global(.foto) {
    display: block;
  }
  .galeria__categoria {
    display: block;
    margin-bottom: 2px;
    font-size: var(--t-etiqueta);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dourado-texto);
  }
  .galeria__item :global(img) {
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .galeria__item:hover :global(img) {
    transform: scale(1.04);
  }
  .galeria__legenda {
    display: flex;
    gap: 10px;
    align-items: end;
    justify-content: space-between;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .galeria__legenda :global(svg) {
    color: var(--dourado-texto);
  }

  .lightbox {
    --foco: var(--dourado);
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(5 22 18 / 0.97);
    color: var(--branco);
    overflow: hidden;
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .lightbox::backdrop {
    background: rgb(5 22 18 / 0.97);
  }
  .lightbox__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px max(12px, env(safe-area-inset-right)) 10px max(20px, env(safe-area-inset-left));
  }
  .lightbox__contador {
    font-size: var(--t-pequeno);
    letter-spacing: 0.12em;
    color: rgb(250 248 243 / 0.75);
  }
  .lightbox__figura {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 14px;
    min-height: 0;
    margin: 0;
    padding: 0 clamp(12px, 7vw, 96px) max(20px, env(safe-area-inset-bottom));
  }
  .lightbox__figura picture {
    display: grid;
    place-items: center;
    min-height: 0;
  }
  .lightbox__figura img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--raio);
  }
  .lightbox figcaption {
    display: grid;
    gap: 4px;
    justify-items: center;
    text-align: center;
  }
  .lightbox__legenda {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .lightbox__credito {
    font-size: 0.8125rem;
    color: rgb(250 248 243 / 0.65);
  }
  .lightbox__botao {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid transparent;
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
    transition: border-color var(--transicao);
  }
  .lightbox__botao:hover {
    border-color: rgb(250 248 243 / 0.4);
  }
  .lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgb(5 22 18 / 0.6);
  }
  .lightbox__nav--anterior {
    left: max(8px, env(safe-area-inset-left));
  }
  .lightbox__nav--seguinte {
    right: max(8px, env(safe-area-inset-right));
  }
</style>
