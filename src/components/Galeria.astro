---
/**
 * Galeria só com fotografias reais e autorizadas, sem repetições. Com poucas fotografias, uma grelha
 * editorial única (proporções originais, sem cortes); com muitas, agrupadas por categoria. Cada
 * miniatura é uma ligação para a imagem (funciona sem JavaScript); com JavaScript abre o visualizador.
 */
import { categorias, credito, fotografias, srcset, urlFotografia, type Categoria } from '../data/fotografias';

import Foto from './Foto.astro';
import Icone from './Icone.astro';

// A partir deste número, os grupos por categoria ajudam mais do que atrapalham.
const MINIMO_PARA_AGRUPAR = 9;
const ordem = Object.keys(categorias) as Categoria[];
const grupos =
  fotografias.length >= MINIMO_PARA_AGRUPAR
    ? ordem
        .map((c) => ({ id: c, nome: categorias[c], fotos: fotografias.filter((f) => f.categoria === c) }))
        .filter((g) => g.fotos.length > 0)
    : [{ id: 'todas', nome: '', fotos: fotografias }];
const Grupo = grupos.length > 1 ? 'section' : 'div';
---

<div class="galeria" data-galeria>
  {grupos.map((g) => (
    <Grupo class="galeria__grupo" aria-labelledby={g.nome ? `galeria-${g.id}` : undefined}>
      {g.nome && (
        <div class="galeria__cabeca">
          <h2 id={`galeria-${g.id}`}>{g.nome}</h2>
          <p>{g.fotos.length === 1 ? '1 fotografia' : `${g.fotos.length} fotografias`}</p>
        </div>
      )}
      <ul class:list={['galeria__grelha', { 'galeria__grelha--editorial': !g.nome }]}>
        {g.fotos.map((f) => (
          <li>
            <a
              class="galeria__item"
              href={urlFotografia(f)}
              data-galeria-item
              data-avif={srcset(f, 'avif')}
              data-webp={srcset(f, 'webp')}
              data-alt={f.alt}
              data-legenda={f.legenda}
              data-credito={credito(f)}
              data-largura={f.largura}
              data-altura={f.altura}
            >
              <Foto id={f.id} sizes="(min-width: 1100px) 600px, (min-width: 640px) 46vw, 92vw" class="foto" />
              <span class="galeria__legenda">
                <span>
                  {!g.nome && <span class="galeria__categoria">{categorias[f.categoria]}</span>}
                  {f.legenda}
                </span>
                <Icone nome="ampliar" tamanho={16} />
              </span>
              <span class="visualmente-oculto">(ampliar)</span>
            </a>
          </li>
        ))}
      </ul>
    </Grupo>
  ))}
</div>

<dialog class="lightbox" aria-label="Fotografia ampliada" data-lightbox>
  <div class="lightbox__barra">
    <p class="lightbox__contador" aria-live="polite" data-lightbox-contador></p>
    <button class="lightbox__botao" type="button" data-lightbox-fechar>
      <Icone nome="fechar" tamanho={26} />
      <span class="visualmente-oculto">Fechar</span>
    </button>
  </div>
  <figure class="lightbox__figura">
    <picture>
      <source type="image/avif" data-lightbox-avif sizes="100vw" />
      <img data-lightbox-img alt="" sizes="100vw" decoding="async" />
    </picture>
    <figcaption>
      <span class="lightbox__legenda" data-lightbox-legenda></span>
      <span class="lightbox__credito" data-lightbox-credito></span>
    </figcaption>
  </figure>
  <button class="lightbox__botao lightbox__nav lightbox__nav--anterior" type="button" data-lightbox-anterior>
    <Icone nome="seta-esquerda" tamanho={26} />
    <span class="visualmente-oculto">Fotografia anterior</span>
  </button>
  <button class="lightbox__botao lightbox__nav lightbox__nav--seguinte" type="button" data-lightbox-seguinte>
    <Icone nome="seta" tamanho={26} />
    <span class="visualmente-oculto">Fotografia seguinte</span>
  </button>
</dialog>

<script>
  import '../scripts/galeria';
</script>

<style>
  .galeria {
    display: grid;
    gap: clamp(64px, 8vw, 112px);
  }
  .galeria__cabeca {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--linha);
  }
  .galeria__cabeca h2 {
    font-size: var(--t-h3);
  }
  .galeria__cabeca p {
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }
  .galeria__grelha {
    display: grid;
    gap: clamp(12px, 1.8vw, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .galeria__grelha {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .galeria__grelha {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* Grelha editorial: duas colunas desencontradas, cada fotografia na sua proporção original. */
  .galeria__grelha--editorial {
    display: block;
    columns: 1;
    column-gap: clamp(16px, 3vw, 40px);
  }
  @media (min-width: 640px) {
    .galeria__grelha--editorial {
      columns: 2;
    }
  }
  .galeria__grelha--editorial li {
    break-inside: avoid;
    margin-bottom: clamp(28px, 4vw, 56px);
  }
  @media (min-width: 640px) {
    .galeria__grelha--editorial li:nth-child(odd) {
      padding-right: clamp(0px, 3vw, 48px);
    }
  }
  .galeria__item {
    display: grid;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }
  .galeria__item :global(.foto) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .galeria__grelha--editorial .galeria__item :global(.foto) {
    aspect-ratio: auto;
  }
  .galeria__categoria {
    display: block;
    margin-bottom: 2px;
    font-size: var(--t-etiqueta);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dourado-texto);
  }
  .galeria__item :global(img) {
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .galeria__item:hover :global(img) {
    transform: scale(1.04);
  }
  .galeria__legenda {
    display: flex;
    gap: 10px;
    align-items: end;
    justify-content: space-between;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .galeria__legenda :global(svg) {
    color: var(--dourado-texto);
  }

  .lightbox {
    --foco: var(--dourado);
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(4 18 14 / 0.97);
    color: var(--branco);
    overflow: hidden;
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .lightbox::backdrop {
    background: rgb(4 18 14 / 0.97);
  }
  .lightbox__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px max(12px, env(safe-area-inset-right)) 10px max(20px, env(safe-area-inset-left));
  }
  .lightbox__contador {
    font-size: var(--t-pequeno);
    letter-spacing: 0.12em;
    color: rgb(250 248 243 / 0.75);
  }
  .lightbox__figura {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 14px;
    min-height: 0;
    margin: 0;
    padding: 0 clamp(12px, 7vw, 96px) max(20px, env(safe-area-inset-bottom));
  }
  .lightbox__figura picture {
    display: grid;
    place-items: center;
    min-height: 0;
  }
  .lightbox__figura img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--raio);
  }
  .lightbox figcaption {
    display: grid;
    gap: 4px;
    justify-items: center;
    text-align: center;
  }
  .lightbox__legenda {
    font-family: var(--serif);
    font-size: 1.35rem;
  }
  .lightbox__credito {
    font-size: 0.8125rem;
    color: rgb(250 248 243 / 0.65);
  }
  .lightbox__botao {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid transparent;
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
    transition: border-color var(--transicao);
  }
  .lightbox__botao:hover {
    border-color: rgb(250 248 243 / 0.4);
  }
  .lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgb(4 18 14 / 0.55);
  }
  .lightbox__nav--anterior {
    left: max(8px, env(safe-area-inset-left));
  }
  .lightbox__nav--seguinte {
    right: max(8px, env(safe-area-inset-right));
  }
</style>
