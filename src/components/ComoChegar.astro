---
/**
 * Como chegar. Com coordenadas confirmadas mostra o mapa incorporado; com a ligação do Google Maps do lodge,
 * a fotografia da placa da entrada e o botão de direcções; sem nenhuma das duas, só o que está confirmado
 * (Boane, província de Maputo) e o resto assinalado como pendente.
 */
import { lodge } from '../config/lodge';
import { localizacaoCompleta, urlDireccoes, urlMapaIncorporado } from '../lib/site';

import Foto from './Foto.astro';
import Icone from './Icone.astro';

interface Props {
  /** Na página de contactos o botão "Fale connosco" seria redundante. */
  semContacto?: boolean;
}
const { semContacto = false } = Astro.props;
const mapa = urlMapaIncorporado();
const direccoes = urlDireccoes();
const { morada, localidade, provincia, pais } = lodge.localizacao;
---

<section id="como-chegar" class="secao secao--clara como-chegar" aria-labelledby="como-chegar-titulo">
  <div class="contentor grelha grelha--texto-foto">
    <div class="bloco-titulo">
      <p class="etiqueta">Como chegar</p>
      <h2 id="como-chegar-titulo">
        Boane, <em>província de Maputo</em>.
      </h2>
      <div class="texto">
        <p>O Mulotane Lodge fica em Boane, na província de Maputo, em Moçambique.</p>
        {direccoes && (
          <p>
            Abra a localização no Google Maps para ver o percurso a partir de onde está. À chegada, procure a
            placa do Mulotane Lodge no muro da entrada.
          </p>
        )}
      </div>
      <dl class="como-chegar__dados">
        <div>
          <dt>
            <Icone nome="pino" tamanho={18} /> Localização
          </dt>
          <dd>{localizacaoCompleta}</dd>
        </div>
        <div>
          <dt>
            <Icone nome="info" tamanho={18} /> Morada e acessos
          </dt>
          <dd>
            {morada ? (
              morada
            ) : direccoes ? (
              <a class="como-chegar__mapa-ligacao" href={direccoes} target="_blank" rel="noopener">
                Ver no Google Maps
                <span class="visualmente-oculto">(abre numa nova janela)</span>
              </a>
            ) : (
              <span class="pendente">A confirmar</span>
            )}
          </dd>
        </div>
      </dl>
      {(direccoes || !semContacto) && (
        <div class="accoes">
          {direccoes && (
            <a class="botao botao--verde" href={direccoes} target="_blank" rel="noopener">
              Obter direcções
              <Icone nome="externa" tamanho={18} />
              <span class="visualmente-oculto">(abre o Google Maps numa nova janela)</span>
            </a>
          )}
          {!semContacto && (
            <a class="botao botao--contorno" href="/contactos/">
              Fale connosco
            </a>
          )}
        </div>
      )}
    </div>
    <div class="como-chegar__figura">
      {mapa ? (
        <iframe
          class="como-chegar__mapa"
          src={mapa}
          title={`Mapa da localização do ${lodge.nome}`}
          loading="lazy"
        />
      ) : direccoes ? (
        <figure class="como-chegar__placa">
          <Foto id="placa-entrada" sizes="(min-width: 900px) 520px, 92vw" class="foto como-chegar__foto" />
          <figcaption class="legenda">A placa do Mulotane Lodge, no muro da entrada.</figcaption>
        </figure>
      ) : (
        <div class="como-chegar__local">
          <img
            class="como-chegar__folhagem"
            src="/images/mulotane/conceptual/folhagem.svg"
            alt=""
            width="520"
            height="600"
            loading="lazy"
          />
          <p class="como-chegar__pais">{pais}</p>
          <p class="como-chegar__localidade">{localidade}</p>
          <p class="como-chegar__provincia">Província de {provincia}</p>
          <p class="como-chegar__mapa-pendente">
            <span class="pendente pendente--claro">Localização exacta a confirmar</span>
          </p>
          <p class="como-chegar__explicacao">
            O mapa e a ligação para obter direcções ficam disponíveis assim que o ponto exacto for confirmado
            pelo Mulotane Lodge.
          </p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .como-chegar__dados {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--linha);
  }
  .como-chegar__dados > div {
    padding: 16px 0;
    border-bottom: 1px solid var(--linha);
  }
  .como-chegar__dados dt {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: var(--t-etiqueta);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dourado-texto);
  }
  .como-chegar__dados dd {
    margin: 6px 0 0;
    font-family: var(--serif);
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .como-chegar__dados dd .pendente {
    font-family: var(--sans);
  }
  .como-chegar__figura {
    justify-self: center;
    width: 100%;
    max-width: 520px;
  }
  .como-chegar__local {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 10px;
    aspect-ratio: 4 / 5;
    max-height: 640px;
    width: 100%;
    padding: 40px 24px;
    overflow: hidden;
    border-radius: var(--raio-arco);
    background: radial-gradient(circle at 50% 115%, rgb(199 161 90 / 0.25), transparent 55%), var(--verde);
    color: var(--branco);
    text-align: center;
  }
  .como-chegar__folhagem {
    position: absolute;
    left: 50%;
    bottom: -60px;
    width: 320px;
    height: auto;
    opacity: 0.16;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .como-chegar__pais,
  .como-chegar__provincia {
    position: relative;
    font-size: var(--t-etiqueta);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--dourado);
  }
  .como-chegar__localidade {
    position: relative;
    font-family: var(--serif);
    font-size: clamp(3.2rem, 2.4rem + 3vw, 5rem);
    font-style: italic;
    line-height: 1;
  }
  .como-chegar__mapa-pendente {
    position: relative;
    margin-top: 18px;
  }
  .como-chegar__explicacao {
    position: relative;
    max-width: 22rem;
    font-size: var(--t-pequeno);
    line-height: 1.55;
    color: rgb(250 248 243 / 0.8);
  }
  .como-chegar__mapa-ligacao {
    color: var(--verde);
    text-underline-offset: 4px;
    text-decoration-color: rgb(11 48 39 / 0.4);
  }
  .como-chegar__placa {
    margin: 0;
  }
  .como-chegar :global(.como-chegar__foto) {
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--raio-arco);
  }
  .como-chegar :global(.como-chegar__foto img) {
    object-position: 50% 40%;
  }
  .como-chegar__mapa {
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 0;
    border-radius: var(--raio);
  }
</style>
