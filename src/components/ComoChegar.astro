---
/**
 * Localização e contactos: morada, coordenadas e canais oficiais publicados pelo lodge, com botões para
 * ligar, escrever, abrir o Google Maps e obter direcções. O mapa do OpenStreetMap só carrega quando o
 * visitante o pede (privacidade e velocidade); sem JavaScript, a mesma ligação abre o mapa numa nova janela.
 * Sem localização configurada, assinala o que falta como "a confirmar".
 */
import { lodge } from '../config/lodge';
import {
  canaisContacto,
  coordenadasTexto,
  localizacaoCompleta,
  urlAbrirMapa,
  urlDireccoes,
  urlMapaIncorporado,
} from '../lib/site';

import Foto from './Foto.astro';
import Icone, { type NomeIcone } from './Icone.astro';
import RedesSociais from './RedesSociais.astro';

interface Props {
  /** Na página de contactos os canais já estão na secção anterior. */
  semContacto?: boolean;
}
const { semContacto = false } = Astro.props;
const mapa = urlMapaIncorporado();
const abrirMapa = urlAbrirMapa();
const direccoes = urlDireccoes();
const coordenadas = coordenadasTexto();
const { morada, localidade, provincia } = lodge.localizacao;
const c = lodge.mapa.coordenadas;
const mapaExterno = c
  ? `https://www.openstreetmap.org/?mlat=${c.lat}&mlon=${c.lng}#map=16/${c.lat}/${c.lng}`
  : '';
const canais = canaisContacto.filter((k) => k.href);
const iconeCanal: Record<string, NomeIcone> = { telefone: 'telefone', whatsapp: 'whatsapp', email: 'email' };
const accaoCanal: Record<string, string> = {
  telefone: 'Ligar',
  whatsapp: 'WhatsApp',
  email: 'E-mail',
};
---

<section id="como-chegar" class="secao secao--clara como-chegar" aria-labelledby="como-chegar-titulo">
  <div class="contentor grelha grelha--texto-foto">
    <div class="bloco-titulo">
      <p class="etiqueta c-revelar">Localização e contactos</p>
      <h2 id="como-chegar-titulo" class="c-titulo">
        {morada ? (
          <>
            Bairro de Mulotana, <em>{localidade}.</em>
          </>
        ) : (
          <>
            {localidade}, <em>província de {provincia}</em>.
          </>
        )}
      </h2>
      <dl class="como-chegar__dados">
        <div>
          <dt>
            <Icone nome="pino" tamanho={18} /> Morada
          </dt>
          <dd>
            {morada ? (
              <>
                {morada}
                <br />
                {localizacaoCompleta}
              </>
            ) : (
              <>
                {localizacaoCompleta} <span class="pendente">Morada a confirmar</span>
              </>
            )}
          </dd>
        </div>
        {coordenadas && (
          <div>
            <dt>
              <Icone nome="mapa" tamanho={18} /> Coordenadas
            </dt>
            <dd>{coordenadas}</dd>
          </div>
        )}
        {!semContacto &&
          canais.map((k) => (
            <div>
              <dt>
                <Icone nome={iconeCanal[k.id]} tamanho={18} /> {k.id === 'telefone' ? 'Reservas' : k.rotulo}
              </dt>
              <dd>
                <a href={k.href} {...(k.externo ? { target: '_blank', rel: 'noopener' } : {})}>
                  {k.valor}
                  {k.externo && <span class="visualmente-oculto"> (abre numa nova janela)</span>}
                </a>
              </dd>
            </div>
          ))}
      </dl>
      {!semContacto && canais.length > 0 && (
        <div class="accoes como-chegar__canais">
          {canais.map((k, i) => (
            <a
              class:list={['botao', i === 0 ? 'botao--principal' : 'botao--contorno']}
              href={k.href}
              {...(k.externo ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <Icone nome={iconeCanal[k.id]} tamanho={18} />
              {accaoCanal[k.id]}
              {k.externo && <span class="visualmente-oculto">(abre numa nova janela)</span>}
            </a>
          ))}
        </div>
      )}
      {(abrirMapa || direccoes) && (
        <div class="accoes">
          {abrirMapa && (
            <a class="botao botao--verde" href={abrirMapa} target="_blank" rel="noopener">
              <Icone nome="pino" tamanho={18} />
              Abrir no Google Maps
              <span class="visualmente-oculto">(abre numa nova janela)</span>
            </a>
          )}
          {direccoes && direccoes !== abrirMapa && (
            <a class="ligacao-seta" href={direccoes} target="_blank" rel="noopener">
              <span>Obter direcções</span>
              <Icone nome="externa" tamanho={18} />
              <span class="visualmente-oculto">(abre o Google Maps numa nova janela)</span>
            </a>
          )}
        </div>
      )}
      {!semContacto && <RedesSociais />}
    </div>

    <div class="como-chegar__figura">
      <Foto id="edificio-colmo" sizes="(min-width: 900px) 640px, 92vw" class="foto como-chegar__foto" />
      {mapa ? (
        <div
          class="como-chegar__mapa"
          data-mapa
          data-src={mapa}
          data-titulo={`Mapa da localização do ${lodge.nome}`}
        >
          <Icone nome="mapa" tamanho={40} />
          <p class="como-chegar__mapa-titulo">Mapa do lodge</p>
          {coordenadas && <p class="como-chegar__mapa-coord">{coordenadas}</p>}
          <a class="botao botao--verde" href={mapaExterno} target="_blank" rel="noopener" data-mostrar-mapa>
            Mostrar o mapa
            <span class="visualmente-oculto">(OpenStreetMap)</span>
          </a>
          <p class="como-chegar__mapa-nota">
            O mapa vem do OpenStreetMap e só carrega quando o pedir. Coordenadas publicadas pelo lodge.
          </p>
        </div>
      ) : (
        <div class="como-chegar__mapa">
          <Icone nome="pino" tamanho={40} />
          <p class="como-chegar__mapa-titulo">{localidade}</p>
          <p class="como-chegar__mapa-coord">Província de {provincia}</p>
          <span class="pendente">Localização exacta a confirmar</span>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  import '../scripts/mapa';
</script>

<style>
  .como-chegar__dados {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--linha);
  }
  .como-chegar__dados > div {
    display: grid;
    gap: 4px 20px;
    padding: 14px 0;
    border-bottom: 1px solid var(--linha);
  }
  @media (min-width: 560px) {
    .como-chegar__dados > div {
      grid-template-columns: 150px minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .como-chegar__dados dt {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: var(--t-pequeno);
    font-weight: 800;
    color: var(--dourado-texto);
  }
  .como-chegar__dados dd {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
  }
  .como-chegar__dados a {
    color: var(--verde);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .como-chegar__canais {
    margin-top: 4px;
  }
  .como-chegar__figura {
    display: grid;
    gap: 14px;
    align-self: start;
  }
  .como-chegar__figura :global(.como-chegar__foto) {
    display: block;
    aspect-ratio: 16 / 10;
  }
  .como-chegar__mapa {
    display: grid;
    gap: 8px;
    place-content: center;
    justify-items: center;
    min-height: 280px;
    padding: 28px 24px;
    overflow: hidden;
    border: 1px solid var(--linha);
    border-radius: var(--raio-l);
    background:
      radial-gradient(circle at 30% 20%, rgb(11 48 39 / 0.16), transparent 55%),
      radial-gradient(circle at 80% 85%, rgb(199 161 90 / 0.14), transparent 50%), var(--cinzento);
    text-align: center;
    color: var(--texto);
  }
  .como-chegar__mapa > :global(svg) {
    color: var(--dourado-texto);
  }
  .como-chegar__mapa-titulo {
    font-size: var(--t-h3);
    font-weight: 800;
  }
  .como-chegar__mapa-coord {
    font-weight: 600;
    color: var(--texto-suave);
  }
  .como-chegar__mapa-nota {
    max-width: 30em;
    margin-top: 6px;
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }
  /* Depois de carregado, o mapa ocupa a moldura toda. */
  .como-chegar__mapa:global(.como-chegar__mapa--carregado) {
    display: block;
    padding: 0;
  }
  .como-chegar__mapa :global(iframe) {
    width: 100%;
    height: 100%;
    min-height: 380px;
    border: 0;
  }
</style>
