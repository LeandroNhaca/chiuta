---
/**
 * Localização e contactos: morada, coordenadas e canais oficiais publicados pelo lodge, com botões para
 * ligar, escrever, abrir o Google Maps e obter direcções. O mapa do OpenStreetMap aparece logo na página, num
 * iframe com carregamento diferido (só carrega quando o visitante se aproxima dele; funciona sem JavaScript).
 * Sem localização configurada, assinala o que falta como "a confirmar".
 */
import { lodge } from '../config/lodge';
import { linguaDe, traducoes } from '../i18n/linguas';
import {
  canaisContactoEm,
  coordenadasTexto,
  localizacaoCompletaEm,
  urlAbrirMapa,
  urlDireccoes,
  urlMapaIncorporado,
} from '../lib/site';

import Enfase from './Enfase.astro';
import Foto from './Foto.astro';
import Icone, { type NomeIcone } from './Icone.astro';
import RedesSociais from './RedesSociais.astro';

interface Props {
  /** Na página de contactos os canais já estão na secção anterior. */
  semContacto?: boolean;
}
const { semContacto = false } = Astro.props;
const l = linguaDe(Astro.url);
const mapa = urlMapaIncorporado();
const abrirMapa = urlAbrirMapa();
const direccoes = urlDireccoes();
const coordenadas = coordenadasTexto(lodge.mapa, l);
const localizacaoCompleta = localizacaoCompletaEm(l);
const { morada, localidade, provincia } = lodge.localizacao;
const c = lodge.mapa.coordenadas;
const mapaExterno = c
  ? `https://www.openstreetmap.org/?mlat=${c.lat}&mlon=${c.lng}#map=16/${c.lat}/${c.lng}`
  : '';
const canais = canaisContactoEm(l).filter((k) => k.href);
const iconeCanal: Record<string, NomeIcone> = { telefone: 'telefone', whatsapp: 'whatsapp', email: 'email' };
const t = traducoes(
  {
    etiqueta: 'Localização e contactos',
    titulo: `Bairro de Mulotana, *${localidade}.*`,
    tituloSemMorada: `${localidade}, *província de ${provincia}*.`,
    morada: 'Morada',
    moradaPendente: 'Morada a confirmar',
    coordenadas: 'Coordenadas',
    reservas: 'Reservas',
    novaJanela: '(abre numa nova janela)',
    accao: { telefone: 'Ligar', whatsapp: 'WhatsApp', email: 'E-mail' } as Record<string, string>,
    abrirGoogle: 'Abrir no Google Maps',
    direccoes: 'Obter direcções',
    direccoesNovaJanela: '(abre o Google Maps numa nova janela)',
    mapaTitulo: `Mapa da localização do ${lodge.nome}`,
    mapaLegenda: 'Mapa do OpenStreetMap',
    mapaMaior: 'Ver mapa maior',
    mapaNovaJanela: '(abre o OpenStreetMap numa nova janela)',
    provincia: `Província de ${provincia}`,
    localPendente: 'Localização exacta a confirmar',
  },
  {
    etiqueta: 'Location and contact',
    titulo: `Bairro de Mulotana, *${localidade}.*`,
    tituloSemMorada: `${localidade}, *${provincia} Province*.`,
    morada: 'Address',
    moradaPendente: 'Address to be confirmed',
    coordenadas: 'Coordinates',
    reservas: 'Bookings',
    novaJanela: '(opens in a new window)',
    accao: { telefone: 'Call', whatsapp: 'WhatsApp', email: 'Email' } as Record<string, string>,
    abrirGoogle: 'Open in Google Maps',
    direccoes: 'Get directions',
    direccoesNovaJanela: '(opens Google Maps in a new window)',
    mapaTitulo: `Map showing the location of ${lodge.nome}`,
    mapaLegenda: 'OpenStreetMap map',
    mapaMaior: 'View larger map',
    mapaNovaJanela: '(opens OpenStreetMap in a new window)',
    provincia: `${provincia} Province`,
    localPendente: 'Exact location to be confirmed',
  },
)[l];
---

<section id="como-chegar" class="secao secao--clara como-chegar" aria-labelledby="como-chegar-titulo">
  <div class="contentor grelha grelha--texto-foto">
    <div class="bloco-titulo">
      <p class="etiqueta c-revelar">{t.etiqueta}</p>
      <h2 id="como-chegar-titulo" class="c-titulo">
        <Enfase texto={morada ? t.titulo : t.tituloSemMorada} />
      </h2>
      <dl class="como-chegar__dados">
        <div>
          <dt>
            <Icone nome="pino" tamanho={18} /> {t.morada}
          </dt>
          <dd>
            {morada ? (
              <>
                {morada}
                <br />
                {localizacaoCompleta}
              </>
            ) : (
              <>
                {localizacaoCompleta} <span class="pendente">{t.moradaPendente}</span>
              </>
            )}
          </dd>
        </div>
        {coordenadas && (
          <div>
            <dt>
              <Icone nome="mapa" tamanho={18} /> {t.coordenadas}
            </dt>
            <dd>{coordenadas}</dd>
          </div>
        )}
        {!semContacto &&
          canais.map((k) => (
            <div>
              <dt>
                <Icone nome={iconeCanal[k.id]} tamanho={18} /> {k.id === 'telefone' ? t.reservas : k.rotulo}
              </dt>
              <dd>
                <a href={k.href} {...(k.externo ? { target: '_blank', rel: 'noopener' } : {})}>
                  {k.valor}
                  {k.externo && <span class="visualmente-oculto"> {t.novaJanela}</span>}
                </a>
              </dd>
            </div>
          ))}
      </dl>
      {!semContacto && canais.length > 0 && (
        <div class="accoes como-chegar__canais">
          {canais.map((k, i) => (
            <a
              class:list={['botao', i === 0 ? 'botao--principal' : 'botao--contorno']}
              href={k.href}
              {...(k.externo ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <Icone nome={iconeCanal[k.id]} tamanho={18} />
              {t.accao[k.id]}
              {k.externo && <span class="visualmente-oculto">{t.novaJanela}</span>}
            </a>
          ))}
        </div>
      )}
      {(abrirMapa || direccoes) && (
        <div class="accoes">
          {abrirMapa && (
            <a class="botao botao--verde" href={abrirMapa} target="_blank" rel="noopener">
              <Icone nome="pino" tamanho={18} />
              {t.abrirGoogle}
              <span class="visualmente-oculto">{t.novaJanela}</span>
            </a>
          )}
          {direccoes && direccoes !== abrirMapa && (
            <a class="ligacao-seta" href={direccoes} target="_blank" rel="noopener">
              <span>{t.direccoes}</span>
              <Icone nome="externa" tamanho={18} />
              <span class="visualmente-oculto">{t.direccoesNovaJanela}</span>
            </a>
          )}
        </div>
      )}
      {!semContacto && <RedesSociais />}
    </div>

    <div class="como-chegar__figura">
      <Foto id="edificio-colmo" sizes="(min-width: 900px) 700px, 92vw" class="foto como-chegar__foto" />
      {mapa ? (
        <figure class="como-chegar__mapa como-chegar__mapa--iframe">
          <iframe src={mapa} title={t.mapaTitulo} loading="lazy" referrerpolicy="no-referrer"></iframe>
          <figcaption class="como-chegar__mapa-legenda">
            <span>
              {t.mapaLegenda}
              {coordenadas && ` · ${coordenadas}`}
            </span>
            <a href={mapaExterno} target="_blank" rel="noopener">
              {t.mapaMaior}
              <span class="visualmente-oculto">{t.mapaNovaJanela}</span>
            </a>
          </figcaption>
        </figure>
      ) : (
        <div class="como-chegar__mapa">
          <Icone nome="pino" tamanho={40} />
          <p class="como-chegar__mapa-titulo">{localidade}</p>
          <p class="como-chegar__mapa-coord">{t.provincia}</p>
          <span class="pendente">{t.localPendente}</span>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .como-chegar__dados {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--linha);
  }
  .como-chegar__dados > div {
    display: grid;
    gap: 4px 20px;
    padding: 14px 0;
    border-bottom: 1px solid var(--linha);
  }
  @media (min-width: 560px) {
    .como-chegar__dados > div {
      grid-template-columns: 150px minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .como-chegar__dados dt {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: var(--t-pequeno);
    font-weight: 800;
    color: var(--dourado-texto);
  }
  .como-chegar__dados dd {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
  }
  .como-chegar__dados a {
    color: var(--verde);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .como-chegar__canais {
    margin-top: 4px;
  }
  .como-chegar__figura {
    display: grid;
    gap: 14px;
    align-self: start;
  }
  .como-chegar__figura :global(.como-chegar__foto) {
    display: block;
    aspect-ratio: 16 / 10;
  }
  .como-chegar__mapa {
    display: grid;
    gap: 8px;
    place-content: center;
    justify-items: center;
    min-height: 280px;
    padding: 28px 24px;
    overflow: hidden;
    border: 1px solid var(--linha);
    border-radius: var(--raio-l);
    background:
      radial-gradient(circle at 30% 20%, rgb(11 48 39 / 0.16), transparent 55%),
      radial-gradient(circle at 80% 85%, rgb(199 161 90 / 0.14), transparent 50%), var(--cinzento);
    text-align: center;
    color: var(--texto);
  }
  .como-chegar__mapa > :global(svg) {
    color: var(--dourado-texto);
  }
  .como-chegar__mapa-titulo {
    font-size: var(--t-h3);
    font-weight: 800;
  }
  .como-chegar__mapa-coord {
    font-weight: 600;
    color: var(--texto-suave);
  }
  /* Mapa: o iframe ocupa a moldura; o fundo fica à vista enquanto carrega. */
  .como-chegar__mapa--iframe {
    display: grid;
    grid-template-rows: minmax(340px, 1fr) auto;
    place-content: stretch;
    justify-items: stretch;
    gap: 0;
    margin: 0;
    padding: 0;
    text-align: start;
  }
  .como-chegar__mapa iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 340px;
    border: 0;
  }
  .como-chegar__mapa-legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    align-items: baseline;
    justify-content: space-between;
    padding: 10px 16px;
    border-top: 1px solid var(--linha);
    background: var(--branco);
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }
  .como-chegar__mapa-legenda a {
    font-weight: 700;
    color: var(--verde);
    text-underline-offset: 3px;
  }
</style>
