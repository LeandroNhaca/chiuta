---
/**
 * Os quatro espaços do lodge, com o mesmo peso: alojamento, restaurante, piscinas e eventos. Cada cartão
 * abre com uma fotografia real do espaço.
 */
import type { IdFotografia } from '../data/fotografias';

import Foto from './Foto.astro';
import Icone, { type NomeIcone } from './Icone.astro';

type Id = 'alojamento' | 'restaurante' | 'piscinas' | 'eventos';

interface Props {
  /** Quatro colunas (página inicial) ou três (no fim das páginas interiores, sem a página actual). */
  variante?: 'pilares' | 'cartoes';
  excluir?: Id;
}

const { variante = 'pilares', excluir } = Astro.props;

const itens: {
  id: Id;
  icone: NomeIcone;
  titulo: string;
  texto: string;
  href: string;
  foto: IdFotografia;
}[] = [
  {
    id: 'alojamento',
    icone: 'cama',
    titulo: 'Alojamento',
    texto: 'Quartos para descansar depois de um dia de lazer, de trabalho ou de celebração.',
    href: '/alojamento/',
    foto: 'quarto-cadeirao',
  },
  {
    id: 'eventos',
    icone: 'pessoas',
    titulo: 'Conferências e eventos',
    texto: 'Salas de conferências e espaços ao ar livre para reunir e celebrar.',
    href: '/eventos/',
    foto: 'sala-conferencias-u',
  },
  {
    id: 'piscinas',
    icone: 'ondas',
    titulo: 'Piscinas e jardins',
    texto: 'Lazer ao ar livre, entre palmeiras, árvores de sombra e jardins cuidados.',
    href: '/piscinas/',
    foto: 'piscina-topiaria',
  },
  {
    id: 'restaurante',
    icone: 'talheres',
    titulo: 'Restaurante',
    texto: 'Refeições numa sala ampla, com janelas largas sobre o jardim.',
    href: '/restaurante/',
    foto: 'sala-refeicoes-bar',
  },
];
const lista = itens.filter((i) => i.id !== excluir);
---

<ul class:list={['indice', `indice--${variante}`, 'c-cartoes']}>
  {lista.map((i) => (
    <li>
      <a class="indice__item" href={i.href}>
        <Foto
          id={i.foto}
          sizes={
            variante === 'pilares'
              ? '(min-width: 1100px) 300px, (min-width: 640px) 46vw, 92vw'
              : '(min-width: 760px) 400px, 92vw'
          }
          class="indice__foto"
          alt=""
        />
        <span class="indice__corpo">
          <span class="indice__titulo">
            <Icone nome={i.icone} tamanho={22} class="indice__icone" />
            {i.titulo}
          </span>
          <span class="indice__texto">{i.texto}</span>
          <span class="indice__seta">
            Saber mais <Icone nome="seta" tamanho={18} />
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .indice {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .indice {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .indice--pilares {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .indice--cartoes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .indice li {
    display: flex;
  }
  .indice__item {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--linha);
    border-radius: var(--raio-l);
    background: #fff;
    color: var(--texto);
    text-decoration: none;
    transition:
      box-shadow var(--transicao),
      transform var(--transicao);
  }
  .indice__item:hover,
  .indice__item:focus-visible {
    box-shadow: var(--sombra);
    transform: translateY(-2px);
  }
  /* A fotografia aproxima-se um pouco ao passar o rato ou com o foco do teclado. */
  .indice :global(.indice__foto img) {
    transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .indice__item:hover :global(.indice__foto img),
  .indice__item:focus-visible :global(.indice__foto img) {
    transform: scale(1.05);
  }
  .indice :global(.indice__foto) {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--cinzento-2);
  }
  .indice :global(.indice__foto img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .indice__corpo {
    display: grid;
    flex: 1;
    grid-template-rows: auto 1fr auto;
    gap: 10px;
    padding: 20px 22px 18px;
  }
  .indice__titulo {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .indice__titulo :global(.indice__icone) {
    flex: none;
    color: var(--dourado-texto);
  }
  .indice__texto {
    font-size: 0.97rem;
    line-height: 1.55;
    color: var(--texto-suave);
  }
  .indice__seta {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    min-height: 40px;
    font-weight: 750;
    color: var(--verde);
  }
  .indice__seta :global(svg) {
    transition: transform var(--transicao);
  }
  .indice__item:hover .indice__seta :global(svg) {
    transform: translateX(4px);
  }
</style>
