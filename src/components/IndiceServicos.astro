---
/**
 * Os quatro pilares do lodge, com o mesmo peso: alojamento, restaurante, piscinas e eventos.
 * Nos cartões, um espaço sem fotografia autorizada mostra um painel tipográfico (nunca uma imagem
 * que não seja do lodge).
 */
import type { IdFotografia } from '../data/fotografias';

import Foto from './Foto.astro';
import Icone, { type NomeIcone } from './Icone.astro';

type Id = 'alojamento' | 'restaurante' | 'piscinas' | 'eventos';

interface Props {
  variante?: 'pilares' | 'cartoes';
  excluir?: Id;
}

const { variante = 'pilares', excluir } = Astro.props;

const itens: {
  id: Id;
  icone: NomeIcone;
  titulo: string;
  texto: string;
  href: string;
  foto?: IdFotografia;
}[] = [
  {
    id: 'alojamento',
    icone: 'cama',
    titulo: 'Alojamento',
    texto: 'Quartos para descansar depois de um dia de lazer, de trabalho ou de celebração.',
    href: '/alojamento/',
  },
  {
    id: 'restaurante',
    icone: 'talheres',
    titulo: 'Restaurante',
    texto: 'Refeições numa sala ampla, com janelas largas sobre a vegetação.',
    href: '/restaurante/',
    foto: 'restaurante-buffet-sala',
  },
  {
    id: 'piscinas',
    icone: 'ondas',
    titulo: 'Piscinas',
    texto: 'Lazer ao ar livre, entre o relvado e o jardim.',
    href: '/piscinas/',
    foto: 'piscina-jardim',
  },
  {
    id: 'eventos',
    icone: 'pessoas',
    titulo: 'Eventos e conferências',
    texto: 'Um espaço para reunir equipas, famílias e amigos.',
    href: '/eventos/',
    foto: 'sala-refeicoes',
  },
];
const lista = itens
  .map((item, i) => ({ ...item, numero: String(i + 1).padStart(2, '0') }))
  .filter((i) => i.id !== excluir);
---

<ul class:list={['indice', `indice--${variante}`]}>
  {lista.map((i) => (
    <li>
      <a class="indice__item" href={i.href}>
        {variante === 'cartoes' &&
          (i.foto ? (
            <Foto id={i.foto} sizes="(min-width: 900px) 400px, 92vw" class="indice__foto" alt="" />
          ) : (
            <span class="indice__foto indice__foto--tipografica" aria-hidden="true">
              <Icone nome={i.icone} tamanho={40} />
              <span>{i.titulo}</span>
            </span>
          ))}
        {variante === 'pilares' && (
          <span class="indice__cabeca" aria-hidden="true">
            <span class="indice__numero">{i.numero}</span>
            <Icone nome={i.icone} tamanho={26} class="indice__icone" />
          </span>
        )}
        <span class="indice__titulo">{i.titulo}</span>
        <span class="indice__texto">{i.texto}</span>
        <span class="indice__seta">
          Saber mais <Icone nome="seta" tamanho={18} />
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .indice {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .indice--pilares {
    border-top: 1px solid var(--linha);
  }
  @media (min-width: 640px) {
    .indice--pilares {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .indice--pilares {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .indice--cartoes {
    gap: 32px;
  }
  @media (min-width: 760px) {
    .indice--cartoes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .indice__item {
    display: grid;
    gap: 12px;
    align-content: start;
    height: 100%;
    padding: 30px 28px 34px 0;
    text-decoration: none;
    color: inherit;
    transition: background-color var(--transicao);
  }
  .indice--pilares li {
    border-bottom: 1px solid var(--linha);
  }
  @media (min-width: 640px) and (max-width: 1099px) {
    .indice--pilares li:nth-child(even) .indice__item {
      padding-left: 28px;
      border-left: 1px solid var(--linha);
    }
  }
  @media (min-width: 1100px) {
    .indice--pilares li + li .indice__item {
      padding-left: 28px;
      border-left: 1px solid var(--linha);
    }
  }
  .indice--cartoes .indice__item {
    padding: 0;
  }
  .indice__cabeca {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .indice__numero {
    font-family: var(--serif);
    font-size: 2.6rem;
    font-style: italic;
    line-height: 1;
    color: var(--dourado-texto);
  }
  .indice :global(.indice__icone) {
    color: var(--dourado-texto);
  }
  .indice :global(.indice__foto) {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--raio);
    margin-bottom: 10px;
    background: var(--cinzento);
  }
  .indice :global(.indice__foto img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .indice__item:hover :global(.indice__foto img) {
    transform: scale(1.04);
  }
  .indice .indice__foto--tipografica {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    background: radial-gradient(circle at 70% 120%, rgb(199 161 90 / 0.22), transparent 60%), var(--verde);
    color: var(--dourado);
    font-family: var(--serif);
    font-size: 1.7rem;
    font-style: italic;
  }
  .indice__titulo {
    font-family: var(--serif);
    font-size: var(--t-h3);
    font-weight: 500;
    line-height: 1.1;
  }
  .indice__texto {
    color: var(--texto-suave);
    font-size: 0.97rem;
  }
  .indice__seta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--verde);
  }
  .indice__seta :global(svg) {
    transition: transform var(--transicao);
  }
  .indice__item:hover .indice__seta :global(svg) {
    transform: translateX(4px);
  }
  .indice__item:hover .indice__titulo {
    color: var(--verde-3);
  }
</style>
