---
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Cenas, { type Cena } from '../components/Cenas.astro';
import Enfase from '../components/Enfase.astro';
import FichaServico from '../components/FichaServico.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import { lodge } from '../config/lodge';
import type { IdFotografia } from '../data/fotografias';
import { linguaDe, rota, traducoes } from '../i18n/linguas';
import Base from '../layouts/Base.astro';

const l = linguaDe(Astro.url);
const t = traducoes(
  {
    tituloPagina: 'Piscina e lazer em Boane',
    descricao:
      'Piscinas, jardins e esplanadas à sombra no Mulotana Lodge, em Boane. Pergunte à equipa as condições de acesso à piscina antes da sua visita.',
    titulo: 'Piscinas e jardins',
    intro: 'Lazer ao ar livre, entre palmeiras, jardins cuidados e esplanadas à sombra das árvores.',
    pergunta: `Olá, ${lodge.nome}! Gostaria de saber as condições de acesso à piscina (horários, regras e preço).`,
    perguntar: 'Perguntar sobre a piscina',
    condicoesLigacao: 'Condições de utilização',
    cenas: [
      {
        etiqueta: 'A piscina',
        titulo: 'Entre palmeiras',
        texto: 'Uma piscina rectangular de água azul-turquesa, junto ao edifício de telhado de colmo.',
      },
      {
        etiqueta: 'O terraço',
        titulo: 'Vista do alto',
        texto: 'Espreguiçadeiras, relvado e um terraço com mesas, entre os edifícios de colmo.',
      },
      {
        etiqueta: 'A esplanada',
        titulo: 'À sombra',
        texto: 'Mesas e cadeiras sob uma árvore grande, ao lado da piscina.',
      },
    ],
    passeioEtiqueta: 'A área de lazer',
    passeioTitulo: 'Piscinas, jardins e *sombra.*',
    passeioRotulo: 'Área de lazer',
    jardinsEtiqueta: 'Os jardins',
    jardinsTitulo: 'Água, verde e *tempo livre.*',
    jardinsTexto:
      'Uma piscina de forma irregular entre arbustos podados, outra com parede de água, decks com espreguiçadeiras e mesas à sombra das árvores.',
    galeria: 'Ver a galeria completa',
    tira: 'Mais fotografias da área de lazer',
    legendas: ['Piscina à sombra das árvores.', 'Espreguiçadeiras e chapéus-de-sol.', 'Piscina e relvado.'],
    condicoesEtiqueta: 'Antes da visita',
    condicoesTitulo: 'Condições de *utilização.*',
    condicoesTexto:
      'Os horários, as regras de utilização, o acesso de visitantes não alojados e o preço de entrada não estão publicados. Pergunte à equipa antes da sua visita.',
    contactos: 'Outros contactos',
    resumo: 'A piscina em resumo',
    explorarEtiqueta: 'Continue a explorar',
    explorarTitulo: 'Mais para descobrir no lodge.',
  },
  {
    tituloPagina: 'Pools and leisure in Boane',
    descricao:
      'Pools, gardens and shady terraces at Mulotana Lodge, in Boane. Ask the team about the conditions for using the pool before your visit.',
    titulo: 'Pools and gardens',
    intro: 'Outdoor leisure among palm trees, well-kept gardens and terraces in the shade of the trees.',
    pergunta: `Hello, ${lodge.nome}! I would like to know the conditions for using the pool (opening hours, rules and price).`,
    perguntar: 'Ask about the pool',
    condicoesLigacao: 'Conditions of use',
    cenas: [
      {
        etiqueta: 'The pool',
        titulo: 'Among palm trees',
        texto: 'A rectangular pool with turquoise water, next to the thatched-roof building.',
      },
      {
        etiqueta: 'The terrace',
        titulo: 'View from above',
        texto: 'Sun loungers, a lawn and a terrace with tables, between the thatched buildings.',
      },
      {
        etiqueta: 'The outdoor terrace',
        titulo: 'In the shade',
        texto: 'Tables and chairs under a large tree, beside the pool.',
      },
    ],
    passeioEtiqueta: 'The leisure area',
    passeioTitulo: 'Pools, gardens and *shade.*',
    passeioRotulo: 'Leisure area',
    jardinsEtiqueta: 'The gardens',
    jardinsTitulo: 'Water, greenery and *free time.*',
    jardinsTexto:
      'An irregularly shaped pool among clipped shrubs, another with a water wall, decks with sun loungers and tables in the shade of the trees.',
    galeria: 'See the full gallery',
    tira: 'More photos of the leisure area',
    legendas: ['Pool in the shade of the trees.', 'Sun loungers and parasols.', 'Pool and lawn.'],
    condicoesEtiqueta: 'Before your visit',
    condicoesTitulo: 'Conditions of *use.*',
    condicoesTexto:
      'Opening hours, pool rules, access for non-resident guests and the entry fee have not been published. Ask the team before your visit.',
    contactos: 'Other contact details',
    resumo: 'The pool at a glance',
    explorarEtiqueta: 'Keep exploring',
    explorarTitulo: 'More to discover at the lodge.',
  },
)[l];

// Passeio pela área de lazer (palco compacto): só o que se vê em cada fotografia.
const cenas: Cena[] = (
  [
    { id: 'piscina', foto: 'piscina-palmeiras' },
    { id: 'terraco', foto: 'vista-piscina-esplanada' },
    { id: 'esplanada', foto: 'esplanada-arvore' },
  ] as const
).map((c, i) => ({ ...c, ...t.cenas[i] }));
const tira: IdFotografia[] = ['piscina-sombra', 'piscina-espreguicadeiras', 'piscina-jardim'];
---

<Base titulo={t.tituloPagina} descricao={t.descricao}>
  <CabecalhoPagina titulo={t.titulo} intro={t.intro} foto="piscina-topiaria">
    <BotaoWhatsApp slot="accoes" texto={t.perguntar} variante="principal" mensagem={t.pergunta} />
    <a slot="accoes" class="ligacao-seta" href="#condicoes">
      <span>{t.condicoesLigacao}</span>
      <Icone nome="seta" tamanho={18} />
    </a>
  </CabecalhoPagina>

  <section class="secao secao--escura passeio" aria-labelledby="passeio-titulo">
    <div class="contentor passeio__intro">
      <p class="etiqueta c-revelar">{t.passeioEtiqueta}</p>
      <h2 id="passeio-titulo" class="c-titulo">
        <Enfase texto={t.passeioTitulo} />
      </h2>
    </div>
    <Cenas id="lazer" cenas={cenas} variante="compacta" rotulo={t.passeioRotulo} />
  </section>

  <!-- Camadas: fotografias sobrepostas que sobem a velocidades diferentes. -->
  <section class="secao secao--clara camadas" aria-labelledby="camadas-titulo">
    <div class="contentor camadas__grelha">
      <div class="bloco-titulo camadas__texto">
        <p class="etiqueta c-revelar">{t.jardinsEtiqueta}</p>
        <h2 id="camadas-titulo" class="c-titulo">
          <Enfase texto={t.jardinsTitulo} />
        </h2>
        <div class="texto c-revelar">
          <p>{t.jardinsTexto}</p>
        </div>
        <a class="ligacao-seta c-revelar" href={rota(l, '/galeria/')}>
          <span>{t.galeria}</span>
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>
      <figure class="camadas__a c-paralaxe">
        <Foto id="piscina-cascata" sizes="(min-width: 900px) 740px, 92vw" class="foto" />
      </figure>
      <figure class="camadas__b c-flutuar">
        <Foto id="piscina-deck" sizes="(min-width: 900px) 300px, 46vw" class="foto" />
      </figure>
      <figure class="camadas__c c-flutuar">
        <Foto id="mesas-sombra" sizes="(min-width: 900px) 300px, 46vw" class="foto" />
      </figure>
    </div>
    <ul class="contentor tira c-cartoes" aria-label={t.tira}>
      {tira.map((foto, i) => (
        <li>
          <Foto id={foto} sizes="(min-width: 900px) 400px, (min-width: 640px) 30vw, 92vw" class="foto" />
          <span class="legenda">{t.legendas[i]}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="condicoes" class="secao secao--cinza condicoes" aria-labelledby="condicoes-titulo">
    <div class="contentor grelha grelha--metades">
      <div class="bloco-titulo">
        <p class="etiqueta c-revelar">{t.condicoesEtiqueta}</p>
        <h2 id="condicoes-titulo" class="c-titulo">
          <Enfase texto={t.condicoesTitulo} />
        </h2>
        <div class="texto">
          <p>{t.condicoesTexto}</p>
        </div>
        <div class="accoes">
          <BotaoWhatsApp texto={t.perguntar} variante="principal" mensagem={t.pergunta} />
          <a class="botao botao--contorno" href={rota(l, '/contactos/')}>
            {t.contactos}
          </a>
        </div>
      </div>
      <FichaServico servico="piscinas" titulo={t.resumo} tom="clara" />
    </div>
  </section>

  <section class="secao secao--clara" aria-labelledby="explorar-titulo">
    <div class="contentor">
      <p class="etiqueta c-revelar">{t.explorarEtiqueta}</p>
      <h2 id="explorar-titulo" class="explorar__titulo c-titulo">
        {t.explorarTitulo}
      </h2>
      <IndiceServicos variante="cartoes" excluir="piscinas" />
    </div>
  </section>
</Base>

<style>
  .passeio {
    padding-bottom: 0;
  }
  .passeio__intro {
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  @media (max-width: 899px) {
    .passeio {
      padding-bottom: var(--espaco-secao);
    }
  }
  .camadas__grelha {
    display: grid;
    gap: 24px;
  }
  .camadas figure {
    margin: 0;
  }
  .camadas :global(.foto) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .camadas__b,
  .camadas__c {
    display: none;
  }
  /* Computador: fotografia grande à direita e duas mais pequenas à frente, a subir a outra velocidade. */
  @media (min-width: 900px) {
    .camadas__grelha {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto auto;
      gap: 0 clamp(40px, 5vw, 80px);
      align-items: start;
      padding-bottom: 120px;
    }
    .camadas__texto {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
    }
    .camadas__a {
      position: relative;
      grid-column: 2;
      grid-row: 1 / span 2;
      border-radius: var(--raio-l);
    }
    .camadas__a :global(.foto) {
      aspect-ratio: 4 / 5;
    }
    .camadas__b,
    .camadas__c {
      display: block;
      width: 46%;
      border: 6px solid var(--branco);
      border-radius: var(--raio-l);
      box-shadow: var(--sombra);
    }
    .camadas__b {
      --c-flutuar: 70px;
      grid-column: 1;
      grid-row: 2;
      justify-self: end;
      margin-top: 32px;
      margin-right: -12%;
      position: relative;
      z-index: 1;
    }
    .camadas__c {
      --c-flutuar: 40px;
      grid-column: 1;
      grid-row: 2;
      margin-top: 140px;
    }
  }
  .tira {
    display: grid;
    gap: 20px;
    margin: clamp(40px, 6vw, 80px) auto 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .tira {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .tira li {
    display: grid;
    gap: 2px;
    align-content: start;
  }
  .tira :global(.foto) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .condicoes .grelha {
    align-items: start;
  }
  .condicoes {
    scroll-margin-top: var(--cabecalho);
  }
  .explorar__titulo {
    margin-bottom: clamp(32px, 4vw, 48px);
  }
</style>
