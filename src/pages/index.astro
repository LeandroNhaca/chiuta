---
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import ComoChegar from '../components/ComoChegar.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import QuartosLista from '../components/QuartosLista.astro';
import SecaoPedidos from '../components/SecaoPedidos.astro';
import { lodge } from '../config/lodge';
import Base from '../layouts/Base.astro';
import { dadosLodge } from '../lib/dados-estruturados';

const site = Astro.site?.href ?? lodge.site.urlDemonstracao;
const salas = lodge.detalhes.eventos.find((d) => d.rotulo === 'Salas de conferências');
const exterior = lodge.detalhes.eventos.find((d) => d.rotulo === 'Eventos ao ar livre');
// Capacidades das salas tal como o lodge as publicou (src/config/lodge.ts → detalhes.eventos).
const capacidades = salas?.valor.match(/\d+/g) ?? [];
---

<Base
  inicio
  titulo="Mulotana Lodge · Alojamento, conferências e piscina em Boane"
  descricao="Alojamento, salas de conferências, restaurante e piscina em Boane, província de Maputo. Consulte a disponibilidade ou peça um orçamento para o seu evento."
  dadosEstruturados={dadosLodge(site)}
>
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="contentor hero__grelha">
      <div class="hero__texto">
        <p class="etiqueta">Boane · Província de Maputo</p>
        <h1 id="hero-titulo">{lodge.nome}</h1>
        <p class="hero__subtitulo">
          O seu espaço para descansar, <em>celebrar e reunir.</em>
        </p>
        <p class="hero__apoio">
          Descubra um espaço em Boane dedicado ao alojamento, ao lazer e à realização de eventos. Consulte a
          disponibilidade e fale directamente com a nossa equipa.
        </p>
        <div class="accoes hero__accoes">
          <a class="botao botao--principal" href="#disponibilidade">
            Consultar disponibilidade
            <Icone nome="seta" tamanho={18} />
          </a>
          <a class="botao botao--verde" href="#orcamento">
            Pedir orçamento para um evento
          </a>
          <a class="ligacao-seta" href="#o-lodge">
            <span>Explorar o lodge</span>
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <figure class="hero__figura">
        <Foto
          id="piscina-palmeiras"
          prioridade
          sizes="(min-width: 1240px) 600px, (min-width: 900px) 48vw, 100vw"
          class="foto hero__foto"
        />
        <figcaption class="hero__legenda">
          <Icone nome="ondas" tamanho={16} />A piscina e o edifício de colmo
        </figcaption>
      </figure>
    </div>
  </section>

  <section id="o-lodge" class="secao secao--cinza apresentacao" aria-labelledby="apresentacao-titulo">
    <div class="contentor">
      <div class="apresentacao__topo">
        <div class="bloco-titulo">
          <p class="etiqueta">O lodge</p>
          <h2 id="apresentacao-titulo">
            Alojamento, conferências e lazer <em>em Boane.</em>
          </h2>
        </div>
        <div class="texto apresentacao__texto">
          <p>
            Entre a localidade de Mulotana e as margens do rio Matola, o {lodge.nome} reúne quartos para
            descansar, salas de conferências, um restaurante e uma área de lazer com piscina e jardins.
          </p>
          <a class="ligacao-seta" href="/galeria/">
            <span>Ver todas as fotografias</span>
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <IndiceServicos />
    </div>
  </section>

  <section class="secao secao--escura eventos" aria-labelledby="eventos-titulo">
    <div class="contentor grelha grelha--texto-foto eventos__grelha">
      <div class="bloco-titulo">
        <p class="etiqueta">Conferências e eventos</p>
        <h2 id="eventos-titulo">
          Salas para reunir, espaço para <em>celebrar.</em>
        </h2>
        <div class="texto">
          <p>
            Reuniões de empresa, formações, conferências, encontros de grupo e celebrações. Indique a data, o
            número de participantes e o que precisa: a equipa prepara o orçamento e confirma a sala.
          </p>
        </div>
        {capacidades.length > 0 && (
          <div class="capacidades">
            <ul class="capacidades__lista" aria-label="Capacidade das salas de conferências">
              {capacidades.map((n) => (
                <li>
                  <span class="capacidades__numero">{n}</span>
                  <span class="capacidades__texto">pessoas</span>
                </li>
              ))}
            </ul>
            {exterior?.valor && <p class="capacidades__exterior">{exterior.valor}.</p>}
            <p class="capacidades__nota">
              {salas?.valor}: capacidades publicadas pelo lodge ({salas?.aValidar}). A equipa confirma a sala
              e a montagem para o seu evento.
            </p>
          </div>
        )}
        <div class="accoes">
          <a class="botao botao--principal" href="#orcamento">
            Pedir orçamento para um evento
            <Icone nome="seta" tamanho={18} />
          </a>
          <a class="ligacao-seta" href="/eventos/">
            <span>Conhecer as salas</span>
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <div class="eventos__fotos">
        <Foto
          id="sala-conferencias-plateia"
          sizes="(min-width: 900px) 560px, 92vw"
          class="foto eventos__principal"
        />
        <Foto
          id="sala-conferencias-palco"
          sizes="(min-width: 900px) 260px, 45vw"
          class="foto eventos__detalhe"
        />
      </div>
    </div>
  </section>

  <section class="secao secao--clara alojamento" aria-labelledby="alojamento-titulo">
    <div class="contentor">
      <div class="alojamento__topo">
        <div class="bloco-titulo">
          <p class="etiqueta">Alojamento</p>
          <h2 id="alojamento-titulo">
            Quartos para <em>descansar.</em>
          </h2>
        </div>
        <div class="texto">
          <p>
            Para uma noite, um fim de semana ou um grupo inteiro. Escolha o tipo de quarto e consulte a
            disponibilidade: a equipa confirma o preço actual e as condições da estadia.
          </p>
          <a class="ligacao-seta" href="/alojamento/">
            <span>Ver o alojamento</span>
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <ul class="alojamento__fotos" aria-label="Fotografias de quartos" tabindex="0">
        <li>
          <Foto id="quarto-cadeirao" sizes="(min-width: 760px) 400px, 80vw" class="foto" />
        </li>
        <li>
          <Foto id="quarto-duas-camas" sizes="(min-width: 760px) 400px, 80vw" class="foto" />
        </li>
        <li>
          <Foto id="quarto-cama-redonda" sizes="(min-width: 760px) 400px, 80vw" class="foto" />
        </li>
      </ul>
      <QuartosLista />
    </div>
  </section>

  <section class="secao secao--cinza piscinas" aria-labelledby="piscinas-titulo">
    <div class="contentor grelha grelha--foto-texto">
      <div class="piscinas__fotos">
        <Foto id="piscina-topiaria" sizes="(min-width: 900px) 600px, 92vw" class="foto piscinas__principal" />
        <Foto id="piscina-cascata" sizes="(min-width: 900px) 300px, 45vw" class="foto piscinas__a" />
        <Foto id="mesas-sombra" sizes="(min-width: 900px) 300px, 45vw" class="foto piscinas__b" />
      </div>
      <div class="bloco-titulo">
        <p class="etiqueta">Piscinas e jardins</p>
        <h2 id="piscinas-titulo">
          Lazer ao ar livre, <em>à sombra das árvores.</em>
        </h2>
        <div class="texto">
          <p>
            Piscinas rodeadas de palmeiras e jardins cuidados, esplanadas à sombra e espaço para passar o dia.
          </p>
          <p>
            Quer saber as condições de acesso, os horários ou se a piscina está aberta a visitantes não
            alojados? Pergunte directamente à equipa.
          </p>
        </div>
        <div class="accoes">
          <BotaoWhatsApp
            texto="Perguntar sobre a piscina"
            variante="principal"
            mensagem={`Olá, ${lodge.nome}! Gostaria de saber as condições de acesso à piscina (horários, regras e preço).`}
          />
          <a class="ligacao-seta" href="/piscinas/">
            <span>Piscinas e jardins</span>
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="secao secao--clara restaurante" aria-labelledby="restaurante-titulo">
    <div class="contentor grelha grelha--texto-foto">
      <div class="bloco-titulo">
        <p class="etiqueta">Restaurante</p>
        <h2 id="restaurante-titulo">
          Refeições com vista <em>para o jardim.</em>
        </h2>
        <div class="texto">
          <p>
            Uma sala de refeições ampla, com janelas largas e espaço para os buffets de grupos e eventos. O
            menu, os horários e as refeições para grupos são indicados pela equipa do lodge.
          </p>
        </div>
        <div class="accoes">
          <a class="botao botao--contorno" href="/restaurante/">
            Conhecer o restaurante
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <div class="restaurante__fotos">
        <Foto
          id="sala-refeicoes-bar"
          sizes="(min-width: 900px) 600px, 92vw"
          class="foto restaurante__principal"
        />
        <Foto
          id="restaurante-buffet"
          sizes="(min-width: 900px) 240px, 40vw"
          class="foto restaurante__detalhe"
        />
      </div>
    </div>
  </section>

  <SecaoPedidos />

  <ComoChegar />
</Base>

<style>
  /* ---------- Hero ----------
     Telemóvel: texto e, por baixo, a fotografia. Computador: texto à esquerda e a fotografia à direita. */
  .hero {
    padding-block: clamp(24px, 4vw, 56px) clamp(48px, 6vw, 88px);
    background: var(--branco);
  }
  .hero__grelha {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero__grelha {
      grid-template-columns: minmax(0, 11fr) minmax(0, 10fr);
    }
  }
  .hero__texto {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .hero__texto .etiqueta {
    margin-bottom: 0;
  }
  .hero h1 {
    font-size: var(--t-hero);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .hero__subtitulo {
    max-width: 18em;
    font-size: clamp(1.4rem, 1.15rem + 1.1vw, 2.1rem);
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .hero__subtitulo em {
    font-style: normal;
    color: var(--dourado-texto);
  }
  .hero__apoio {
    max-width: 34em;
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--texto-suave);
  }
  .hero__accoes {
    margin-top: 8px;
  }
  @media (max-width: 559px) {
    .hero__accoes .botao {
      width: 100%;
    }
  }
  .hero__figura {
    position: relative;
    margin: 0;
  }
  .hero :global(.hero__foto) {
    display: block;
    aspect-ratio: 9 / 8;
    box-shadow: var(--sombra);
  }
  .hero__legenda {
    position: absolute;
    left: 14px;
    bottom: 14px;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgb(250 248 243 / 0.94);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--texto);
  }
  .hero__legenda :global(svg) {
    color: var(--dourado-texto);
  }

  /* ---------- Apresentação e alojamento ---------- */
  .apresentacao__topo,
  .alojamento__topo {
    display: grid;
    gap: 20px 64px;
    align-items: end;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  @media (min-width: 900px) {
    .apresentacao__topo,
    .alojamento__topo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .apresentacao__texto,
  .alojamento__topo .texto {
    justify-items: start;
  }

  /* ---------- Eventos ---------- */
  .eventos__grelha {
    align-items: start;
  }
  .capacidades {
    display: grid;
    gap: 12px;
  }
  .capacidades__lista {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .capacidades__lista li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 16px 14px;
    border: 1px solid var(--linha-clara);
    border-radius: var(--raio-m);
    background: rgb(250 248 243 / 0.05);
  }
  .capacidades__numero {
    font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.8rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--dourado);
  }
  .capacidades__texto {
    font-size: 0.85rem;
    line-height: 1.35;
    color: rgb(250 248 243 / 0.86);
  }
  .capacidades__exterior {
    font-weight: 700;
  }
  .capacidades__nota {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(250 248 243 / 0.72);
  }
  .eventos__fotos {
    position: relative;
    display: grid;
    gap: 14px;
  }
  .eventos :global(.eventos__principal) {
    display: block;
    aspect-ratio: 1 / 1;
  }
  .eventos :global(.eventos__detalhe) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 900px) {
    .eventos__fotos {
      padding-bottom: 72px;
    }
    .eventos :global(.eventos__detalhe) {
      position: absolute;
      left: -32px;
      bottom: 0;
      width: 46%;
      border: 6px solid var(--verde);
    }
  }

  /* ---------- Alojamento ---------- */
  .alojamento__fotos {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 80%);
    gap: 14px;
    margin: 0 0 clamp(28px, 4vw, 44px);
    padding: 0 0 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    list-style: none;
  }
  .alojamento__fotos li {
    scroll-snap-align: start;
  }
  .alojamento__fotos :global(.foto) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 760px) {
    .alojamento__fotos {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
    }
  }

  /* ---------- Piscinas ---------- */
  .piscinas__fotos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .piscinas :global(.piscinas__principal) {
    display: block;
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3;
  }
  .piscinas :global(.piscinas__a),
  .piscinas :global(.piscinas__b) {
    display: block;
    aspect-ratio: 1 / 1;
  }

  /* ---------- Restaurante ---------- */
  .restaurante__fotos {
    position: relative;
  }
  .restaurante :global(.restaurante__principal) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .restaurante :global(.restaurante__detalhe) {
    display: none;
  }
  @media (min-width: 900px) {
    .restaurante__fotos {
      padding: 0 0 56px 56px;
    }
    .restaurante :global(.restaurante__detalhe) {
      position: absolute;
      left: 0;
      bottom: 0;
      display: block;
      width: 34%;
      aspect-ratio: 3 / 4;
      border: 6px solid var(--branco);
    }
  }
</style>
