---
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import Cenas, { type Cena } from '../components/Cenas.astro';
import ComoChegar from '../components/ComoChegar.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import QuartosLista from '../components/QuartosLista.astro';
import SecaoPedidos from '../components/SecaoPedidos.astro';
import { lodge } from '../config/lodge';
import Base from '../layouts/Base.astro';
import { dadosLodge } from '../lib/dados-estruturados';

const site = Astro.site?.href ?? lodge.site.urlDemonstracao;
const salas = lodge.detalhes.eventos.find((d) => d.rotulo === 'Salas de conferências');
const exterior = lodge.detalhes.eventos.find((d) => d.rotulo === 'Eventos ao ar livre');
// Capacidades das salas tal como o lodge as publicou (src/config/lodge.ts → detalhes.eventos).
const capacidades = salas?.valor.match(/\d+/g) ?? [];

const cenas: Cena[] = [
  {
    id: 'alojamento',
    etiqueta: 'Alojamento',
    titulo: 'Quartos para descansar',
    texto:
      'Para uma noite, um fim de semana ou um grupo inteiro, depois de um dia de lazer, de trabalho ou de celebração.',
    foto: 'quarto-cadeirao',
    detalhe: 'quarto-cama-redonda',
    ligacao: { href: '/alojamento/', texto: 'Ver o alojamento' },
  },
  {
    id: 'conferencias',
    etiqueta: 'Conferências',
    titulo: 'Salas para reunir',
    texto: salas?.valor
      ? `${salas.valor}, segundo o lodge: reuniões, formações, conferências e encontros de grupo.`
      : 'Reuniões, formações, conferências e encontros de grupo.',
    foto: 'sala-conferencias-plateia',
    detalhe: 'sala-conferencias-u',
    ligacao: { href: '/eventos/', texto: 'Conhecer as salas' },
  },
  {
    id: 'piscinas',
    etiqueta: 'Piscinas e jardins',
    titulo: 'Lazer ao ar livre',
    texto: 'Piscinas entre palmeiras e jardins cuidados, com esplanadas à sombra das árvores.',
    foto: 'piscina-topiaria',
    detalhe: 'piscina-cascata',
    ligacao: { href: '/piscinas/', texto: 'Piscinas e jardins' },
  },
  {
    id: 'restaurante',
    etiqueta: 'Restaurante',
    titulo: 'À mesa',
    texto: 'Uma sala ampla, com janelas a toda a volta, e buffets para grupos e eventos.',
    foto: 'restaurante-janelas',
    detalhe: 'restaurante-buffet',
    ligacao: { href: '/restaurante/', texto: 'Conhecer o restaurante' },
  },
];
---

<Base
  inicio
  titulo="Mulotana Lodge · Alojamento, conferências e piscina em Boane"
  descricao="Alojamento, salas de conferências, restaurante e piscina em Boane, província de Maputo. Consulte a disponibilidade ou peça um orçamento para o seu evento."
  dadosEstruturados={dadosLodge(site)}
>
  <!-- Abertura: a fotografia ocupa o ecrã; ao descer, o texto sai mais depressa do que a imagem. -->
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="hero__fundo">
      <Foto id="piscina-palmeiras" prioridade sizes="100vw" class="hero__foto" />
    </div>
    <div class="contentor hero__texto">
      <p class="etiqueta etiqueta--clara hero__entrar">Boane · Província de Maputo</p>
      <h1 id="hero-titulo" class="hero__entrar">
        {lodge.nome}
      </h1>
      <p class="hero__subtitulo hero__entrar">
        O seu espaço para descansar, <em>celebrar e reunir.</em>
      </p>
      <p class="hero__apoio hero__entrar">
        Descubra um espaço em Boane dedicado ao alojamento, ao lazer e à realização de eventos. Consulte a
        disponibilidade e fale directamente com a nossa equipa.
      </p>
      <div class="accoes hero__accoes hero__entrar">
        <a class="botao botao--principal" href="#disponibilidade">
          Consultar disponibilidade
          <Icone nome="seta" tamanho={18} />
        </a>
        <a class="botao botao--contorno-claro" href="#orcamento">
          Pedir orçamento para um evento
        </a>
        <a class="ligacao-seta hero__explorar" href="#o-lodge">
          <span>Explorar o lodge</span>
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>
    </div>
    <p class="hero__legenda">
      <Icone nome="ondas" tamanho={16} />A piscina e o edifício de colmo
    </p>
  </section>

  <section id="o-lodge" class="secao secao--cinza apresentacao" aria-labelledby="apresentacao-titulo">
    <div class="contentor">
      <div class="apresentacao__topo">
        <div class="bloco-titulo">
          <p class="etiqueta c-revelar">O lodge</p>
          <h2 id="apresentacao-titulo" class="c-titulo">
            Alojamento, conferências e lazer <em>em Boane.</em>
          </h2>
        </div>
        <div class="texto apresentacao__texto c-revelar">
          <p>
            Entre a localidade de Mulotana e as margens do rio Matola, o {lodge.nome} reúne quartos para
            descansar, salas de conferências, um restaurante e uma área de lazer com piscina e jardins.
          </p>
          <a class="ligacao-seta" href="/galeria/">
            <span>Ver todas as fotografias</span>
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <IndiceServicos />
    </div>
  </section>

  <!-- O palco de cenas: preso ao ecrã no computador; lista de cenas no telemóvel. -->
  <section class="secao secao--escura experiencia" aria-labelledby="experiencia-titulo">
    <div class="contentor experiencia__intro">
      <p class="etiqueta c-revelar">Conhecer o lodge</p>
      <h2 id="experiencia-titulo" class="c-titulo">
        Quatro espaços, <em>um só lugar.</em>
      </h2>
    </div>
    <Cenas id="cena" cenas={cenas} rotulo="Espaços do lodge" />
  </section>

  <section class="secao secao--clara eventos" aria-labelledby="eventos-titulo">
    <div class="contentor grelha grelha--texto-foto eventos__grelha">
      <div class="bloco-titulo">
        <p class="etiqueta c-revelar">Conferências e eventos</p>
        <h2 id="eventos-titulo" class="c-titulo">
          Salas para reunir, espaço para <em>celebrar.</em>
        </h2>
        <div class="texto c-revelar">
          <p>
            Reuniões de empresa, formações, conferências, encontros de grupo e celebrações. Indique a data, o
            número de participantes e o que precisa: a equipa prepara o orçamento e confirma a sala.
          </p>
        </div>
        {capacidades.length > 0 && (
          <div class="capacidades">
            <ul class="capacidades__lista c-cartoes" aria-label="Capacidade das salas de conferências">
              {capacidades.map((n) => (
                <li>
                  <span class="capacidades__numero">{n}</span>
                  <span class="capacidades__texto">pessoas</span>
                </li>
              ))}
            </ul>
            {exterior?.valor && <p class="capacidades__exterior">{exterior.valor}.</p>}
            <p class="capacidades__nota">
              {salas?.valor}: capacidades publicadas pelo lodge ({salas?.aValidar}). A equipa confirma a sala
              e a montagem para o seu evento.
            </p>
          </div>
        )}
        <div class="accoes c-revelar">
          <a class="botao botao--principal" href="#orcamento">
            Pedir orçamento para um evento
            <Icone nome="seta" tamanho={18} />
          </a>
          <a class="ligacao-seta" href="/eventos/">
            <span>Conhecer as salas</span>
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <div class="eventos__fotos">
        <Foto
          id="sala-conferencias-palco"
          sizes="(min-width: 900px) 600px, 92vw"
          class="foto eventos__principal c-paralaxe"
        />
        <Foto id="buffet-evento" sizes="(min-width: 900px) 280px, 45vw" class="foto eventos__detalhe" />
      </div>
    </div>
  </section>

  <section class="secao secao--cinza alojamento" aria-labelledby="alojamento-titulo">
    <div class="contentor">
      <div class="alojamento__topo">
        <div class="bloco-titulo">
          <p class="etiqueta c-revelar">Alojamento</p>
          <h2 id="alojamento-titulo" class="c-titulo">
            Quartos para <em>descansar.</em>
          </h2>
        </div>
        <div class="texto c-revelar">
          <p>
            Escolha o tipo de quarto e consulte a disponibilidade: a equipa confirma o preço actual e as
            condições da estadia.
          </p>
          <a class="ligacao-seta" href="/alojamento/">
            <span>Ver o alojamento</span>
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <ul class="alojamento__fotos" aria-label="Fotografias de quartos" tabindex="0">
        <li class="c-cortina">
          <Foto id="quarto-duas-camas" sizes="(min-width: 760px) 400px, 80vw" class="foto" />
        </li>
        <li class="c-cortina">
          <Foto id="quarto-poltronas" sizes="(min-width: 760px) 400px, 80vw" class="foto" />
        </li>
        <li class="c-cortina">
          <Foto id="quarto-casal" sizes="(min-width: 760px) 400px, 80vw" class="foto" />
        </li>
      </ul>
      <QuartosLista />
    </div>
  </section>

  <!-- Faixa da piscina em grande formato, com parallax suave. -->
  <section class="faixa" aria-labelledby="piscinas-titulo">
    <div class="faixa__fundo c-paralaxe">
      <Foto id="vista-piscina-esplanada" sizes="100vw" class="faixa__foto" />
    </div>
    <div class="contentor faixa__conteudo">
      <div class="faixa__cartao c-revelar">
        <p class="etiqueta">Piscinas e jardins</p>
        <h2 id="piscinas-titulo">
          Um dia à beira da <em>piscina.</em>
        </h2>
        <p>
          Quer saber as condições de acesso, os horários ou se a piscina está aberta a visitantes não
          alojados? Pergunte directamente à equipa.
        </p>
        <div class="accoes">
          <BotaoWhatsApp
            texto="Perguntar sobre a piscina"
            variante="principal"
            mensagem={`Olá, ${lodge.nome}! Gostaria de saber as condições de acesso à piscina (horários, regras e preço).`}
          />
          <a class="ligacao-seta" href="/piscinas/">
            <span>Piscinas e jardins</span>
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <SecaoPedidos />

  <ComoChegar />
</Base>

<style>
  /* ---------- Abertura ---------- */
  .hero {
    --foco: var(--dourado);
    position: relative;
    display: grid;
    align-items: end;
    min-height: calc(100svh - var(--cabecalho));
    overflow: hidden;
    background: var(--verde-profundo);
    color: var(--branco);
    isolation: isolate;
  }
  .hero__fundo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero :global(.hero__foto) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero :global(.hero__foto img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }
  /* Véu: escurece a base e a esquerda, onde está o texto. */
  .hero__fundo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(5 22 18 / 0.88) 0%, rgb(5 22 18 / 0.5) 45%, rgb(5 22 18 / 0.1) 80%),
      linear-gradient(to right, rgb(5 22 18 / 0.55), rgb(5 22 18 / 0) 65%);
  }
  .hero__texto {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding-block: clamp(96px, 16vh, 180px) clamp(56px, 9vh, 96px);
  }
  .hero__texto .etiqueta {
    margin-bottom: 0;
  }
  .hero h1 {
    font-size: var(--t-hero);
    line-height: 0.95;
    letter-spacing: -0.015em;
  }
  .hero__subtitulo {
    max-width: 18em;
    font-family: var(--serif);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem);
    font-weight: 500;
    line-height: 1.12;
    text-wrap: balance;
  }
  .hero__subtitulo em {
    color: var(--dourado-claro);
  }
  .hero__apoio {
    max-width: 36em;
    font-size: var(--t-lead);
    line-height: 1.6;
    color: rgb(250 248 243 / 0.88);
  }
  .hero__accoes {
    margin-top: 10px;
  }
  .hero__explorar {
    color: var(--branco);
  }
  @media (max-width: 559px) {
    .hero__accoes .botao {
      width: 100%;
    }
  }
  .hero__legenda {
    position: absolute;
    right: var(--margem);
    bottom: 20px;
    display: none;
    gap: 8px;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgb(250 248 243 / 0.8);
  }
  @media (min-width: 900px) {
    .hero__legenda {
      display: inline-flex;
    }
  }

  /* Chegada (uma só vez, por tempo): a fotografia afasta-se devagar e o texto sobe em sequência. Só a
     imagem muda de escala, nunca de opacidade, para não atrasar a pintura principal (LCP). */
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero__foto) {
      animation: hero-afastar 2.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero__entrar {
      animation: hero-chegar 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero__entrar:nth-child(2) {
      animation-delay: 0.1s;
    }
    .hero__entrar:nth-child(3) {
      animation-delay: 0.22s;
    }
    .hero__entrar:nth-child(4) {
      animation-delay: 0.34s;
    }
    .hero__entrar:nth-child(5) {
      animation-delay: 0.46s;
    }
    /* Ao descer: a fotografia desce devagar e o texto sobe e desvanece mais depressa (camadas). */
    @supports (animation-timeline: view()) {
      .hero :global(.hero__foto img) {
        animation: hero-paralaxe linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      .hero__texto {
        animation: hero-sair linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 70%;
      }
    }
  }
  @keyframes hero-afastar {
    from {
      transform: scale(1.08);
    }
    to {
      transform: none;
    }
  }
  @keyframes hero-chegar {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-paralaxe {
    to {
      transform: translateY(18%);
    }
  }
  @keyframes hero-sair {
    to {
      opacity: 0;
      transform: translateY(-80px);
    }
  }

  /* ---------- Apresentação e alojamento ---------- */
  .apresentacao__topo,
  .alojamento__topo {
    display: grid;
    gap: 20px 64px;
    align-items: end;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  @media (min-width: 900px) {
    .apresentacao__topo,
    .alojamento__topo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .apresentacao__texto,
  .alojamento__topo .texto {
    justify-items: start;
  }

  /* ---------- Palco de cenas ---------- */
  .experiencia {
    padding-bottom: 0;
  }
  .experiencia__intro {
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  @media (max-width: 899px) {
    .experiencia {
      padding-bottom: var(--espaco-secao);
    }
  }

  /* ---------- Eventos ---------- */
  .eventos__grelha {
    align-items: start;
  }
  .capacidades {
    display: grid;
    gap: 12px;
  }
  .capacidades__lista {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .capacidades__lista li {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 16px 14px;
    border: 1px solid var(--linha);
    border-radius: var(--raio-m);
    background: #fff;
  }
  .capacidades__numero {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 1.7rem + 1.8vw, 3.2rem);
    font-weight: 600;
    line-height: 1;
    color: var(--verde);
  }
  .capacidades__texto {
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--texto-suave);
  }
  .capacidades__exterior {
    font-weight: 700;
  }
  .capacidades__nota {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--texto-suave);
  }
  .eventos__fotos {
    position: relative;
    display: grid;
    gap: 14px;
  }
  .eventos :global(.eventos__principal) {
    display: block;
    aspect-ratio: 1 / 1;
  }
  .eventos :global(.eventos__detalhe) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 900px) {
    .eventos__fotos {
      padding-bottom: 72px;
    }
    .eventos :global(.eventos__detalhe) {
      position: absolute;
      left: -32px;
      bottom: 0;
      width: 46%;
      border: 6px solid var(--branco);
    }
  }

  /* ---------- Alojamento ---------- */
  .alojamento {
    --c-cortina: var(--cinzento);
  }
  .alojamento__fotos {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 80%);
    gap: 14px;
    margin: 0 0 clamp(28px, 4vw, 44px);
    padding: 0 0 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    list-style: none;
  }
  .alojamento__fotos li {
    overflow: hidden;
    border-radius: var(--raio-l);
    scroll-snap-align: start;
  }
  .alojamento__fotos :global(.foto) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 760px) {
    .alojamento__fotos {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
    }
  }

  /* ---------- Faixa da piscina ---------- */
  .faixa {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(88svh, 760px);
    overflow: hidden;
    isolation: isolate;
  }
  .faixa__fundo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .faixa :global(.faixa__foto) {
    display: block;
    height: 100%;
  }
  .faixa :global(.faixa__foto img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .faixa__conteudo {
    padding-block: clamp(64px, 10vw, 120px);
  }
  .faixa__cartao {
    display: grid;
    gap: 18px;
    max-width: 34rem;
    padding: clamp(24px, 4vw, 44px);
    border-radius: var(--raio-l);
    background: rgb(250 248 243 / 0.96);
    box-shadow: 0 30px 60px rgb(5 22 18 / 0.25);
  }
  .faixa__cartao .etiqueta {
    margin-bottom: 0;
  }
  .faixa__cartao p:not(.etiqueta) {
    color: var(--texto-suave);
  }
</style>
