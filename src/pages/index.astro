---
import ComoChegar from '../components/ComoChegar.astro';
import FichaServico from '../components/FichaServico.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import SecaoPedidos from '../components/SecaoPedidos.astro';
import { lodge } from '../config/lodge';
import Base from '../layouts/Base.astro';

const site = Astro.site?.href ?? lodge.site.urlDemonstracao;
// Só informação confirmada: nome, localidade e país. Sem classificações, preços nem avaliações.
const dadosEstruturados = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: lodge.nome,
  url: site,
  image: new URL('/og/mulotane-lodge.jpg', site).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: lodge.localizacao.localidade,
    addressRegion: lodge.localizacao.provincia,
    addressCountry: lodge.localizacao.codigoPais,
  },
  ...(lodge.contactos.telefone ? { telephone: lodge.contactos.telefone } : {}),
};

const atalhos = [
  { href: '/alojamento/', nome: 'Alojamento' },
  { href: '/restaurante/', nome: 'Restaurante' },
  { href: '/piscinas/', nome: 'Piscinas' },
  { href: '/eventos/', nome: 'Eventos' },
];
---

<Base
  inicio
  titulo="Mulotane Lodge · Um refúgio de tranquilidade em Boane, Moçambique"
  descricao="Alojamento, restaurante, piscinas e espaços para eventos em Boane, província de Maputo. Consulte a disponibilidade ou peça um orçamento para o seu evento."
  dadosEstruturados={dadosEstruturados}
>
  <section class="hero" aria-labelledby="hero-titulo">
    <img
      class="hero__folhagem"
      src="/images/mulotane/conceptual/folhagem.svg"
      alt=""
      width="520"
      height="600"
    />
    <div class="contentor hero__grelha">
      <div class="hero__texto">
        <p class="etiqueta etiqueta--clara">Boane · Moçambique</p>
        <h1 id="hero-titulo">
          Um refúgio de <em>tranquilidade.</em>
        </h1>
        <p class="hero__sub">
          Descubra um espaço para descansar, conviver e desfrutar de bons momentos, entre o lazer, a
          gastronomia e a natureza.
        </p>
        <div class="accoes hero__accoes">
          <a class="botao botao--principal" href="#disponibilidade">
            Consultar disponibilidade
            <Icone nome="seta" tamanho={18} />
          </a>
          <a class="botao botao--contorno-claro" href="#o-lodge">
            Conhecer o lodge
          </a>
        </div>
      </div>
      <figure class="hero__figura">
        <Foto id="piscina-jardim" prioridade sizes="(min-width: 1024px) 55vw, 100vw" class="hero__foto" />
        <figcaption class="hero__legenda">
          <Icone nome="ondas" tamanho={16} />
          Piscina e jardim do Mulotane Lodge
        </figcaption>
      </figure>
    </div>
    <nav class="contentor hero__atalhos" aria-label="Espaços do lodge">
      {atalhos.map((a, i) => (
        <a href={a.href}>
          <span class="hero__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          {a.nome}
        </a>
      ))}
    </nav>
  </section>

  <section id="o-lodge" class="secao secao--clara apresentacao" aria-labelledby="apresentacao-titulo">
    <div class="contentor">
      <div class="apresentacao__topo">
        <div class="bloco-titulo">
          <p class="etiqueta">O lodge</p>
          <h2 id="apresentacao-titulo" class="apresentacao__titulo">
            Mais do que uma estadia, <em>momentos para recordar.</em>
          </h2>
        </div>
        <div class="apresentacao__texto revelar">
          <div class="texto">
            <p>
              No Mulotane Lodge, o descanso, a gastronomia e o convívio encontram espaço para acontecer.
              Explore as instalações, descubra as opções disponíveis e prepare a sua próxima visita.
            </p>
          </div>
          <a class="ligacao-seta" href="/galeria/">
            <span>Ver a galeria</span>
            <Icone nome="seta" />
          </a>
        </div>
      </div>
      <IndiceServicos />
    </div>
  </section>

  <section class="secao secao--cinza alojamento" aria-labelledby="alojamento-titulo">
    <div class="contentor grelha grelha--texto-foto">
      <div class="bloco-titulo revelar">
        <p class="etiqueta">
          <span class="etiqueta__numero">01</span> Alojamento
        </p>
        <h2 id="alojamento-titulo">
          O seu espaço para <em>descansar.</em>
        </h2>
        <div class="texto">
          <p>
            Quartos para descansar depois de um dia de lazer, de trabalho ou de celebração. Consulte a
            disponibilidade para as datas da sua visita: a equipa do lodge indica os tipos de quarto
            disponíveis e as condições da estadia.
          </p>
        </div>
        <div class="accoes">
          <a class="botao botao--verde" href="#disponibilidade">
            Consultar disponibilidade
            <Icone nome="seta" tamanho={18} />
          </a>
          <a class="ligacao-seta" href="/alojamento/">
            <span>Sobre o alojamento</span>
            <Icone nome="seta" />
          </a>
        </div>
      </div>
      <div class="cartao-verde alojamento__cartao revelar">
        <img
          class="cartao-verde__folhagem"
          src="/images/mulotane/conceptual/folhagem.svg"
          alt=""
          width="520"
          height="600"
          loading="lazy"
        />
        <p class="filete-titulo">Pedido de disponibilidade</p>
        <h3>Indique no seu pedido</h3>
        <ol class="lista-numerada">
          <li>As datas de entrada e de saída</li>
          <li>O número de hóspedes</li>
          <li>Um telefone ou WhatsApp para a resposta</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="secao secao--escura restaurante" aria-labelledby="restaurante-titulo">
    <div class="contentor grelha grelha--texto-foto">
      <div class="bloco-titulo revelar">
        <p class="etiqueta">
          <span class="etiqueta__numero">02</span> Restaurante
        </p>
        <h2 id="restaurante-titulo">
          Sabores e momentos <em>à mesa.</em>
        </h2>
        <div class="texto">
          <p>
            Refeições numa sala ampla, com janelas largas sobre a vegetação. A oferta, os horários e as
            refeições para grupos são indicados pela equipa do lodge.
          </p>
        </div>
        <div class="accoes">
          <a class="botao botao--principal" href="/restaurante/">
            Conhecer o restaurante
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <div class="restaurante__fotos revelar">
        <Foto
          id="restaurante-buffet-sala"
          sizes="(min-width: 900px) 660px, 92vw"
          class="foto restaurante__principal"
        />
        <Foto
          id="restaurante-buffet"
          sizes="(min-width: 900px) 240px, 40vw"
          class="arco restaurante__detalhe"
        />
      </div>
    </div>
  </section>

  <section class="secao secao--clara piscinas" aria-labelledby="piscinas-titulo">
    <div class="contentor grelha grelha--metades">
      <div class="piscinas__ficha revelar">
        <FichaServico servico="piscinas" titulo="Condições de utilização" />
      </div>
      <div class="bloco-titulo revelar">
        <p class="etiqueta">
          <span class="etiqueta__numero">03</span> Piscinas
        </p>
        <h2 id="piscinas-titulo">
          Desfrute de momentos de <em>lazer.</em>
        </h2>
        <div class="texto">
          <p>
            Um espaço para descontrair ao ar livre, entre o relvado e o jardim, e partilhar bons momentos.
          </p>
          <p>A piscina, de forma irregular, fica no meio de um relvado, entre sebes e árvores.</p>
        </div>
        <a class="ligacao-seta" href="/piscinas/">
          <span>Conhecer as piscinas</span>
          <Icone nome="seta" />
        </a>
      </div>
    </div>
  </section>

  <section class="secao secao--cinza eventos" aria-labelledby="eventos-titulo">
    <div class="contentor eventos__grelha">
      <figure class="eventos__figura arco-filete revelar">
        <Foto id="sala-refeicoes" sizes="(min-width: 900px) 440px, 92vw" class="arco eventos__foto" />
      </figure>
      <div class="bloco-titulo eventos__conteudo revelar">
        <p class="etiqueta">
          <span class="etiqueta__numero">04</span> Eventos e conferências
        </p>
        <h2 id="eventos-titulo">
          Um espaço para reunir <em>e celebrar.</em>
        </h2>
        <div class="texto">
          <p>
            Está a planear uma reunião, uma celebração ou um encontro de grupo? Peça um orçamento com a data
            pretendida, o número de participantes e o tipo de evento.
          </p>
        </div>
        <ul class="lista-traco">
          <li>Reuniões, formações e conferências</li>
          <li>Celebrações familiares e aniversários</li>
          <li>Encontros de grupo e eventos de empresa</li>
        </ul>
        <div class="accoes">
          <a class="botao botao--verde" href="#orcamento">
            Pedir orçamento para um evento
            <Icone nome="seta" tamanho={18} />
          </a>
          <a class="ligacao-seta" href="/eventos/">
            <span>Sobre os eventos</span>
            <Icone nome="seta" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <SecaoPedidos />

  <ComoChegar />

  <section class="secao secao--cinza fecho" aria-labelledby="fecho-titulo">
    <div class="contentor fecho__conteudo">
      <p class="etiqueta">Mulotane Lodge · Boane</p>
      <h2 id="fecho-titulo">
        Prepare a sua próxima <em>visita.</em>
      </h2>
      <div class="accoes">
        <a class="botao botao--verde" href="#disponibilidade">
          Consultar disponibilidade
          <Icone nome="seta" tamanho={18} />
        </a>
        <a class="botao botao--contorno" href="#orcamento">
          Pedir orçamento para um evento
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ----------
     Telemóvel: texto e, por baixo, a fotografia de margem a margem.
     Computador: texto à esquerda; a fotografia ocupa a metade direita até à borda do ecrã, com um arco
     largo no canto (o gesto das molduras do site), e a faixa dos espaços fecha a secção. */
  .hero {
    --foco: var(--dourado);
    position: relative;
    display: grid;
    padding-top: var(--cabecalho);
    background: var(--verde);
    color: var(--branco);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__folhagem {
    position: absolute;
    top: 14%;
    left: -120px;
    z-index: -1;
    width: clamp(280px, 36vw, 560px);
    height: auto;
    opacity: 0.08;
    pointer-events: none;
  }
  .hero__grelha {
    display: grid;
    gap: clamp(36px, 6vw, 56px);
  }
  .hero__texto {
    display: grid;
    gap: 24px;
    justify-items: start;
    padding-top: clamp(28px, 6vw, 48px);
  }
  .hero__texto .etiqueta {
    margin: 0;
  }
  .hero h1 {
    max-width: 12ch;
    font-size: var(--t-hero);
    line-height: 0.98;
  }
  .hero h1 em {
    color: var(--dourado);
  }
  .hero__sub {
    max-width: 31rem;
    font-size: var(--t-lead);
    line-height: 1.6;
    color: rgb(250 248 243 / 0.88);
  }
  .hero__accoes {
    margin-top: 6px;
  }
  .hero__figura {
    position: relative;
    margin: 0 calc(-1 * var(--margem));
  }
  .hero :global(.hero__foto) {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--verde-2);
    border-radius: clamp(120px, 34vw, 200px) 0 0 0;
    animation: hero-entrada 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero :global(.hero__foto img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 42%;
  }
  @keyframes hero-entrada {
    from {
      opacity: 0;
    }
  }
  .hero__legenda {
    position: absolute;
    left: var(--margem);
    bottom: 16px;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgb(8 40 32 / 0.78);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--branco);
  }
  .hero__legenda :global(svg) {
    color: var(--dourado);
  }
  .hero__atalhos {
    display: none;
  }
  @media (max-width: 759px) {
    .hero__accoes {
      display: grid;
      width: 100%;
    }
  }
  @media (min-width: 760px) {
    .hero__atalhos {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-top: 1px solid var(--linha-clara);
    }
    .hero__atalhos a {
      display: flex;
      align-items: center;
      gap: 14px;
      min-height: 72px;
      padding-left: 24px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;
      color: rgb(250 248 243 / 0.85);
      border-left: 1px solid var(--linha-clara);
      transition: color var(--transicao);
    }
    .hero__atalhos a:first-child {
      padding-left: 0;
      border-left: 0;
    }
    .hero__atalhos a:hover {
      color: var(--dourado);
    }
    .hero__num {
      font-family: var(--serif);
      font-size: 1.05rem;
      font-style: italic;
      font-weight: 500;
      letter-spacing: 0;
      text-transform: none;
      color: var(--dourado);
    }
  }
  @media (min-width: 760px) and (max-width: 1023px) {
    .hero :global(.hero__foto) {
      aspect-ratio: 16 / 10;
    }
  }
  @media (min-width: 1024px) {
    .hero h1 {
      font-size: clamp(3.4rem, 1.2rem + 3.6vw, 5.6rem);
    }
    .hero__grelha {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
      gap: clamp(40px, 5vw, 80px);
      min-height: clamp(560px, calc(100svh - var(--cabecalho) - 73px), 820px);
    }
    .hero__texto {
      align-self: center;
      padding-block: 56px;
    }
    /* Até à borda direita do ecrã: a margem do contentor mais o espaço fora dele. */
    .hero__figura {
      margin: 0 calc(-1 * (var(--margem) + max(0px, (100vw - var(--contentor) - 2 * var(--margem)) / 2))) 0 0;
    }
    .hero :global(.hero__foto) {
      height: 100%;
      aspect-ratio: auto;
      border-radius: clamp(180px, 16vw, 280px) 0 0 0;
    }
    /* Moldura quase quadrada: aproxima ligeiramente a piscina e deixa de fora parte do pavimento. */
    .hero :global(.hero__foto img) {
      transform: scale(1.12);
      transform-origin: 34% 30%;
    }
    .hero__legenda {
      left: clamp(48px, 6vw, 96px);
      bottom: 24px;
    }
  }
  @media (min-width: 1024px) and (max-width: 1279px) {
    /* Moldura mais estreita: a piscina fica à esquerda da fotografia original. */
    .hero :global(.hero__foto img) {
      transform: none;
      object-position: 26% 50%;
    }
  }

  /* ---------- Apresentação ---------- */
  .apresentacao__topo {
    display: grid;
    gap: 32px;
    margin-bottom: clamp(56px, 7vw, 96px);
  }
  .apresentacao__titulo {
    max-width: 15ch;
    font-size: clamp(2.3rem, 1.5rem + 3.2vw, 4.4rem);
  }
  .apresentacao__texto {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  @media (min-width: 900px) {
    .apresentacao__topo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(40px, 6vw, 96px);
      align-items: end;
    }
  }

  /* ---------- Alojamento ---------- */
  .alojamento__cartao {
    max-width: 560px;
  }
  @media (min-width: 900px) {
    .alojamento__cartao {
      justify-self: end;
      width: 100%;
    }
  }

  /* ---------- Restaurante ---------- */
  .restaurante__fotos {
    position: relative;
    padding-bottom: 18%;
  }
  .restaurante :global(.restaurante__principal) {
    display: block;
    aspect-ratio: 3 / 2;
  }
  .restaurante :global(.restaurante__detalhe) {
    position: absolute;
    left: -5%;
    bottom: 0;
    width: 34%;
    aspect-ratio: 3 / 4;
    outline: 6px solid var(--verde);
  }
  @media (max-width: 899px) {
    .restaurante :global(.restaurante__detalhe) {
      left: auto;
      right: 5%;
    }
  }

  /* ---------- Piscinas ---------- */
  .piscinas__ficha {
    max-width: 560px;
  }
  @media (max-width: 899px) {
    /* No telemóvel, o texto vem antes da ficha. */
    .piscinas__ficha {
      order: 1;
    }
  }

  /* ---------- Eventos ---------- */
  .eventos__grelha {
    display: grid;
    gap: clamp(48px, 7vw, 112px);
    align-items: center;
  }
  .eventos__figura {
    margin: 0;
    width: min(100%, 460px);
  }
  .eventos :global(.eventos__foto) {
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 900px) {
    .eventos__grelha {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
    .eventos__figura {
      justify-self: center;
    }
  }

  /* ---------- Fecho ---------- */
  .fecho__conteudo {
    display: grid;
    gap: 28px;
    justify-items: center;
    text-align: center;
  }
  .fecho .etiqueta {
    margin: 0;
  }
  .fecho h2 {
    max-width: 14ch;
    font-size: clamp(2.4rem, 1.5rem + 3.4vw, 4.6rem);
  }
  .fecho .accoes {
    justify-content: center;
  }
</style>
