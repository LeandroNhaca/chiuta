---
import ComoChegar from '../components/ComoChegar.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import SecaoPedidos from '../components/SecaoPedidos.astro';
import { lodge } from '../config/lodge';
import Base from '../layouts/Base.astro';

const site = Astro.site?.href ?? lodge.site.urlDemonstracao;
// Só informação confirmada: nome, localidade e país. Sem classificações, preços nem avaliações.
const dadosEstruturados = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: lodge.nome,
  url: site,
  image: new URL('/og/mulotane-lodge.jpg', site).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: lodge.localizacao.localidade,
    addressRegion: lodge.localizacao.provincia,
    addressCountry: lodge.localizacao.codigoPais,
  },
  ...(lodge.contactos.telefone ? { telephone: lodge.contactos.telefone } : {}),
};

const atalhos = [
  { href: '/alojamento/', nome: 'Alojamento' },
  { href: '/restaurante/', nome: 'Restaurante' },
  { href: '/piscinas/', nome: 'Piscinas' },
  { href: '/eventos/', nome: 'Eventos' },
];
---

<Base
  inicio
  titulo="Mulotane Lodge · Um refúgio de tranquilidade em Boane, Moçambique"
  descricao="Alojamento, restaurante, piscinas e espaços para eventos em Boane, província de Maputo. Consulte a disponibilidade ou peça um orçamento para o seu evento."
  dadosEstruturados={dadosEstruturados}
>
  <section class="hero" aria-labelledby="hero-titulo">
    <img
      class="hero__folhagem"
      src="/images/mulotane/conceptual/folhagem.svg"
      alt=""
      width="520"
      height="600"
    />
    <div class="contentor hero__grelha">
      <div class="hero__texto">
        <p class="etiqueta etiqueta--clara">Boane · Moçambique</p>
        <h1 id="hero-titulo">
          Um refúgio de <em>tranquilidade.</em>
        </h1>
        <p class="hero__sub">
          Descubra um espaço para descansar, conviver e desfrutar de bons momentos, entre o lazer, a
          gastronomia e a natureza.
        </p>
        <div class="accoes hero__accoes">
          <a class="botao botao--principal" href="#disponibilidade">
            Consultar disponibilidade
            <Icone nome="seta" tamanho={18} />
          </a>
          <a class="botao botao--contorno-claro" href="#o-lodge">
            Conhecer o lodge
          </a>
        </div>
      </div>
      <figure class="hero__figura arco-filete">
        <Foto
          id="piscina-jardim"
          prioridade
          sizes="(min-width: 1200px) 500px, (min-width: 760px) 40vw, 92vw"
          class="arco hero__foto"
        />
        <figcaption class="hero__legenda">Piscina e jardim</figcaption>
      </figure>
    </div>
    <nav class="contentor hero__atalhos" aria-label="Espaços do lodge">
      {atalhos.map((a, i) => (
        <a href={a.href}>
          <span class="hero__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          {a.nome}
        </a>
      ))}
    </nav>
  </section>

  <section id="o-lodge" class="secao secao--clara apresentacao" aria-labelledby="apresentacao-titulo">
    <div class="contentor">
      <div class="apresentacao__topo">
        <div class="bloco-titulo">
          <p class="etiqueta">O lodge</p>
          <h2 id="apresentacao-titulo" class="apresentacao__titulo">
            Mais do que uma estadia, <em>momentos para recordar.</em>
          </h2>
        </div>
        <div class="apresentacao__texto revelar">
          <div class="texto">
            <p>
              No Mulotane Lodge, o descanso, a gastronomia e o convívio encontram espaço para acontecer.
              Explore as instalações, descubra as opções disponíveis e prepare a sua próxima visita.
            </p>
          </div>
          <a class="ligacao-seta" href="/galeria/">
            <span>Ver a galeria</span>
            <Icone nome="seta" />
          </a>
        </div>
      </div>
      <IndiceServicos />
    </div>
  </section>

  <section class="secao secao--cinza alojamento" aria-labelledby="alojamento-titulo">
    <div class="contentor grelha grelha--texto-foto">
      <div class="bloco-titulo revelar">
        <p class="etiqueta">
          <span class="etiqueta__numero">01</span> Alojamento
        </p>
        <h2 id="alojamento-titulo">
          O seu espaço para <em>descansar.</em>
        </h2>
        <div class="texto">
          <p>
            Quartos para descansar depois de um dia de lazer, de trabalho ou de celebração. Consulte a
            disponibilidade para as datas da sua visita: a equipa do lodge indica os tipos de quarto
            disponíveis e as condições da estadia.
          </p>
        </div>
        <div class="accoes">
          <a class="botao botao--verde" href="#disponibilidade">
            Consultar disponibilidade
            <Icone nome="seta" tamanho={18} />
          </a>
          <a class="ligacao-seta" href="/alojamento/">
            <span>Sobre o alojamento</span>
            <Icone nome="seta" />
          </a>
        </div>
      </div>
      <div class="cartao-verde alojamento__cartao revelar">
        <img
          class="cartao-verde__folhagem"
          src="/images/mulotane/conceptual/folhagem.svg"
          alt=""
          width="520"
          height="600"
          loading="lazy"
        />
        <p class="filete-titulo">Pedido de disponibilidade</p>
        <h3>Indique no seu pedido</h3>
        <ol class="lista-numerada">
          <li>As datas de entrada e de saída</li>
          <li>O número de hóspedes</li>
          <li>Um telefone ou WhatsApp para a resposta</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="secao secao--escura restaurante" aria-labelledby="restaurante-titulo">
    <div class="contentor grelha grelha--texto-foto">
      <div class="bloco-titulo revelar">
        <p class="etiqueta">
          <span class="etiqueta__numero">02</span> Restaurante
        </p>
        <h2 id="restaurante-titulo">
          Sabores e momentos <em>à mesa.</em>
        </h2>
        <div class="texto">
          <p>
            Refeições numa sala ampla, com janelas largas sobre a vegetação. A oferta, os horários e as
            refeições para grupos são indicados pela equipa do lodge.
          </p>
        </div>
        <div class="accoes">
          <a class="botao botao--principal" href="/restaurante/">
            Conhecer o restaurante
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <div class="restaurante__fotos revelar">
        <Foto
          id="restaurante-buffet-sala"
          sizes="(min-width: 900px) 660px, 92vw"
          class="foto restaurante__principal"
        />
        <Foto
          id="restaurante-buffet"
          sizes="(min-width: 900px) 240px, 40vw"
          class="arco restaurante__detalhe"
        />
      </div>
    </div>
  </section>

  <section class="secao secao--clara piscinas" aria-labelledby="piscinas-titulo">
    <div class="contentor grelha grelha--foto-texto">
      <figure class="moldura moldura--esquerda piscinas__figura revelar">
        <Foto id="piscina-jardim" sizes="(min-width: 900px) 700px, 92vw" class="foto piscinas__foto" />
      </figure>
      <div class="bloco-titulo revelar">
        <p class="etiqueta">
          <span class="etiqueta__numero">03</span> Piscinas
        </p>
        <h2 id="piscinas-titulo">
          Desfrute de momentos de <em>lazer.</em>
        </h2>
        <div class="texto">
          <p>
            Um espaço para descontrair ao ar livre, entre o relvado e o jardim, e partilhar bons momentos.
          </p>
          <p>
            Os horários, as regras de utilização e o acesso de visitantes não alojados são indicados pela
            equipa do lodge.
          </p>
        </div>
        <a class="ligacao-seta" href="/piscinas/#condicoes">
          <span>Condições de utilização</span>
          <Icone nome="seta" />
        </a>
      </div>
    </div>
  </section>

  <section class="secao secao--cinza eventos" aria-labelledby="eventos-titulo">
    <div class="contentor eventos__grelha">
      <figure class="eventos__figura arco-filete revelar">
        <Foto id="sala-refeicoes" sizes="(min-width: 900px) 440px, 92vw" class="arco eventos__foto" />
      </figure>
      <div class="bloco-titulo eventos__conteudo revelar">
        <p class="etiqueta">
          <span class="etiqueta__numero">04</span> Eventos e conferências
        </p>
        <h2 id="eventos-titulo">
          Um espaço para reunir <em>e celebrar.</em>
        </h2>
        <div class="texto">
          <p>
            Está a planear uma reunião, uma celebração ou um encontro de grupo? Peça um orçamento com a data
            pretendida, o número de participantes e o tipo de evento.
          </p>
        </div>
        <ul class="lista-traco">
          <li>Reuniões, formações e conferências</li>
          <li>Celebrações familiares e aniversários</li>
          <li>Encontros de grupo e eventos de empresa</li>
        </ul>
        <div class="accoes">
          <a class="botao botao--verde" href="#orcamento">
            Pedir orçamento para um evento
            <Icone nome="seta" tamanho={18} />
          </a>
          <a class="ligacao-seta" href="/eventos/">
            <span>Sobre os eventos</span>
            <Icone nome="seta" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <SecaoPedidos />

  <ComoChegar />

  <section class="secao secao--escura fecho" aria-labelledby="fecho-titulo">
    <div class="contentor fecho__conteudo">
      <p class="etiqueta">Mulotane Lodge · Boane</p>
      <h2 id="fecho-titulo">
        Prepare a sua próxima <em>visita.</em>
      </h2>
      <div class="accoes">
        <a class="botao botao--principal" href="#disponibilidade">
          Consultar disponibilidade
          <Icone nome="seta" tamanho={18} />
        </a>
        <a class="botao botao--contorno-claro" href="#orcamento">
          Pedir orçamento para um evento
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    --foco: var(--dourado);
    position: relative;
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    padding-top: calc(var(--cabecalho) + clamp(28px, 6vw, 64px));
    background: var(--verde);
    color: var(--branco);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__folhagem {
    position: absolute;
    top: 12%;
    left: -120px;
    z-index: -1;
    width: clamp(280px, 36vw, 560px);
    height: auto;
    opacity: 0.08;
    pointer-events: none;
  }
  .hero__grelha {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  .hero__texto {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .hero__texto .etiqueta {
    margin: 0;
  }
  .hero h1 {
    max-width: 12ch;
    font-size: var(--t-hero);
    line-height: 0.98;
  }
  .hero h1 em {
    color: var(--dourado);
  }
  .hero__sub {
    max-width: 32rem;
    font-size: var(--t-lead);
    line-height: 1.6;
    color: rgb(250 248 243 / 0.84);
  }
  .hero__accoes {
    margin-top: 6px;
  }
  .hero__figura {
    position: relative;
    margin: 0;
    width: min(100%, 520px);
    justify-self: center;
  }
  .hero :global(.hero__foto) {
    aspect-ratio: 4 / 5;
    animation: hero-entrada 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero :global(.hero__foto img) {
    object-position: 40% 30%;
  }
  @keyframes hero-entrada {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  .hero__legenda {
    margin-top: 14px;
    font-size: var(--t-etiqueta);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-align: right;
    text-transform: uppercase;
    color: rgb(250 248 243 / 0.6);
  }
  .hero__atalhos {
    display: none;
  }
  @media (max-width: 759px) {
    .hero {
      padding-bottom: clamp(48px, 10vw, 72px);
    }
    .hero__accoes {
      display: grid;
      width: 100%;
    }
    .hero :global(.hero__foto) {
      aspect-ratio: 5 / 6;
    }
  }
  @media (min-width: 760px) {
    .hero__grelha {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      min-height: min(calc(100svh - var(--cabecalho) - 160px), 760px);
    }
    .hero__figura {
      justify-self: end;
    }
    .hero__atalhos {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-top: 1px solid var(--linha-clara);
    }
    .hero__atalhos a {
      display: flex;
      align-items: center;
      gap: 14px;
      min-height: 72px;
      padding-left: 24px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;
      color: rgb(250 248 243 / 0.82);
      border-left: 1px solid var(--linha-clara);
      transition: color var(--transicao);
    }
    .hero__atalhos a:first-child {
      padding-left: 0;
      border-left: 0;
    }
    .hero__atalhos a:hover {
      color: var(--dourado);
    }
    .hero__num {
      font-family: var(--serif);
      font-size: 1.05rem;
      font-style: italic;
      font-weight: 500;
      letter-spacing: 0;
      text-transform: none;
      color: var(--dourado);
    }
  }
  @media (min-width: 1024px) {
    .hero__grelha {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  /* ---------- Apresentação ---------- */
  .apresentacao__topo {
    display: grid;
    gap: 32px;
    margin-bottom: clamp(56px, 7vw, 96px);
  }
  .apresentacao__titulo {
    max-width: 15ch;
    font-size: clamp(2.3rem, 1.5rem + 3.2vw, 4.4rem);
  }
  .apresentacao__texto {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  @media (min-width: 900px) {
    .apresentacao__topo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(40px, 6vw, 96px);
      align-items: end;
    }
  }

  /* ---------- Alojamento ---------- */
  .alojamento__cartao {
    max-width: 560px;
  }
  @media (min-width: 900px) {
    .alojamento__cartao {
      justify-self: end;
      width: 100%;
    }
  }

  /* ---------- Restaurante ---------- */
  .restaurante__fotos {
    position: relative;
    padding-bottom: 18%;
  }
  .restaurante :global(.restaurante__principal) {
    display: block;
    aspect-ratio: 3 / 2;
  }
  .restaurante :global(.restaurante__detalhe) {
    position: absolute;
    left: -5%;
    bottom: 0;
    width: 34%;
    aspect-ratio: 3 / 4;
    outline: 6px solid var(--verde);
  }
  @media (max-width: 899px) {
    .restaurante :global(.restaurante__detalhe) {
      left: auto;
      right: 5%;
    }
  }

  /* ---------- Piscinas ---------- */
  .piscinas__figura {
    margin: 0;
  }
  .piscinas :global(.piscinas__foto) {
    display: block;
    aspect-ratio: 3 / 2;
  }
  .piscinas :global(.piscinas__foto img) {
    object-position: 50% 35%;
  }

  /* ---------- Eventos ---------- */
  .eventos__grelha {
    display: grid;
    gap: clamp(48px, 7vw, 112px);
    align-items: center;
  }
  .eventos__figura {
    margin: 0;
    width: min(100%, 460px);
  }
  .eventos :global(.eventos__foto) {
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 900px) {
    .eventos__grelha {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
    .eventos__figura {
      justify-self: center;
    }
  }

  /* ---------- Fecho ---------- */
  .fecho__conteudo {
    display: grid;
    gap: 28px;
    justify-items: center;
    text-align: center;
  }
  .fecho .etiqueta {
    margin: 0;
  }
  .fecho h2 {
    max-width: 14ch;
    font-size: clamp(2.4rem, 1.5rem + 3.4vw, 4.6rem);
  }
  .fecho .accoes {
    justify-content: center;
  }
</style>
