---
import ComoChegar from '../components/ComoChegar.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import SecaoDisponibilidade from '../components/SecaoDisponibilidade.astro';
import { lodge } from '../config/lodge';
import type { IdFotografia } from '../data/fotografias';
import Base from '../layouts/Base.astro';

const site = Astro.site?.href ?? lodge.site.urlDemonstracao;
// Só informação confirmada: nome, localidade e país. Sem classificações, preços nem avaliações.
const dadosEstruturados = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: lodge.nome,
  url: site,
  image: new URL('/og/mulotane-lodge.jpg', site).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: lodge.localizacao.localidade,
    addressRegion: lodge.localizacao.provincia,
    addressCountry: lodge.localizacao.codigoPais,
  },
  ...(lodge.contactos.telefone ? { telephone: lodge.contactos.telefone } : {}),
};

const galeria: IdFotografia[] = [
  'piscina-terraco',
  'restaurante-buffet-sala',
  'piscina-jardim',
  'sala-refeicoes',
  'edificio-exterior',
];
---

<Base
  inicio
  titulo="Mulotane Lodge · Um refúgio de tranquilidade em Boane, Moçambique"
  descricao="Alojamento, restaurante, piscinas e espaços para eventos em Boane, província de Maputo. Consulte a disponibilidade ou peça um orçamento para o seu evento."
  dadosEstruturados={dadosEstruturados}
>
  <section class="hero" aria-labelledby="hero-titulo">
    <Foto id="piscina-espreguicadeiras" prioridade sizes="100vw" class="hero__foto" />
    <div class="hero__veu" aria-hidden="true"></div>
    <div class="contentor hero__conteudo">
      <p class="etiqueta etiqueta--clara hero__etiqueta">Boane · Moçambique</p>
      <h1 id="hero-titulo">
        Um refúgio de <em>tranquilidade.</em>
      </h1>
      <p class="hero__sub">
        Descubra um espaço para descansar, conviver e desfrutar de bons momentos, entre o lazer, a gastronomia
        e a natureza.
      </p>
      <div class="accoes">
        <a class="botao botao--principal" href="#disponibilidade">
          Consultar disponibilidade
        </a>
        <a class="botao botao--contorno-claro" href="#o-lodge">
          Conhecer o lodge
        </a>
      </div>
    </div>
    <nav class="contentor hero__atalhos" aria-label="Espaços do lodge">
      <a href="/alojamento/">Alojamento</a>
      <a href="/restaurante/">Restaurante</a>
      <a href="/piscinas/">Piscinas</a>
      <a href="/eventos/">Eventos</a>
    </nav>
  </section>

  <section id="o-lodge" class="secao secao--clara apresentacao" aria-labelledby="apresentacao-titulo">
    <div class="contentor">
      <div class="grelha grelha--texto-foto">
        <div class="bloco-titulo revelar">
          <p class="etiqueta">
            <span class="etiqueta__numero">01</span> O lodge
          </p>
          <h2 id="apresentacao-titulo">
            Mais do que uma estadia, <em>momentos para recordar.</em>
          </h2>
          <div class="texto">
            <p>
              No Mulotane Lodge, o descanso, a gastronomia e o convívio encontram espaço para acontecer.
              Explore as instalações, descubra as opções disponíveis e prepare a sua próxima visita.
            </p>
          </div>
          <a class="ligacao-seta" href="/galeria/">
            <span>Ver os espaços em fotografias</span>
            <Icone nome="seta" />
          </a>
        </div>
        <figure class="apresentacao__figura moldura revelar">
          <Foto id="entrada-coberta" sizes="(min-width: 900px) 700px, 92vw" class="foto apresentacao__foto" />
          <figcaption class="legenda">A entrada do Mulotane Lodge.</figcaption>
        </figure>
      </div>
      <div class="apresentacao__indice">
        <IndiceServicos />
      </div>
    </div>
  </section>

  <section class="secao secao--cinza alojamento" aria-labelledby="alojamento-titulo">
    <div class="contentor grelha grelha--foto-texto">
      <figure class="moldura moldura--esquerda revelar">
        <Foto id="quarto-twin" sizes="(min-width: 900px) 700px, 92vw" class="foto alojamento__foto" />
      </figure>
      <div class="bloco-titulo revelar">
        <p class="etiqueta">
          <span class="etiqueta__numero">02</span> Alojamento
        </p>
        <h2 id="alojamento-titulo">
          O seu espaço para <em>descansar.</em>
        </h2>
        <div class="texto">
          <p>Conheça as opções de alojamento e consulte a disponibilidade para as datas da sua visita.</p>
          <p>
            Na fotografia, um quarto com duas camas individuais e roupa de cama branca. Pergunte-nos pelos
            tipos de quarto disponíveis e pelas condições da estadia.
          </p>
        </div>
        <div class="accoes">
          <a class="botao botao--verde" href="#disponibilidade">
            Consultar disponibilidade
          </a>
          <a class="ligacao-seta" href="/alojamento/">
            <span>Detalhes do alojamento</span>
            <Icone nome="seta" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="secao secao--escura restaurante" aria-labelledby="restaurante-titulo">
    <div class="contentor grelha grelha--texto-foto">
      <div class="bloco-titulo revelar">
        <p class="etiqueta">
          <span class="etiqueta__numero">03</span> Restaurante
        </p>
        <h2 id="restaurante-titulo">
          Sabores e momentos <em>à mesa.</em>
        </h2>
        <div class="texto">
          <p>
            Descubra o espaço de restauração do Mulotane Lodge e entre em contacto para conhecer a oferta
            disponível.
          </p>
        </div>
        <div class="accoes">
          <a class="botao botao--principal" href="/restaurante/">
            Consultar o serviço de restauração
          </a>
        </div>
      </div>
      <div class="restaurante__fotos revelar">
        <Foto
          id="sala-refeicoes-bar"
          sizes="(min-width: 900px) 640px, 92vw"
          class="foto restaurante__principal"
        />
        <Foto
          id="restaurante-buffet"
          sizes="(min-width: 900px) 260px, 45vw"
          class="foto restaurante__detalhe"
        />
      </div>
    </div>
  </section>

  <section class="piscinas" aria-labelledby="piscinas-titulo">
    <div class="piscinas__banda">
      <Foto id="piscina-vista-geral" sizes="100vw" class="piscinas__foto" />
    </div>
    <div class="contentor piscinas__conteudo">
      <div class="piscinas__cartao bloco-titulo revelar">
        <p class="etiqueta">
          <span class="etiqueta__numero">04</span> Piscinas
        </p>
        <h2 id="piscinas-titulo">
          Desfrute de momentos de <em>lazer.</em>
        </h2>
        <div class="texto">
          <p>Um espaço para descontrair, aproveitar o ambiente exterior e partilhar bons momentos.</p>
        </div>
        <a class="ligacao-seta" href="/piscinas/#condicoes">
          <span>Condições de utilização das piscinas</span>
          <Icone nome="seta" />
        </a>
      </div>
      <div class="piscinas__mosaico revelar">
        <figure>
          <Foto id="piscina-relvado" sizes="(min-width: 900px) 420px, 92vw" class="foto piscinas__pequena" />
          <figcaption class="legenda">Piscina junto ao relvado.</figcaption>
        </figure>
        <figure>
          <Foto
            id="esplanada-piscina"
            sizes="(min-width: 900px) 420px, 92vw"
            class="foto piscinas__pequena"
          />
          <figcaption class="legenda">Esplanada à sombra, junto à água.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="secao secao--clara eventos" aria-labelledby="eventos-titulo">
    <div class="contentor grelha grelha--texto-foto">
      <div class="bloco-titulo revelar">
        <p class="etiqueta">
          <span class="etiqueta__numero">05</span> Eventos e conferências
        </p>
        <h2 id="eventos-titulo">
          Um espaço para reunir <em>e celebrar.</em>
        </h2>
        <div class="texto">
          <p>
            Está a planear uma reunião, uma celebração ou um encontro de grupo? Entre em contacto com a nossa
            equipa para conhecer as opções disponíveis.
          </p>
        </div>
        <ul class="lista-traco">
          <li>Reuniões, formações e conferências</li>
          <li>Celebrações familiares e aniversários</li>
          <li>Encontros de grupo e eventos de empresa</li>
        </ul>
        <div class="accoes">
          <a class="botao botao--verde" href="/eventos/#pedido">
            Pedir orçamento para um evento
          </a>
        </div>
      </div>
      <figure class="moldura revelar">
        <Foto id="sala-conferencias" sizes="(min-width: 900px) 700px, 92vw" class="foto eventos__foto" />
        <figcaption class="legenda">Sala montada para uma conferência.</figcaption>
      </figure>
    </div>
  </section>

  <section class="secao secao--cinza galeria-teaser" aria-labelledby="galeria-titulo">
    <div class="contentor">
      <div class="galeria-teaser__topo">
        <div class="bloco-titulo">
          <p class="etiqueta">
            <span class="etiqueta__numero">06</span> Galeria
          </p>
          <h2 id="galeria-titulo">
            Um olhar pelo <em>lodge.</em>
          </h2>
        </div>
        <a class="botao botao--contorno" href="/galeria/">
          Ver a galeria completa
        </a>
      </div>
      <ul class="galeria-teaser__grelha">
        {galeria.map((id) => (
          <li>
            <Foto id={id} sizes="(min-width: 900px) 420px, 46vw" class="foto" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SecaoDisponibilidade />

  <ComoChegar />

  <section class="secao secao--escura fecho" aria-labelledby="fecho-titulo">
    <div class="contentor fecho__conteudo">
      <h2 id="fecho-titulo">
        Prepare a sua próxima <em>visita.</em>
      </h2>
      <div class="accoes">
        <a class="botao botao--principal" href="#disponibilidade">
          Consultar disponibilidade
        </a>
        <a class="botao botao--contorno-claro" href="/eventos/#pedido">
          Pedir orçamento para um evento
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    --foco: var(--dourado);
    position: relative;
    display: grid;
    align-content: end;
    min-height: max(620px, 100svh);
    padding-top: calc(var(--cabecalho) + 40px);
    color: var(--branco);
    overflow: hidden;
    isolation: isolate;
  }
  .hero :global(.hero__foto) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero :global(.hero__foto img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 42% 55%;
    animation: hero-entrada 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes hero-entrada {
    from {
      transform: scale(1.06);
    }
  }
  .hero__veu {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(6 28 22 / 0.92) 0%, rgb(6 28 22 / 0.55) 38%, rgb(6 28 22 / 0.1) 68%),
      linear-gradient(to right, rgb(6 28 22 / 0.45) 0%, rgb(6 28 22 / 0) 60%);
  }
  .hero__conteudo {
    display: grid;
    gap: 26px;
    padding-bottom: clamp(40px, 7vw, 72px);
  }
  .hero__etiqueta {
    margin: 0;
  }
  .hero h1 {
    max-width: 11ch;
    font-size: var(--t-hero);
    line-height: 0.98;
  }
  .hero h1 em {
    color: var(--dourado);
  }
  .hero__sub {
    max-width: 34rem;
    font-size: var(--t-lead);
    line-height: 1.6;
    color: rgb(250 248 243 / 0.9);
  }
  .hero__atalhos {
    display: none;
  }
  @media (min-width: 760px) {
    .hero__atalhos {
      display: flex;
      gap: 0;
      padding-block: 0;
      border-top: 1px solid var(--linha-clara);
    }
    .hero__atalhos a {
      flex: 1;
      display: flex;
      align-items: center;
      min-height: 64px;
      padding-left: 20px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;
      color: rgb(250 248 243 / 0.82);
      border-left: 1px solid var(--linha-clara);
      transition:
        color var(--transicao),
        background-color var(--transicao);
    }
    .hero__atalhos a:first-child {
      padding-left: 0;
      border-left: 0;
    }
    .hero__atalhos a:hover {
      color: var(--dourado);
    }
  }

  /* ---------- Apresentação ---------- */
  .apresentacao :global(.apresentacao__foto) {
    display: block;
    aspect-ratio: 3 / 2;
  }
  .apresentacao__figura {
    margin: 0;
  }
  .apresentacao__indice {
    margin-top: clamp(64px, 8vw, 120px);
  }

  /* ---------- Alojamento ---------- */
  .alojamento figure,
  .eventos figure {
    margin: 0;
  }
  .alojamento :global(.alojamento__foto) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .alojamento :global(.alojamento__foto img) {
    object-position: 50% 60%;
  }

  /* ---------- Restaurante ---------- */
  .restaurante__fotos {
    position: relative;
    padding-bottom: 12%;
  }
  .restaurante :global(.restaurante__principal) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .restaurante :global(.restaurante__detalhe) {
    position: absolute;
    left: -6%;
    bottom: 0;
    display: block;
    width: 38%;
    aspect-ratio: 3 / 4;
    border: 6px solid var(--verde);
  }
  @media (max-width: 899px) {
    .restaurante :global(.restaurante__detalhe) {
      left: auto;
      right: 4%;
    }
  }

  /* ---------- Piscinas ---------- */
  .piscinas {
    position: relative;
    padding-bottom: var(--espaco-secao);
    background: var(--branco);
  }
  .piscinas__banda :global(.piscinas__foto) {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  @media (min-width: 700px) {
    .piscinas__banda :global(.piscinas__foto) {
      aspect-ratio: 16 / 9;
      max-height: 86vh;
      width: 100%;
    }
  }
  .piscinas__banda :global(.piscinas__foto img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
  }
  .piscinas__conteudo {
    display: grid;
    gap: 48px;
    margin-top: -120px;
    position: relative;
  }
  .piscinas__cartao {
    max-width: 560px;
    padding: clamp(28px, 4vw, 52px);
    background: var(--branco);
    border-radius: var(--raio);
    box-shadow: 0 30px 60px rgb(5 22 18 / 0.12);
  }
  .piscinas__mosaico {
    display: grid;
    gap: 28px;
  }
  .piscinas__mosaico figure {
    margin: 0;
  }
  .piscinas :global(.piscinas__pequena) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 900px) {
    .piscinas__conteudo {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      margin-top: -200px;
    }
    .piscinas__mosaico {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 260px;
    }
    .piscinas__mosaico figure:last-child {
      margin-top: 64px;
    }
  }

  /* ---------- Eventos ---------- */
  .eventos :global(.eventos__foto) {
    display: block;
    aspect-ratio: 5 / 4;
  }

  /* ---------- Galeria ---------- */
  .galeria-teaser__topo {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: end;
    justify-content: space-between;
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .galeria-teaser__grelha {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 1.6vw, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .galeria-teaser__grelha li:first-child {
    grid-column: 1 / -1;
  }
  .galeria-teaser__grelha :global(.foto) {
    display: block;
    height: 100%;
    aspect-ratio: 4 / 3;
  }
  .galeria-teaser__grelha li:first-child :global(.foto) {
    aspect-ratio: 16 / 9;
  }
  @media (min-width: 900px) {
    .galeria-teaser__grelha {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(160px, 16vw, 230px);
    }
    .galeria-teaser__grelha li:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
    .galeria-teaser__grelha :global(.foto),
    .galeria-teaser__grelha li:first-child :global(.foto) {
      aspect-ratio: auto;
    }
  }

  /* ---------- Fecho ---------- */
  .fecho__conteudo {
    display: grid;
    gap: 32px;
    justify-items: start;
  }
  .fecho h2 {
    max-width: 16ch;
  }
</style>
