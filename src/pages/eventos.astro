---
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Foto from '../components/Foto.astro';
import FormularioEvento from '../components/FormularioEvento.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Eventos e conferências"
  descricao="Reuniões, conferências, celebrações e encontros de grupo no Mulotane Lodge, em Boane. Peça um orçamento para o seu evento."
>
  <CabecalhoPagina
    titulo="Eventos e conferências"
    intro="Um espaço para reunir e celebrar: reuniões de trabalho, celebrações familiares e encontros de grupo."
    foto="sala-conferencias"
  />

  <section class="secao secao--clara" aria-labelledby="reunir-titulo">
    <div class="contentor grelha grelha--texto-foto">
      <div class="bloco-titulo">
        <p class="etiqueta">Reunir e celebrar</p>
        <h2 id="reunir-titulo">
          Um espaço para reunir <em>e celebrar.</em>
        </h2>
        <div class="texto">
          <p>
            Está a planear uma reunião, uma celebração ou um encontro de grupo? Entre em contacto com a nossa
            equipa para conhecer as opções disponíveis.
          </p>
        </div>
        <h3 class="eventos__subtitulo">Para preparar o seu pedido</h3>
        <ul class="lista-traco">
          <li>A data pretendida e o horário aproximado</li>
          <li>O número estimado de participantes</li>
          <li>O tipo de evento e o formato da sala</li>
          <li>Refeições, equipamento ou outras necessidades</li>
        </ul>
        <div class="accoes">
          <a class="botao botao--verde" href="#pedido">
            Pedir orçamento para um evento
          </a>
        </div>
      </div>
      <figure class="moldura">
        <Foto id="sala-refeicoes" sizes="(min-width: 900px) 560px, 92vw" class="foto eventos__foto" />
        <figcaption class="legenda">Sala com janelas amplas sobre a vegetação.</figcaption>
      </figure>
    </div>
  </section>

  <section id="pedido" class="secao secao--escura pedido-evento" aria-labelledby="pedido-titulo">
    <div class="contentor grelha pedido-evento__grelha">
      <div class="bloco-titulo">
        <p class="etiqueta">Orçamento</p>
        <h2 id="pedido-titulo">
          Pedir orçamento para um <em>evento.</em>
        </h2>
        <div class="texto">
          <p>
            Conte-nos o que está a planear. A equipa do Mulotane Lodge analisa o pedido e responde com as
            opções disponíveis para a data indicada.
          </p>
        </div>
        <BotaoWhatsApp
          id="evento-wa"
          variante="contorno-claro"
          mensagem="Olá, Mulotane Lodge! Gostaria de pedir informações para um evento."
        />
      </div>
      <FormularioEvento />
    </div>
  </section>

  <section class="secao secao--cinza" aria-labelledby="explorar-titulo">
    <div class="contentor">
      <p class="etiqueta">Continue a explorar</p>
      <h2 id="explorar-titulo" class="explorar__titulo">
        Mais para descobrir no lodge.
      </h2>
      <IndiceServicos variante="cartoes" excluir="eventos" />
    </div>
  </section>
</Base>

<style>
  .grelha figure {
    margin: 0;
  }
  .eventos__subtitulo {
    margin-top: 8px;
    font-family: var(--sans);
    font-size: var(--t-etiqueta);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dourado-texto);
  }
  .grelha :global(.eventos__foto) {
    display: block;
    aspect-ratio: 4 / 5;
  }
  .pedido-evento__grelha {
    align-items: start;
  }
  @media (min-width: 1000px) {
    .pedido-evento__grelha {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .pedido-evento .bloco-titulo {
      position: sticky;
      top: calc(var(--cabecalho) + 32px);
    }
  }
  .explorar__titulo {
    margin-bottom: clamp(36px, 5vw, 56px);
  }
</style>
