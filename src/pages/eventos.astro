---
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Cenas, { type Cena } from '../components/Cenas.astro';
import FichaServico from '../components/FichaServico.astro';
import FormularioEvento from '../components/FormularioEvento.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import { lodge } from '../config/lodge';
import Base from '../layouts/Base.astro';

const salas = lodge.detalhes.eventos.find((d) => d.rotulo === 'Salas de conferências');
const exterior = lodge.detalhes.eventos.find((d) => d.rotulo === 'Eventos ao ar livre');
// Capacidades tal como o lodge as publicou (src/config/lodge.ts → detalhes.eventos).
const capacidades = salas?.valor.match(/\d+/g) ?? [];
const capacidadeExterior = exterior?.valor.match(/\d+/)?.[0];
// As montagens das salas, tal como aparecem nas fotografias do lodge; cada cena leva ao pedido de orçamento.
const orcamento = { href: '#pedido', texto: 'Pedir orçamento' };
const montagens: Cena[] = [
  {
    id: 'plateia',
    etiqueta: 'Montagem',
    titulo: 'Em plateia',
    texto: 'Filas de mesas viradas para a mesa de honra, para conferências e formações.',
    foto: 'sala-conferencias-plateia',
    ligacao: orcamento,
  },
  {
    id: 'u',
    etiqueta: 'Montagem',
    titulo: 'Em U, com ecrã',
    texto: 'Mesas em U à volta da mesa de honra e do ecrã de projecção, para reuniões e workshops.',
    foto: 'sala-conferencias-u',
    ligacao: orcamento,
  },
  {
    id: 'mesa-de-honra',
    etiqueta: 'Montagem',
    titulo: 'Estrado e mesa de honra',
    texto: 'Estrado, mesa de honra e púlpito, para sessões formais e cerimónias.',
    foto: 'sala-conferencias-palco',
    ligacao: orcamento,
  },
];
const tipos = [
  'Reuniões empresariais',
  'Formações e workshops',
  'Conferências',
  'Encontros de grupo',
  'Celebrações e eventos privados',
];
---

<Base
  titulo="Salas de conferências e eventos em Boane"
  descricao="Salas de conferências e espaços para eventos no Mulotana Lodge, em Boane: reuniões, formações, conferências e celebrações. Peça um orçamento para o seu evento."
>
  <CabecalhoPagina
    titulo="Conferências e eventos"
    intro="Salas de conferências e uma área ao ar livre junto à piscina para reuniões, formações, encontros de grupo e celebrações."
    foto="sala-conferencias-palco"
  >
    <a slot="accoes" class="botao botao--principal" href="#pedido">
      Pedir orçamento para um evento
      <Icone nome="seta" tamanho={18} />
    </a>
  </CabecalhoPagina>

  <section class="secao secao--clara" aria-labelledby="salas-titulo">
    <div class="contentor">
      <div class="bloco-titulo salas__topo">
        <p class="etiqueta c-revelar">As salas</p>
        <h2 id="salas-titulo" class="c-titulo">
          Um espaço à medida do <em>seu evento.</em>
        </h2>
        <div class="texto c-revelar">
          <p>
            Da reunião de equipa à conferência com centenas de participantes. Diga-nos quantas pessoas espera
            e como quer a sala montada: plateia, em U ou com mesa de honra.
          </p>
        </div>
      </div>
      {capacidades.length > 0 && (
        <ul class="salas c-cartoes" aria-label="Capacidade dos espaços">
          {capacidades.map((n) => (
            <li class="sala">
              <span class="sala__numero">{n}</span>
              <span class="sala__texto">pessoas</span>
              <span class="sala__tipo">Sala de conferências</span>
            </li>
          ))}
          {capacidadeExterior && (
            <li class="sala sala--exterior">
              <span class="sala__numero">{capacidadeExterior}</span>
              <span class="sala__texto">pessoas</span>
              <span class="sala__tipo">Área junto à piscina</span>
            </li>
          )}
        </ul>
      )}
      {salas?.aValidar && (
        <p class="salas__nota">
          <Icone nome="info" tamanho={16} />
          <span>
            Capacidades publicadas pelo lodge nas redes sociais ({salas.aValidar}). A equipa confirma a sala,
            a montagem e a disponibilidade para a data do seu evento.
          </span>
        </p>
      )}
    </div>
  </section>

  <section class="secao secao--escura montagens" aria-labelledby="montagens-titulo">
    <div class="contentor montagens__intro">
      <p class="etiqueta c-revelar">As montagens</p>
      <h2 id="montagens-titulo" class="c-titulo">
        A sala como o seu evento <em>precisa.</em>
      </h2>
    </div>
    <Cenas id="montagem" cenas={montagens} variante="compacta" rotulo="Montagens das salas" />
    <div class="contentor montagens__fecho">
      <a class="botao botao--principal" href="#pedido">
        Pedir orçamento para um evento
        <Icone nome="seta" tamanho={18} />
      </a>
    </div>
  </section>

  <section id="pedido" class="secao secao--cinza pedido-evento" aria-labelledby="pedido-titulo">
    <div class="contentor grelha pedido-evento__grelha">
      <div class="bloco-titulo pedido-evento__intro">
        <p class="etiqueta c-revelar">Orçamento</p>
        <h2 id="pedido-titulo" class="c-titulo">
          Pedir orçamento para um <em>evento.</em>
        </h2>
        <div class="texto">
          <p>
            Conte-nos o que está a planear. Não há orçamentos automáticos: a equipa do {lodge.nome} prepara-o
            de acordo com a disponibilidade do espaço e o que pedir.
          </p>
        </div>
      </div>
      <div class="pedido-evento__form">
        <FormularioEvento />
      </div>
      <div class="pedido-evento__lista">
        <p class="filete-titulo">Como funciona</p>
        <ol class="lista-numerada">
          <li>Preencha o pedido com a data, o número de participantes e os serviços pretendidos.</li>
          <li>Envie a mensagem preparada pelo WhatsApp ou por e-mail.</li>
          <li>A equipa confirma a disponibilidade e envia o orçamento.</li>
          <li>O evento fica garantido só depois de confirmado pelo lodge.</li>
        </ol>
        <!-- Fotografia pequena (780 px de origem): fora do palco em ecrã inteiro, onde ficaria desfocada. -->
        <figure class="pedido-evento__foto c-revelar">
          <Foto id="buffet-evento" sizes="(min-width: 1000px) 480px, 92vw" class="foto" />
          <figcaption class="legenda">
            Buffet montado para um evento. Indique no pedido as refeições que pretende.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="secao secao--clara" aria-labelledby="reunir-titulo">
    <div class="contentor grelha grelha--metades reunir">
      <div class="bloco-titulo">
        <p class="etiqueta c-revelar">Reunir e celebrar</p>
        <h2 id="reunir-titulo" class="c-titulo">
          Eventos que pode <em>organizar.</em>
        </h2>
        <ul class="lista-traco reunir__tipos">
          {tipos.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
        <div class="accoes">
          <a class="botao botao--principal" href="#pedido">
            Pedir orçamento
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <FichaServico servico="eventos" titulo="Os eventos em resumo" tom="clara" />
    </div>
  </section>

  <section class="secao secao--cinza" aria-labelledby="explorar-titulo">
    <div class="contentor">
      <p class="etiqueta c-revelar">Continue a explorar</p>
      <h2 id="explorar-titulo" class="explorar__titulo c-titulo">
        Mais para descobrir no lodge.
      </h2>
      <IndiceServicos variante="cartoes" excluir="eventos" />
    </div>
  </section>
</Base>

<style>
  .salas__topo {
    max-width: 46rem;
    margin-bottom: clamp(28px, 4vw, 40px);
  }
  .salas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .salas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .sala {
    display: grid;
    gap: 2px;
    padding: 20px;
    border: 1px solid var(--linha);
    border-radius: var(--raio-l);
    background: #fff;
  }
  .sala__numero {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 1.7rem + 2vw, 3.2rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    color: var(--dourado-texto);
  }
  .sala--exterior .sala__numero {
    color: var(--verde);
  }
  .sala__texto {
    font-weight: 700;
  }
  .sala__tipo {
    margin-top: 8px;
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }
  .salas__nota {
    display: flex;
    gap: 10px;
    margin-top: 16px;
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }
  .salas__nota :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--dourado-texto);
  }
  .montagens {
    padding-bottom: clamp(48px, 6vw, 80px);
  }
  .montagens__intro {
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .montagens__fecho {
    margin-top: clamp(32px, 4vw, 48px);
  }

  /* Telemóvel: título, formulário e só depois a lista de apoio. Computador: duas colunas. */
  .pedido-evento__grelha {
    align-items: start;
    row-gap: 36px;
  }
  .pedido-evento__lista {
    display: grid;
    gap: 6px;
  }
  .pedido-evento__foto {
    margin: 26px 0 0;
  }
  .pedido-evento__foto :global(.foto) {
    display: block;
    aspect-ratio: 5 / 4;
  }
  @media (min-width: 1000px) {
    .pedido-evento__grelha {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
    }
    .pedido-evento__intro {
      grid-column: 1;
      grid-row: 1;
    }
    .pedido-evento__lista {
      grid-column: 1;
      grid-row: 2;
    }
    .pedido-evento__form {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
  .reunir {
    align-items: start;
  }
  .reunir__tipos {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .explorar__titulo {
    margin-bottom: clamp(32px, 4vw, 48px);
  }
</style>
