---
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import ComoChegar from '../components/ComoChegar.astro';
import Icone from '../components/Icone.astro';
import { canaisContacto, temContactosDirectos } from '../lib/site';
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Contactos e como chegar"
  descricao="Fale com o Mulotane Lodge, em Boane, província de Maputo: consulte disponibilidade, peça um orçamento para um evento e prepare a viagem."
>
  <CabecalhoPagina
    titulo="Fale connosco"
    intro="Peça informações, consulte a disponibilidade ou prepare o seu evento no Mulotane Lodge, em Boane."
  />

  <section class="secao secao--clara" aria-labelledby="contactos-titulo">
    <div class="contentor grelha grelha--metades contactos">
      <div class="bloco-titulo">
        <p class="etiqueta">Contactos</p>
        <h2 id="contactos-titulo">
          Estamos em <em>Boane.</em>
        </h2>
        <ul class="contactos__lista">
          {canaisContacto.map((c) => (
            <li>
              <Icone nome={c.id} tamanho={22} />
              <span class="contactos__canal">
                <span class="contactos__rotulo">{c.rotulo}</span>
                {c.href ? (
                  <a
                    href={c.href}
                    target={c.externo ? '_blank' : undefined}
                    rel={c.externo ? 'noopener' : undefined}
                  >
                    {c.valor}
                  </a>
                ) : (
                  <span class="pendente">A confirmar</span>
                )}
              </span>
            </li>
          ))}
        </ul>
        {!temContactosDirectos && (
          <p class="contactos__nota">
            O telefone, o WhatsApp e o e-mail oficiais estão a ser confirmados pelo Mulotane Lodge e serão
            publicados nesta página. Até lá, pode preparar o seu pedido de disponibilidade ou de orçamento.
          </p>
        )}
        <BotaoWhatsApp />
      </div>

      <ul class="contactos__accoes">
        <li>
          <a class="contactos__cartao" href="/#disponibilidade">
            <Icone nome="calendario" tamanho={28} />
            <span class="contactos__titulo">Consultar disponibilidade</span>
            <span class="contactos__texto">Indique as datas e o número de hóspedes.</span>
            <Icone nome="seta" tamanho={20} class="contactos__seta" />
          </a>
        </li>
        <li>
          <a class="contactos__cartao" href="/eventos/#pedido">
            <Icone nome="pessoas" tamanho={28} />
            <span class="contactos__titulo">Pedir orçamento para um evento</span>
            <span class="contactos__texto">Reuniões, conferências, celebrações e encontros de grupo.</span>
            <Icone nome="seta" tamanho={20} class="contactos__seta" />
          </a>
        </li>
        <li>
          <a class="contactos__cartao" href="#como-chegar">
            <Icone nome="pino" tamanho={28} />
            <span class="contactos__titulo">Como chegar</span>
            <span class="contactos__texto">Boane, província de Maputo, Moçambique.</span>
            <Icone nome="seta" tamanho={20} class="contactos__seta" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <ComoChegar semContacto />
</Base>

<style>
  .contactos {
    align-items: start;
  }
  .contactos__lista {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--linha);
  }
  .contactos__lista li {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--linha);
  }
  .contactos__lista > li > :global(svg) {
    flex: none;
    color: var(--dourado-texto);
  }
  .contactos__canal {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
    justify-content: space-between;
  }
  .contactos__lista a {
    font-family: var(--serif);
    font-size: 1.5rem;
    text-decoration: none;
  }
  .contactos__rotulo {
    font-size: var(--t-etiqueta);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }
  .contactos__nota {
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }
  .contactos__accoes {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contactos__cartao {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 26px 64px 26px 28px;
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    background: #fff;
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--transicao),
      transform var(--transicao);
  }
  .contactos__cartao:hover {
    border-color: var(--dourado);
    transform: translateY(-2px);
  }
  .contactos__cartao > :global(svg:first-child) {
    color: var(--dourado-texto);
  }
  .contactos__titulo {
    font-family: var(--serif);
    font-size: 1.6rem;
    line-height: 1.15;
  }
  .contactos__texto {
    font-size: 0.95rem;
    color: var(--texto-suave);
  }
  .contactos__cartao :global(.contactos__seta) {
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--verde);
  }
</style>
