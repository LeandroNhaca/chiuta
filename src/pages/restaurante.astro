---
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import FichaServico from '../components/FichaServico.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Restaurante"
  descricao="O espaço de restauração do Mulotane Lodge, em Boane. Entre em contacto para conhecer a oferta disponível."
>
  <CabecalhoPagina
    titulo="Restaurante"
    intro="Sabores e momentos à mesa, numa sala ampla com janelas largas sobre a vegetação."
    foto="restaurante-buffet-sala"
    formato="paisagem"
  />

  <section class="secao secao--clara" aria-labelledby="mesa-titulo">
    <div class="contentor grelha grelha--texto-foto">
      <div class="bloco-titulo">
        <p class="etiqueta">À mesa</p>
        <h2 id="mesa-titulo">
          Sabores e momentos <em>à mesa.</em>
        </h2>
        <div class="texto">
          <p>
            Descubra o espaço de restauração do Mulotane Lodge: uma sala ampla, com janelas largas sobre a
            vegetação.
          </p>
          <p>As fotografias mostram a sala de refeições e o serviço de buffet.</p>
        </div>
        <div class="accoes">
          <a class="botao botao--verde" href="/eventos/#pedido">
            Pedir orçamento para um grupo
            <Icone nome="seta" tamanho={18} />
          </a>
          <a class="ligacao-seta" href="/contactos/">
            <span>Contactos</span>
            <Icone nome="seta" />
          </a>
        </div>
      </div>
      <div class="restaurante__par">
        <figure>
          <Foto
            id="restaurante-buffet"
            sizes="(min-width: 900px) 340px, 46vw"
            class="arco restaurante__alta"
          />
          <figcaption class="legenda">Buffet.</figcaption>
        </figure>
        <figure>
          <Foto id="sala-refeicoes" sizes="(min-width: 900px) 340px, 46vw" class="foto restaurante__larga" />
          <figcaption class="legenda">A sala, com janelas amplas.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="secao secao--escura" aria-labelledby="oferta-titulo">
    <div class="contentor grelha grelha--metades oferta">
      <div class="bloco-titulo">
        <p class="etiqueta">A oferta</p>
        <h2 id="oferta-titulo">
          Horários, menu e <em>preços.</em>
        </h2>
        <div class="texto">
          <p>
            O horário do restaurante, o tipo de cozinha, o menu e os preços são publicados aqui assim que
            forem confirmados pelo Mulotane Lodge.
          </p>
          <p>Para refeições de grupo ou de um evento, indique-o no pedido de orçamento.</p>
        </div>
      </div>
      <FichaServico servico="restaurante" titulo="Informação do restaurante" tom="clara" />
    </div>
  </section>

  <section class="secao secao--cinza" aria-labelledby="explorar-titulo">
    <div class="contentor">
      <p class="etiqueta">Continue a explorar</p>
      <h2 id="explorar-titulo" class="explorar__titulo">
        Mais para descobrir no lodge.
      </h2>
      <IndiceServicos variante="cartoes" excluir="restaurante" />
    </div>
  </section>
</Base>

<style>
  .oferta {
    align-items: start;
  }
  .restaurante__par {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 28px);
    align-items: end;
  }
  .restaurante__par figure {
    margin: 0;
  }
  .restaurante__par :global(.restaurante__alta) {
    display: block;
    aspect-ratio: 3 / 4;
  }
  .restaurante__par :global(.restaurante__larga) {
    display: block;
    aspect-ratio: 3 / 4;
  }
  .restaurante__par figure:last-child {
    margin-bottom: clamp(32px, 6vw, 96px);
  }
  .explorar__titulo {
    margin-bottom: clamp(36px, 5vw, 56px);
  }
</style>
