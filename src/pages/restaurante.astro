---
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import FichaServico from '../components/FichaServico.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import { lodge } from '../config/lodge';
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Restaurante"
  movimento="moderado"
  descricao="O restaurante do Mulotana Lodge, em Boane: sala de refeições ampla e buffets para grupos e eventos. Fale com a equipa para conhecer o menu e os horários."
>
  <CabecalhoPagina
    titulo="Restaurante"
    intro="Uma sala de refeições ampla, com janelas largas sobre o jardim."
    foto="restaurante-janelas"
  >
    <BotaoWhatsApp
      slot="accoes"
      texto="Perguntar pelo menu"
      variante="principal"
      mensagem={`Olá, ${lodge.nome}! Gostaria de saber o menu e os horários do restaurante.`}
    />
  </CabecalhoPagina>

  <section class="secao secao--clara" aria-labelledby="mesa-titulo">
    <div class="contentor grelha grelha--texto-foto">
      <div class="bloco-titulo">
        <p class="etiqueta c-revelar">À mesa</p>
        <h2 id="mesa-titulo" class="c-titulo">
          Refeições para hóspedes, <em>grupos e eventos.</em>
        </h2>
        <div class="texto c-revelar">
          <p>
            As fotografias mostram a sala de refeições, com janelas a toda a volta, e os buffets montados para
            grupos e eventos.
          </p>
          <p>
            O menu, os horários, os preços e as refeições para grupos são indicados pela equipa do lodge. Para
            as refeições de um evento, indique-as no pedido de orçamento.
          </p>
        </div>
        <div class="accoes">
          <a class="botao botao--verde" href="/eventos/#pedido">
            Pedir orçamento para um grupo
            <Icone nome="seta" tamanho={18} />
          </a>
          <a class="ligacao-seta" href="/contactos/">
            <span>Contactos</span>
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <ul class="mosaico">
        <li class="mosaico__a c-cortina">
          <Foto id="sala-refeicoes-bar" sizes="(min-width: 900px) 700px, 92vw" class="foto" />
        </li>
        <li class="c-cortina">
          <Foto id="restaurante-buffet-sala" sizes="(min-width: 900px) 340px, 46vw" class="foto" />
        </li>
        <li class="c-cortina">
          <Foto id="restaurante-buffet" sizes="(min-width: 900px) 340px, 46vw" class="foto" />
        </li>
      </ul>
    </div>
  </section>

  <section class="secao secao--cinza" aria-labelledby="oferta-titulo">
    <div class="contentor grelha grelha--metades oferta">
      <div class="bloco-titulo">
        <p class="etiqueta c-revelar">A oferta</p>
        <h2 id="oferta-titulo" class="c-titulo">
          Horários, menu e <em>preços.</em>
        </h2>
        <div class="texto">
          <p>
            Ainda não há horários, menu nem preços publicados. Pergunte à equipa do lodge pelo WhatsApp ou
            pelo telefone de reservas.
          </p>
        </div>
        <figure class="sala c-paralaxe">
          <Foto id="sala-refeicoes" sizes="(min-width: 900px) 640px, 92vw" class="foto sala__foto" />
          <figcaption class="legenda">Sala com janelas amplas sobre a vegetação.</figcaption>
        </figure>
      </div>
      <FichaServico servico="restaurante" titulo="O restaurante em resumo" tom="clara" />
    </div>
  </section>

  <section class="secao secao--clara" aria-labelledby="explorar-titulo">
    <div class="contentor">
      <p class="etiqueta c-revelar">Continue a explorar</p>
      <h2 id="explorar-titulo" class="explorar__titulo c-titulo">
        Mais para descobrir no lodge.
      </h2>
      <IndiceServicos variante="cartoes" excluir="restaurante" />
    </div>
  </section>
</Base>

<style>
  .mosaico {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mosaico li {
    border-radius: var(--raio-l);
  }
  .mosaico__a {
    grid-column: 1 / -1;
  }
  .mosaico :global(.foto) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .mosaico__a :global(.foto) {
    aspect-ratio: 16 / 10;
  }
  .oferta {
    align-items: start;
  }
  .sala {
    margin: 8px 0 0;
    border-radius: var(--raio-l);
  }
  .sala :global(.sala__foto) {
    display: block;
    aspect-ratio: 16 / 10;
  }
  .explorar__titulo {
    margin-bottom: clamp(32px, 4vw, 48px);
  }
</style>
