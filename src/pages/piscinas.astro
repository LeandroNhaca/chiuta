---
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import FichaServico from '../components/FichaServico.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Piscinas"
  descricao="Piscinas e espaços exteriores do Mulotane Lodge, em Boane. Confirme as condições de utilização antes da sua visita."
>
  <CabecalhoPagina
    titulo="Piscinas"
    intro="Desfrute de momentos de lazer ao ar livre, entre o relvado e o jardim."
  >
    <a slot="accoes" class="botao botao--principal" href="#condicoes">
      Condições de utilização
      <Icone nome="seta" tamanho={18} />
    </a>
  </CabecalhoPagina>

  <section class="destaque" aria-label="Fotografia da piscina">
    <div class="contentor">
      <figure class="destaque__figura">
        <Foto
          id="piscina-espreguicadeiras"
          sizes="(min-width: 1240px) 1160px, 94vw"
          class="foto destaque__foto"
        />
        <figcaption class="legenda destaque__legenda">
          <span>A piscina rectangular, com espreguiçadeiras e chapéus-de-sol.</span>
          <a class="ligacao-seta" href="/galeria/">
            <span>Ver a galeria</span>
            <Icone nome="seta" tamanho={18} />
          </a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="secao secao--clara" aria-labelledby="lazer-titulo">
    <div class="contentor grelha grelha--metades lazer">
      <div class="bloco-titulo">
        <p class="etiqueta">Lazer</p>
        <h2 id="lazer-titulo">
          Desfrute de momentos de <em>lazer.</em>
        </h2>
        <div class="texto">
          <p>Um espaço para descontrair, aproveitar o ambiente exterior e partilhar bons momentos.</p>
          <p>
            As fotografias mostram uma piscina rectangular, com deck, espreguiçadeiras e chapéus-de-sol entre
            palmeiras, e uma piscina de forma irregular no meio do relvado, com uma esplanada à sombra.
          </p>
          <p>
            Antes da visita, confirme os horários, as regras de utilização e o acesso de visitantes que não
            estejam alojados.
          </p>
        </div>
        <div class="accoes">
          <a class="botao botao--verde" href="/#disponibilidade">
            Consultar disponibilidade
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <div id="condicoes" class="condicoes">
        <FichaServico servico="piscinas" titulo="Condições de utilização" />
      </div>
    </div>
  </section>

  <section class="secao secao--cinza" aria-labelledby="fotografias-titulo">
    <div class="contentor">
      <div class="mosaico__topo">
        <h2 id="fotografias-titulo">
          As piscinas em <em>fotografias.</em>
        </h2>
        <a class="ligacao-seta" href="/galeria/">
          <span>Ver a galeria completa</span>
          <Icone nome="seta" />
        </a>
      </div>
      <ul class="mosaico">
        <li class="mosaico__a">
          <Foto id="piscina-terraco" sizes="(min-width: 900px) 700px, 92vw" class="foto" />
          <span class="legenda">Vista do terraço sobre a piscina.</span>
        </li>
        <li class="mosaico__b">
          <Foto id="esplanada-piscina" sizes="(min-width: 900px) 460px, 92vw" class="foto" />
          <span class="legenda">Esplanada à sombra, junto à água.</span>
        </li>
        <li class="mosaico__c">
          <Foto id="piscina-relvado" sizes="(min-width: 900px) 460px, 92vw" class="foto" />
          <span class="legenda">Piscina junto ao relvado.</span>
        </li>
        <li class="mosaico__d">
          <Foto id="piscina-jardim" sizes="(min-width: 900px) 700px, 92vw" class="foto" />
          <span class="legenda">Piscina e jardim.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="secao secao--clara" aria-labelledby="explorar-titulo">
    <div class="contentor">
      <p class="etiqueta">Continue a explorar</p>
      <h2 id="explorar-titulo" class="explorar__titulo">
        Mais para descobrir no lodge.
      </h2>
      <IndiceServicos variante="cartoes" excluir="piscinas" />
    </div>
  </section>
</Base>

<style>
  /* A fotografia sobe sobre o fim do cabeçalho verde, para lhe dar o destaque principal da página. */
  .destaque {
    position: relative;
    background: linear-gradient(to bottom, var(--verde) 0, var(--verde) 34%, var(--branco) 34%);
  }
  .destaque__figura {
    margin: 0;
  }
  .destaque :global(.destaque__foto) {
    display: block;
    aspect-ratio: 4 / 3;
    max-height: 82vh;
    width: 100%;
  }
  .destaque :global(.destaque__foto img) {
    object-position: 45% 50%;
  }
  @media (min-width: 900px) {
    .destaque :global(.destaque__foto) {
      aspect-ratio: 16 / 10;
    }
  }
  .destaque__legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: center;
    justify-content: space-between;
  }
  .lazer {
    align-items: start;
  }
  .mosaico__topo {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: end;
    justify-content: space-between;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .mosaico {
    display: grid;
    gap: clamp(20px, 2.4vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mosaico li {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .mosaico li .legenda {
    margin: 0;
  }
  .mosaico :global(.foto) {
    display: block;
    aspect-ratio: 3 / 2;
  }
  @media (min-width: 900px) {
    .mosaico {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .mosaico .mosaico__b :global(.foto),
    .mosaico .mosaico__c :global(.foto) {
      aspect-ratio: 4 / 3;
    }
    .mosaico__c {
      grid-column: 1;
      grid-row: 2;
      justify-self: end;
      width: 72%;
    }
    .mosaico__d {
      grid-column: 2;
      grid-row: 2;
    }
  }
  .condicoes {
    scroll-margin-top: calc(var(--cabecalho) + 24px);
  }
  .explorar__titulo {
    margin-bottom: clamp(36px, 5vw, 56px);
  }
</style>
