---
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Piscinas"
  descricao="Piscinas e espaços exteriores do Mulotane Lodge, em Boane. Confirme as condições de utilização antes da sua visita."
>
  <CabecalhoPagina
    titulo="Piscinas"
    intro="Desfrute de momentos de lazer ao ar livre, entre o relvado e o jardim."
    foto="piscina-jardim"
    enquadramento="esquerda"
  />

  <section class="secao secao--clara" aria-labelledby="lazer-titulo">
    <div class="contentor grelha grelha--metades lazer">
      <div class="bloco-titulo">
        <p class="etiqueta">Lazer</p>
        <h2 id="lazer-titulo">
          Desfrute de momentos de <em>lazer.</em>
        </h2>
        <div class="texto">
          <p>Um espaço para descontrair, aproveitar o ambiente exterior e partilhar bons momentos.</p>
          <p>A piscina, de forma irregular, fica no meio de um relvado, entre sebes e árvores.</p>
        </div>
      </div>
      <div id="condicoes" class="cartao-verde condicoes">
        <img
          class="cartao-verde__folhagem"
          src="/images/mulotane/conceptual/folhagem.svg"
          alt=""
          width="520"
          height="600"
          loading="lazy"
        />
        <p class="filete-titulo">Antes da visita</p>
        <h2 class="condicoes__titulo">Condições de utilização das piscinas</h2>
        <p class="condicoes__texto">
          Os horários, as regras de utilização e o acesso de visitantes que não estejam alojados são indicados
          pela equipa do Mulotane Lodge. Confirme-os antes da sua visita.
        </p>
        <ol class="lista-numerada">
          <li>Horários de utilização</li>
          <li>Regras da piscina</li>
          <li>Acesso de visitantes não alojados</li>
        </ol>
        <div class="accoes">
          <a class="botao botao--principal" href="/#disponibilidade">
            Consultar disponibilidade
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="secao secao--cinza" aria-labelledby="explorar-titulo">
    <div class="contentor">
      <p class="etiqueta">Continue a explorar</p>
      <h2 id="explorar-titulo" class="explorar__titulo">
        Mais para descobrir no lodge.
      </h2>
      <IndiceServicos variante="cartoes" excluir="piscinas" />
    </div>
  </section>
</Base>

<style>
  .lazer {
    align-items: start;
  }
  .condicoes {
    scroll-margin-top: calc(var(--cabecalho) + 24px);
  }
  .condicoes__titulo {
    font-size: var(--t-h3);
  }
  .condicoes__texto {
    color: rgb(250 248 243 / 0.82);
  }
  .condicoes .accoes {
    margin-top: 6px;
  }
  .explorar__titulo {
    margin-bottom: clamp(36px, 5vw, 56px);
  }
</style>
