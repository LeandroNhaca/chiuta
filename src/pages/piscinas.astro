---
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import FichaServico from '../components/FichaServico.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import { lodge } from '../config/lodge';
import Base from '../layouts/Base.astro';

const pergunta = `Olá, ${lodge.nome}! Gostaria de saber as condições de acesso à piscina (horários, regras e preço).`;
---

<Base
  titulo="Piscina e lazer em Boane"
  descricao="Piscinas, jardins e esplanadas à sombra no Mulotana Lodge, em Boane. Pergunte à equipa as condições de acesso à piscina antes da sua visita."
>
  <CabecalhoPagina
    titulo="Piscinas e jardins"
    intro="Lazer ao ar livre, entre palmeiras, jardins cuidados e esplanadas à sombra das árvores."
    foto="piscina-topiaria"
  >
    <BotaoWhatsApp slot="accoes" texto="Perguntar sobre a piscina" variante="principal" mensagem={pergunta} />
    <a slot="accoes" class="ligacao-seta" href="#condicoes">
      <span>Condições de utilização</span>
      <Icone nome="seta" tamanho={18} />
    </a>
  </CabecalhoPagina>

  <section class="secao secao--clara" aria-labelledby="fotografias-titulo">
    <div class="contentor">
      <div class="bloco-titulo mosaico__topo">
        <p class="etiqueta">A área de lazer</p>
        <h2 id="fotografias-titulo">
          Piscinas, jardins e <em>sombra.</em>
        </h2>
        <div class="texto">
          <p>
            Uma piscina rectangular junto ao edifício de colmo, outra de forma irregular entre os jardins,
            decks com espreguiçadeiras e mesas à sombra das árvores.
          </p>
        </div>
      </div>
      <ul class="mosaico">
        <li class="mosaico__a">
          <Foto id="piscina-palmeiras" sizes="(min-width: 900px) 740px, 92vw" class="foto" />
          <span class="legenda">A piscina e o edifício de colmo.</span>
        </li>
        <li>
          <Foto id="piscina-deck" sizes="(min-width: 900px) 460px, 92vw" class="foto" />
          <span class="legenda">Deck com espreguiçadeiras.</span>
        </li>
        <li>
          <Foto id="vista-piscina-esplanada" sizes="(min-width: 900px) 460px, 92vw" class="foto" />
          <span class="legenda">Vista sobre a piscina e o terraço.</span>
        </li>
        <li>
          <Foto id="piscina-cascata" sizes="(min-width: 900px) 460px, 92vw" class="foto" />
          <span class="legenda">Piscina com parede de água.</span>
        </li>
        <li>
          <Foto id="esplanada-arvore" sizes="(min-width: 900px) 460px, 92vw" class="foto" />
          <span class="legenda">Esplanada junto à piscina.</span>
        </li>
        <li>
          <Foto id="mesas-sombra" sizes="(min-width: 900px) 460px, 92vw" class="foto" />
          <span class="legenda">Mesas à sombra das árvores.</span>
        </li>
      </ul>
      <a class="ligacao-seta mosaico__galeria" href="/galeria/">
        <span>Ver a galeria completa</span>
        <Icone nome="seta" tamanho={18} />
      </a>
    </div>
  </section>

  <section id="condicoes" class="secao secao--cinza condicoes" aria-labelledby="condicoes-titulo">
    <div class="contentor grelha grelha--metades">
      <div class="bloco-titulo">
        <p class="etiqueta">Antes da visita</p>
        <h2 id="condicoes-titulo">
          Condições de <em>utilização.</em>
        </h2>
        <div class="texto">
          <p>
            Os horários, as regras de utilização, o acesso de visitantes não alojados e o preço de entrada não
            estão publicados. Pergunte à equipa antes da sua visita.
          </p>
        </div>
        <div class="accoes">
          <BotaoWhatsApp texto="Perguntar sobre a piscina" variante="principal" mensagem={pergunta} />
          <a class="botao botao--contorno" href="/contactos/">
            Outros contactos
          </a>
        </div>
      </div>
      <FichaServico servico="piscinas" titulo="A piscina em resumo" tom="clara" />
    </div>
  </section>

  <section class="secao secao--clara" aria-labelledby="explorar-titulo">
    <div class="contentor">
      <p class="etiqueta">Continue a explorar</p>
      <h2 id="explorar-titulo" class="explorar__titulo">
        Mais para descobrir no lodge.
      </h2>
      <IndiceServicos variante="cartoes" excluir="piscinas" />
    </div>
  </section>
</Base>

<style>
  .mosaico__topo {
    max-width: 46rem;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .mosaico {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .mosaico {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .mosaico {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .mosaico__a {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
  .mosaico li {
    display: grid;
    gap: 2px;
    align-content: start;
  }
  .mosaico :global(.foto) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  /* A fotografia principal ocupa duas linhas e acompanha a altura das duas da direita. */
  @media (min-width: 1000px) {
    .mosaico .mosaico__a {
      grid-template-rows: minmax(0, 1fr) auto;
      align-content: stretch;
    }
    .mosaico__a :global(.foto) {
      aspect-ratio: auto;
      height: 100%;
      min-height: 0;
    }
  }
  .mosaico__galeria {
    margin-top: 24px;
  }
  .condicoes .grelha {
    align-items: start;
  }
  .condicoes {
    scroll-margin-top: var(--cabecalho);
  }
  .explorar__titulo {
    margin-bottom: clamp(32px, 4vw, 48px);
  }
</style>
