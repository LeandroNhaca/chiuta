---
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Cenas, { type Cena } from '../components/Cenas.astro';
import FichaServico from '../components/FichaServico.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import { lodge } from '../config/lodge';
import Base from '../layouts/Base.astro';

const pergunta = `Olá, ${lodge.nome}! Gostaria de saber as condições de acesso à piscina (horários, regras e preço).`;

// Passeio pela área de lazer (palco compacto): só o que se vê em cada fotografia.
const cenas: Cena[] = [
  {
    id: 'piscina',
    etiqueta: 'A piscina',
    titulo: 'Entre palmeiras',
    texto: 'Uma piscina rectangular de água azul-turquesa, junto ao edifício de telhado de colmo.',
    foto: 'piscina-palmeiras',
  },
  {
    id: 'terraco',
    etiqueta: 'O terraço',
    titulo: 'Vista do alto',
    texto: 'Espreguiçadeiras, relvado e um terraço com mesas, entre os edifícios de colmo.',
    foto: 'vista-piscina-esplanada',
  },
  {
    id: 'esplanada',
    etiqueta: 'A esplanada',
    titulo: 'À sombra',
    texto: 'Mesas e cadeiras sob uma árvore grande, ao lado da piscina.',
    foto: 'esplanada-arvore',
  },
];
---

<Base
  titulo="Piscina e lazer em Boane"
  descricao="Piscinas, jardins e esplanadas à sombra no Mulotana Lodge, em Boane. Pergunte à equipa as condições de acesso à piscina antes da sua visita."
>
  <CabecalhoPagina
    titulo="Piscinas e jardins"
    intro="Lazer ao ar livre, entre palmeiras, jardins cuidados e esplanadas à sombra das árvores."
    foto="piscina-topiaria"
  >
    <BotaoWhatsApp slot="accoes" texto="Perguntar sobre a piscina" variante="principal" mensagem={pergunta} />
    <a slot="accoes" class="ligacao-seta" href="#condicoes">
      <span>Condições de utilização</span>
      <Icone nome="seta" tamanho={18} />
    </a>
  </CabecalhoPagina>

  <section class="secao secao--escura passeio" aria-labelledby="passeio-titulo">
    <div class="contentor passeio__intro">
      <p class="etiqueta c-revelar">A área de lazer</p>
      <h2 id="passeio-titulo" class="c-titulo">
        Piscinas, jardins e <em>sombra.</em>
      </h2>
    </div>
    <Cenas id="lazer" cenas={cenas} variante="compacta" rotulo="Área de lazer" />
  </section>

  <!-- Camadas: fotografias sobrepostas que sobem a velocidades diferentes. -->
  <section class="secao secao--clara camadas" aria-labelledby="camadas-titulo">
    <div class="contentor camadas__grelha">
      <div class="bloco-titulo camadas__texto">
        <p class="etiqueta c-revelar">Os jardins</p>
        <h2 id="camadas-titulo" class="c-titulo">
          Água, verde e <em>tempo livre.</em>
        </h2>
        <div class="texto c-revelar">
          <p>
            Uma piscina de forma irregular entre arbustos podados, outra com parede de água, decks com
            espreguiçadeiras e mesas à sombra das árvores.
          </p>
        </div>
        <a class="ligacao-seta c-revelar" href="/galeria/">
          <span>Ver a galeria completa</span>
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>
      <figure class="camadas__a c-paralaxe">
        <Foto id="piscina-cascata" sizes="(min-width: 900px) 620px, 92vw" class="foto" />
      </figure>
      <figure class="camadas__b c-flutuar">
        <Foto id="piscina-deck" sizes="(min-width: 900px) 300px, 46vw" class="foto" />
      </figure>
      <figure class="camadas__c c-flutuar">
        <Foto id="mesas-sombra" sizes="(min-width: 900px) 300px, 46vw" class="foto" />
      </figure>
    </div>
    <ul class="contentor tira c-cartoes" aria-label="Mais fotografias da área de lazer">
      <li>
        <Foto id="piscina-sombra" sizes="(min-width: 900px) 380px, 46vw" class="foto" />
        <span class="legenda">Piscina à sombra das árvores.</span>
      </li>
      <li>
        <Foto id="piscina-espreguicadeiras" sizes="(min-width: 900px) 380px, 46vw" class="foto" />
        <span class="legenda">Espreguiçadeiras e chapéus-de-sol.</span>
      </li>
      <li>
        <Foto id="piscina-jardim" sizes="(min-width: 900px) 380px, 92vw" class="foto" />
        <span class="legenda">Piscina e relvado.</span>
      </li>
    </ul>
  </section>

  <section id="condicoes" class="secao secao--cinza condicoes" aria-labelledby="condicoes-titulo">
    <div class="contentor grelha grelha--metades">
      <div class="bloco-titulo">
        <p class="etiqueta c-revelar">Antes da visita</p>
        <h2 id="condicoes-titulo" class="c-titulo">
          Condições de <em>utilização.</em>
        </h2>
        <div class="texto">
          <p>
            Os horários, as regras de utilização, o acesso de visitantes não alojados e o preço de entrada não
            estão publicados. Pergunte à equipa antes da sua visita.
          </p>
        </div>
        <div class="accoes">
          <BotaoWhatsApp texto="Perguntar sobre a piscina" variante="principal" mensagem={pergunta} />
          <a class="botao botao--contorno" href="/contactos/">
            Outros contactos
          </a>
        </div>
      </div>
      <FichaServico servico="piscinas" titulo="A piscina em resumo" tom="clara" />
    </div>
  </section>

  <section class="secao secao--clara" aria-labelledby="explorar-titulo">
    <div class="contentor">
      <p class="etiqueta c-revelar">Continue a explorar</p>
      <h2 id="explorar-titulo" class="explorar__titulo c-titulo">
        Mais para descobrir no lodge.
      </h2>
      <IndiceServicos variante="cartoes" excluir="piscinas" />
    </div>
  </section>
</Base>

<style>
  .passeio {
    padding-bottom: 0;
  }
  .passeio__intro {
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  @media (max-width: 899px) {
    .passeio {
      padding-bottom: var(--espaco-secao);
    }
  }
  .camadas__grelha {
    display: grid;
    gap: 24px;
  }
  .camadas figure {
    margin: 0;
  }
  .camadas :global(.foto) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .camadas__b,
  .camadas__c {
    display: none;
  }
  /* Computador: fotografia grande à direita e duas mais pequenas à frente, a subir a outra velocidade. */
  @media (min-width: 900px) {
    .camadas__grelha {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto auto;
      gap: 0 clamp(40px, 5vw, 80px);
      align-items: start;
      padding-bottom: 120px;
    }
    .camadas__texto {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
    }
    .camadas__a {
      position: relative;
      grid-column: 2;
      grid-row: 1 / span 2;
      border-radius: var(--raio-l);
    }
    .camadas__a :global(.foto) {
      aspect-ratio: 4 / 5;
    }
    .camadas__b,
    .camadas__c {
      display: block;
      width: 46%;
      border: 6px solid var(--branco);
      border-radius: var(--raio-l);
      box-shadow: var(--sombra);
    }
    .camadas__b {
      --c-flutuar: 70px;
      grid-column: 1;
      grid-row: 2;
      justify-self: end;
      margin-top: 32px;
      margin-right: -12%;
      position: relative;
      z-index: 1;
    }
    .camadas__c {
      --c-flutuar: 40px;
      grid-column: 1;
      grid-row: 2;
      margin-top: 140px;
    }
  }
  .tira {
    display: grid;
    gap: 20px;
    margin: clamp(40px, 6vw, 80px) auto 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .tira {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .tira li {
    display: grid;
    gap: 2px;
    align-content: start;
  }
  .tira :global(.foto) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .condicoes .grelha {
    align-items: start;
  }
  .condicoes {
    scroll-margin-top: var(--cabecalho);
  }
  .explorar__titulo {
    margin-bottom: clamp(32px, 4vw, 48px);
  }
</style>
