---
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Galeria from '../components/Galeria.astro';
import { fotografias } from '../data/fotografias';
import Base from '../layouts/Base.astro';

const autores = [...new Set(fotografias.filter((f) => f.autor).map((f) => f.autor))];
---

<Base
  movimento="moderado"
  titulo="Galeria"
  descricao="Fotografias reais do Mulotana Lodge, em Boane: quartos, piscinas e jardins, salas de conferências, restaurante e espaços do lodge."
>
  <CabecalhoPagina
    titulo="Galeria"
    intro="Os espaços do Mulotana Lodge em fotografias reais: quartos, piscinas e jardins, salas de conferências e restaurante."
  />

  <section class="secao secao--clara" aria-label="Fotografias">
    <div class="contentor">
      <Galeria />
      {autores.length > 0 && (
        <aside class="creditos" aria-labelledby="creditos-titulo">
          <h2 id="creditos-titulo">Créditos fotográficos</h2>
          <p>
            A maior parte das fotografias foi publicada pelo próprio lodge no Instagram e no Facebook; as
            datas vão de 2016 a 2025. Algumas são contribuições de visitantes no Google Maps e são
            apresentadas com indicação de autoria: {autores.join(', ')}.
          </p>
        </aside>
      )}
    </div>
  </section>
</Base>

<style>
  .creditos {
    display: grid;
    gap: 10px;
    max-width: 48rem;
    margin-top: clamp(64px, 8vw, 112px);
    padding-top: 28px;
    border-top: 1px solid var(--linha);
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }
  .creditos h2 {
    font-family: var(--sans);
    font-size: var(--t-etiqueta);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dourado-texto);
  }
</style>
