---
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import FichaServico from '../components/FichaServico.astro';
import Icone from '../components/Icone.astro';
import IndiceServicos from '../components/IndiceServicos.astro';
import QuartosLista from '../components/QuartosLista.astro';
import SecaoDisponibilidade from '../components/SecaoDisponibilidade.astro';
import { lodge } from '../config/lodge';
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Alojamento"
  descricao="Alojamento no Mulotane Lodge, em Boane. Consulte a disponibilidade para as datas da sua visita e peça informações sobre os quartos."
>
  <CabecalhoPagina
    titulo="Alojamento"
    intro="O seu espaço para descansar, depois de um dia de lazer, de trabalho ou de celebração."
    foto="entrada-coberta"
    formato="paisagem"
  >
    <a slot="accoes" class="botao botao--principal" href="#disponibilidade">
      Consultar disponibilidade
      <Icone nome="seta" tamanho={18} />
    </a>
  </CabecalhoPagina>

  <section class="secao secao--clara" aria-labelledby="quartos-titulo">
    <div class="contentor grelha grelha--metades detalhe">
      <div class="bloco-titulo">
        <p class="etiqueta">Os quartos</p>
        <h2 id="quartos-titulo">
          Descanso com <em>tranquilidade.</em>
        </h2>
        <div class="texto">
          <p>Conheça as opções de alojamento e consulte a disponibilidade para as datas da sua visita.</p>
          <p>
            Os tipos de quarto, a capacidade de cada um, as comodidades e as tarifas são publicados aqui assim
            que forem confirmados pelo Mulotane Lodge. Entretanto, pode indicar no pedido o que procura.
          </p>
        </div>
        <div class="accoes">
          <a class="botao botao--verde" href="#disponibilidade">
            Consultar disponibilidade
            <Icone nome="seta" tamanho={18} />
          </a>
        </div>
      </div>
      <FichaServico servico="alojamento" titulo="O que pode saber antes de reservar" tom="clara" />
    </div>
    {lodge.quartos.length > 0 && (
      <div class="contentor quartos-secao">
        <h2 class="quartos-secao__titulo">Tipos de quarto</h2>
        <QuartosLista />
      </div>
    )}
  </section>

  <SecaoDisponibilidade prefixo="aloj" />

  <section class="secao secao--cinza" aria-labelledby="explorar-titulo">
    <div class="contentor">
      <p class="etiqueta">Continue a explorar</p>
      <h2 id="explorar-titulo" class="explorar__titulo">
        Mais para descobrir no lodge.
      </h2>
      <IndiceServicos variante="cartoes" excluir="alojamento" />
    </div>
  </section>
</Base>

<style>
  .detalhe {
    align-items: start;
  }
  .quartos-secao {
    margin-top: clamp(56px, 7vw, 96px);
  }
  .quartos-secao__titulo {
    margin-bottom: 32px;
    font-size: var(--t-h3);
  }
  .explorar__titulo {
    margin-bottom: clamp(36px, 5vw, 56px);
  }
</style>
